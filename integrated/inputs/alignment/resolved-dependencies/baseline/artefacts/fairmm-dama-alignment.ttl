    ns1:inSourceTopic ns1:AREA-06 ;
    ns1:originalContributionType "Direct" ;
    ns1:primarySource <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1305> ;
    ns1:rationale "Identify Reference Data Sources and Contributors (P) \\[source: ReferenceMasterDataManagement!A3:F3\\] — Deliverable: Description and Assessment of Sources and Contributors.; Explicit partial support: descriptions of sources and contributors capture origin and responsibility relevant to provenance; association with specific data/metadata and transformation history are still needed. No implementation evidence is supplied." ;
    ns1:sourceCoordinate "ReferenceMasterDataManagement!A3:L3" ;
    ns1:sourceLayer "activity_table" ;
    ns1:targetsPrinciple <https://w3id.org/fair/principles/terms/R1.2> .

ns1:ACT-06-006-direct-I3 a owl:NamedIndividual,
        ns1:SourceAssertion ;
    dcterms:identifier "ACT-06-006-direct-I3" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1309> ;
