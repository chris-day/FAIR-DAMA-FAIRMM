    ns1:rationale "The named deliverable may address the R1.1 aspect of these clauses when its applicability condition is met." ;
    ns1:sourceText "While we achieve “Findability” and there is evidence of re-use at the local level, the \"Interoperability\" and \"Reusability\" principles are still a challenge in the broader scope of the organization." ;
    ns1:supportedByDescriptor ns1:D1-L3 ;
    ns1:supportsInterpretation ns1:interpretation-a0e274e6dbbb8c59214f5823 .

ns1:evidence-683a1140c7bb1b63850d5f18 a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L183> ;
    ns1:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
