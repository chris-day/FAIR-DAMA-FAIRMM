align:ACT-14-006-field-1 a owl:NamedIndividual,
        align:SourceField ;
    rdfs:label "Activities"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L2287> ;
    align:fieldHeading "Activities" ;
    align:sourcePosition 1 ;
    align:sourceText "Implement Risk Mitigation" .

align:ACT-14-006-field-10 a owl:NamedIndividual,
        align:SourceField ;
    rdfs:label "Indirect support"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L2287> ;
    align:fieldHeading "Indirect support" ;
    align:sourcePosition 10 ;
    align:sourceText "Mitigation can commission access-authorization and reuse-permission controls when the ethical risk assessment identifies those specific requirements." .

align:ACT-14-006-field-11 a owl:NamedIndividual,
        align:SourceField ;
    rdfs:label "What would demonstrate the supported FAIR requirement"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L2287> ;
    align:fieldHeading "What would demonstrate the supported FAIR requirement" ;
    align:sourcePosition 11 ;
    align:sourceText "Inspect approved policy or control requirements that explicitly distinguish access authorization from permitted reuse. Test any resulting authentication and authorization procedure for identified resources (A1.2) and inspect the clear, accessible usage licence attached to data and metadata (R1.1). An ethics statement, privacy notice or generic compliance metric alone is insufficient." .

align:ACT-14-006-field-12 a owl:NamedIndividual,
        align:SourceField ;
    rdfs:label "FAIR principles indirectly supported"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L2287> ;
    align:fieldHeading "FAIR principles indirectly supported" ;
    align:sourcePosition 12 ;
    align:sourceText "A1.2; R1.1" .

