        ns1:Practice ;
    rdfs:label "Publish data or metadata in a shared representation"@en ;
    ns1:evidenceForPrinciple <https://w3id.org/fair/principles/terms/I1> ;
    ns1:inKnowledgeArea <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#DataIntegrationAndInteroperability> .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-2> a owl:NamedIndividual,
        ns1:SourceActivity ;
    rdfs:label "Define Big Data Strategy & Business Needs"@en ;
    dcterms:identifier "BigDataDataScience!A2:L2" ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/assets/13_BigDataDataScience.webp>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/outputs/dama-20261116/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A2:L2> ;
    ns1:alignmentBasis "Activity-derived proposal; source image plus interpreted associations"@en ;
    ns1:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns1:deliverables "Big Data Strategy & Standards"@en ;
    ns1:directSupportExplanation "A strategy is an enabling decision record; it does not itself establish FAIR properties of data or metadata."@en ;
    ns1:evidenceRequirement "Inspect approved standards and their domain relevance, then validate actual data and metadata against the applicable community specifications. Strategy approval alone does not demonstrate conformance."@en ;
    ns1:inTopic <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#BigDataAndDataScience> ;
    ns1:indirectSupportExplanation "Standards selection can commission domain-relevant community conformance if named external standards, versions and acceptance tests are explicitly adopted. Internal IT standards alone are insufficient."@en ;
    ns1:lifecycleCode "P"@en ;
    ns1:proposedApprovingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/business-executives>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/it-executives> ;
    ns1:proposedContributingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-quality-and-governance-specialists>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-scientists>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/information-consumers> ;
    ns1:proposedResponsiblePersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/analytic-design-lead>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/big-data-platform-architects> ;
    ns1:relevantDeliverables "Big Data Strategy & Standards"@en ;
    ns1:sourceRow 2 ;
    ns1:sourceWorksheet "BigDataDataScience" .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#ManagementTopic> a owl:Class .

ns1:FAIRContribution a owl:Class ;
    rdfs:label "FAIR contribution assertion"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:fromPractice ;
            owl:someValuesFrom ns1:Practice ],
        [ a owl:Restriction ;
            owl:onProperty ns1:targetsPrinciple ;
            owl:someValuesFrom <https://w3id.org/fair/principles/terms/FAIR-SubPrinciple> ] ;
    owl:disjointUnionOf ( ns1:DirectContribution ns1:IndirectContribution ) .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#Persona> a owl:Class .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-10> a owl:NamedIndividual,
        ns1:SourceActivity ;
    rdfs:label "Deploy and Monitor"@en ;
    dcterms:identifier "BigDataDataScience!A10:L10" ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/assets/13_BigDataDataScience.webp>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/outputs/dama-20261116/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A10:L10> ;
    ns1:alignmentBasis "Activity-derived proposal; source image plus interpreted associations"@en ;
    ns1:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns1:deliverables "Operations Plan; Model Performance; Model Enhancement Plan"@en ;
    ns1:directSupportExplanation "Deployment, availability and model performance do not directly establish a FAIR principle."@en ;
    ns1:evidenceRequirement "Test standardized retrieval of identified resources and inspect version-linked deployment and execution provenance. Monitoring predictive accuracy or infrastructure utilization alone is insufficient."@en ;
    ns1:inTopic <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#BigDataAndDataScience> ;
    ns1:indirectSupportExplanation "Operations can sustain identifier-based access and record versioned inputs, model changes and execution history when those controls are explicitly included in the operations plan."@en ;
    ns1:lifecycleCode "O,C"@en ;
    ns1:proposedApprovingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/business-executives>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/it-executives> ;
    ns1:proposedContributingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/analytic-design-lead>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-quality-and-governance-specialists>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/ingestion-architects>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/metadata-specialists> ;
    ns1:proposedResponsiblePersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/big-data-platform-architects>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-scientists> ;
    ns1:relevantDeliverables "Operations Plan; Model Performance; Model Enhancement Plan"@en ;
    ns1:sourceRow 10 ;
    ns1:sourceWorksheet "BigDataDataScience" .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-4> a owl:NamedIndividual,
        ns1:SourceActivity ;
    rdfs:label "Choose Data Sources"@en ;
    dcterms:identifier "BigDataDataScience!A4:L4" ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/assets/13_BigDataDataScience.webp>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/outputs/dama-20261116/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A4:L4> ;
    ns1:alignmentBasis "Activity-derived proposal; source image plus interpreted associations"@en ;
    ns1:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns1:deliverables "Data Sourcing Plan"@en ;
    ns1:directSupportExplanation "Selecting sources does not by itself publish resource descriptions, provenance or usage licences."@en ;
    ns1:evidenceRequirement "Trace selected source versions to providers and acquisition context; inspect accessible usage licences linked to each resource. A commercial purchase or access agreement alone is not a FAIR usage licence."@en ;
    ns1:inTopic <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#BigDataAndDataScience> ;
    ns1:indirectSupportExplanation "Source evaluation can record origin, permitted reuse and descriptive context, enabling provenance and licensing requirements when resource-linked records and accessible terms are retained."@en ;
    ns1:lifecycleCode "P"@en ;
    ns1:proposedApprovingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/analytic-design-lead> ;
    ns1:proposedContributingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-producers>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-quality-and-governance-specialists>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-smes>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-suppliers> ;
    ns1:proposedResponsiblePersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-curators>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-scientists> ;
    ns1:relevantDeliverables "Data Sourcing Plan"@en ;
    ns1:sourceRow 4 ;
    ns1:sourceWorksheet "BigDataDataScience" .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-5> a owl:NamedIndividual,
        ns1:SourceActivity ;
    rdfs:label "Acquire & Ingest Data Sources"@en ;
    dcterms:identifier "BigDataDataScience!A5:L5" ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/assets/13_BigDataDataScience.webp>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/outputs/dama-20261116/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A5:L5> ;
    ns1:alignmentBasis "Activity-derived proposal; source image plus interpreted associations"@en ;
    ns1:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns1:deliverables "Acquired Data Sources"@en ;
    ns1:directSupportExplanation "Ingesting data is not direct evidence of rich metadata or provenance; the diagram does not explicitly specify their capture."@en ;
    ns1:evidenceRequirement "Inspect descriptions linked to ingested resources and provenance records identifying sources, versions, agents, acquisition times and transformations. Successful loading and scanning alone are insufficient."@en ;
    ns1:inTopic <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#BigDataAndDataScience> ;
    ns1:indirectSupportExplanation "Ingestion can capture resource descriptions, source versions, acquisition times and transformations if metadata capture is added as an explicit requirement."@en ;
    ns1:lifecycleCode "D"@en ;
    ns1:proposedApprovingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/big-data-platform-architects> ;
    ns1:proposedContributingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-producers>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-scientists>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-suppliers>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/metadata-specialists> ;
    ns1:proposedResponsiblePersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-curators>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/ingestion-architects> ;
    ns1:relevantDeliverables "Acquired Data Sources"@en ;
    ns1:sourceRow 5 ;
    ns1:sourceWorksheet "BigDataDataScience" .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-6> a owl:NamedIndividual,
        ns1:SourceActivity ;
    rdfs:label "Develop Hypotheses & Methods"@en ;
    dcterms:identifier "BigDataDataScience!A6:L6" ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/assets/13_BigDataDataScience.webp>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/outputs/dama-20261116/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A6:L6> ;
    ns1:alignmentBasis "Activity-derived proposal; source image plus interpreted associations"@en ;
    ns1:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns1:deliverables "Data Analysis and Hypotheses"@en ;
    ns1:directSupportExplanation "Inferred potential direct support: documented hypotheses and methods can supply accurate, relevant methodological context for reusing the associated analytical data. The diagram does not establish that these descriptions are complete or associated with identifiable resources."@en ;
    ns1:evidenceRequirement "For R1, inspect resource-linked descriptions of hypotheses, methods, assumptions, units, scope and limitations, and verify their accuracy and relevance for reuse. For R1.2, additionally inspect input versions, methods, agents and execution history. An unexplained model or hypothesis list is insufficient."@en ;
    ns1:inTopic <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#BigDataAndDataScience> ;
    ns1:indirectSupportExplanation "Versioned methods and input records can enable provenance when linked to the resulting data and model outputs."@en ;
    ns1:lifecycleCode "D"@en ;
    ns1:proposedApprovingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/analytic-design-lead> ;
    ns1:proposedContributingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-curators>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-smes>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/metadata-specialists> ;
    ns1:proposedResponsiblePersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-scientists> ;
    ns1:relevantDeliverables "Data Analysis and Hypotheses"@en ;
    ns1:sourceRow 6 ;
    ns1:sourceWorksheet "BigDataDataScience" .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-8> a owl:NamedIndividual,
        ns1:SourceActivity ;
    rdfs:label "Explore Data Using Models"@en ;
    dcterms:identifier "BigDataDataScience!A8:L8" ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/assets/13_BigDataDataScience.webp>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/outputs/dama-20261116/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A8:L8> ;
    ns1:alignmentBasis "Activity-derived proposal; source image plus interpreted associations"@en ;
    ns1:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns1:deliverables "Data Insights and Findings"@en ;
    ns1:directSupportExplanation "Exploratory analysis and model accuracy do not inherently establish FAIR descriptions or provenance."@en ;
    ns1:evidenceRequirement "Inspect resource-linked descriptions of analytical context and limitations and a traceable execution record linking inputs, model versions and outputs. Performance scores alone are insufficient."@en ;
    ns1:inTopic <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#BigDataAndDataScience> ;
    ns1:indirectSupportExplanation "Exploration can enrich reuse descriptions and provenance if assumptions, limitations, source versions, model versions and analytical steps are recorded with the resulting resources."@en ;
    ns1:lifecycleCode "D"@en ;
    ns1:proposedApprovingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/analytic-design-lead> ;
    ns1:proposedContributingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/business-partners>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-curators>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-smes> ;
    ns1:proposedResponsiblePersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-scientists> ;
    ns1:relevantDeliverables "Data Insights and Findings"@en ;
    ns1:sourceRow 8 ;
    ns1:sourceWorksheet "BigDataDataScience" .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-9> a owl:NamedIndividual,
        ns1:SourceActivity ;
    rdfs:label "Communicate Output to Stakeholders"@en ;
    dcterms:identifier "BigDataDataScience!A9:L9" ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/assets/13_BigDataDataScience.webp>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/outputs/dama-20261116/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A9:L9> ;
    ns1:alignmentBasis "Activity-derived proposal; source image plus interpreted associations"@en ;
    ns1:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns1:deliverables "Data Insights and Findings"@en ;
    ns1:directSupportExplanation "Communicating a chart, presentation or finding does not automatically create rich resource metadata, a searchable registration or standardized retrieval."@en ;
    ns1:evidenceRequirement "Inspect resource-linked discovery and reuse descriptions covering meaning, methods, coverage, assumptions and limitations. A presentation without associated resource descriptions is insufficient."@en ;
    ns1:inTopic <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#BigDataAndDataScience> ;
    ns1:indirectSupportExplanation "Communications can make discovery and reuse context available if findings are accompanied by accurate descriptions linked to the analytical resources."@en ;
    ns1:lifecycleCode "D"@en ;
    ns1:proposedApprovingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/business-executives> ;
    ns1:proposedContributingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/business-partners>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/intermediaries>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/metadata-specialists>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/stakeholders> ;
    ns1:proposedResponsiblePersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/analytic-design-lead>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-scientists> ;
    ns1:relevantDeliverables "Data Insights and Findings"@en ;
    ns1:sourceRow 9 ;
    ns1:sourceWorksheet "BigDataDataScience" .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/DataHandlingEthics/row-2> a owl:NamedIndividual,
        ns1:SourceActivity ;
    rdfs:label "Review Data-Handling Practices"@en ;
    dcterms:identifier "DataHandlingEthics!A2:L2" ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/assets/01_DataHandlingEthics.webp>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/outputs/dama-20261116/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#DataHandlingEthics!A2:L2> ;
    ns1:alignmentBasis "Activity-derived proposal; source image plus interpreted associations"@en ;
    ns1:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns1:deliverables "Current Practices and Gaps"@en ;
    ns1:directSupportExplanation "No direct FAIR requirement is established by this ethical-practice activity or its named deliverables. Ethical responsibility and FAIR fulfilment are related but distinct."@en ;
    ns1:evidenceRequirement "Inspect approved policy or control requirements that explicitly distinguish access authorization from permitted reuse. Test any resulting authentication and authorization procedure for identified resources (A1.2) and inspect the clear, accessible usage licence attached to data and metadata (R1.1). An ethics statement, privacy notice or generic compliance metric alone is insufficient."@en ;
    ns1:inTopic <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#DataHandlingEthics> ;
    ns1:indirectSupportExplanation "Review can identify gaps in authorized access and permitted reuse if the review criteria explicitly include them."@en ;
    ns1:lifecycleCode "P"@en ;
    ns1:proposedApprovingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-governance-bodies> ;
    ns1:proposedContributingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-providers>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-stewards>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/regulators>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/subject-matter-experts> ;
    ns1:proposedResponsiblePersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/coordinating-data-stewards>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/dm-services> ;
    ns1:relevantDeliverables "Current Practices and Gaps"@en ;
    ns1:sourceRow 2 ;
    ns1:sourceWorksheet "DataHandlingEthics" .

