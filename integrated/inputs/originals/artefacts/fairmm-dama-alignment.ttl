    align:fieldHeading "Activities" ;
    align:sourcePosition 1 ;
    align:sourceText "Understand Metadata Requirements (P)" .

align:ACT-09-001-field-10 a owl:NamedIndividual,
        align:SourceField ;
    rdfs:label "Indirect support"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1719> ;
    align:fieldHeading "Indirect support" ;
    align:sourcePosition 10 ;
    align:sourceText "Indirect support: Metadata ownership, maintenance and standards can sustain resource coverage, descriptive quality and consistent changes. Specify the data identifier explicitly in metadata for F3 and metadata survival for A2; these requirements are absent from the activity labels." .

align:ACT-09-001-field-11 a owl:NamedIndividual,
        align:SourceField ;
    rdfs:label "What would demonstrate the supported FAIR requirement"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1719> ;
    align:fieldHeading "What would demonstrate the supported FAIR requirement" ;
    align:sourcePosition 11 ;
    align:sourceText "F2: Inspect representative metadata linked to the described data; validate descriptive fields against a discovery profile covering meaning, scope, creator, temporal coverage and intended use as applicable. A requirements document or tool inventory alone is insufficient.; R1: Validate representative descriptions for multiple accurate and relevant attributes needed for reuse, including meaning, scope, creation context and limitations. Compare with authoritative sources; generic business-data quality is not evidence of rich descriptions.; Supporting-process evidence: inspect the named deliverable and its approval/maintenance records separately from the resource tests." .

align:ACT-09-001-field-12 a owl:NamedIndividual,
        align:SourceField ;
    rdfs:label "FAIR principles indirectly supported"@en ;
