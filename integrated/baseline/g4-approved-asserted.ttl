    ns1:targetsPrinciple <https://w3id.org/fair/principles/terms/R1.2> .

<urn:fair-dama-fairmm:alignment:ONT-contribution/BigDataDataScience/row-7/indirect/I1> a owl:NamedIndividual,
        ns1:SourceAssertion ;
    dcterms:identifier "ONT-contribution/BigDataDataScience/row-7/indirect/I1" ;
