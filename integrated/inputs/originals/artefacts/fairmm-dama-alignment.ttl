    align:rationale "Provide Content Access and Retrieval (O) \\[source: DocumentContentManagement!A9:F9\\] — Deliverable: Portals, Content Analysis, Leveraged Information.; Inferred support: content access and retrieval can satisfy A1 if electronic content and metadata are retrieved by identifier via a standard protocol; the named portals do not establish this. No implementation evidence is supplied." ;
    align:sourceCoordinate "DocumentContentManagement!A9:L9" ;
    align:sourceLayer "activity_table" ;
    align:targetsPrinciple fair:A1 .

align:ACT-10-001-indirect-F2 a owl:NamedIndividual,
        align:SourceAssertion ;
    dcterms:identifier "ACT-10-001-indirect-F2" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1849> ;
    align:existingContributionType "Indirect" ;
    align:hasPractice align:ACT-10-001 ;
    align:inSourceTopic align:AREA-10 ;
    align:originalContributionType "Indirect" ;
    align:primarySource <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1849> ;
    align:rationale "Indirect support: Quality requirements, tests, monitoring and remediation can maintain reliable data; extend them to FAIR metadata and resource tests explicitly. Data accuracy, cleanliness and fitness for business use do not by themselves establish F2 or R1 metadata richness, or any other FAIR requirement." ;
    align:sourceCoordinate "DataQuality!A2:L2" ;
    align:sourceIntermediatePractice align:practice-2c7c984cf7a31cba0f56a8df ;
    align:sourceLayer "activity_table" ;
    align:targetsPrinciple fair:F2 .

