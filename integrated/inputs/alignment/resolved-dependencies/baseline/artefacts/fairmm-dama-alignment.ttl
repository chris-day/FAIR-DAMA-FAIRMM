    ns1:sourcePosition 8 ;
    ns1:sourceText "I3 — qualified references to other data or metadata; R1.2 — detailed provenance associated with data and metadata" .

ns1:ACT-02-005-field-9 a owl:NamedIndividual,
        ns1:SourceField ;
    rdfs:label "How they can support FAIR"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L754> ;
    ns1:fieldHeading "How they can support FAIR" ;
    ns1:sourcePosition 9 ;
    ns1:sourceText "Define and Maintain the Data Integration Architecture (P)  \\[source: DataArchitectureManagement!A6:F6\\] — Deliverable: Data Integration Architecture Data Lineage / Flows Entity Lifecycles.; Explicit partial support for R1.2: named Data Lineage/Flows and Entity Lifecycles can document origins and changes. Inferred support for I3: flows can be typed references between identifiable resources when implemented. No implementation evidence is supplied." .

