ns1:ACT-01-001-field-1 a owl:NamedIndividual,
        ns1:SourceField ;
    rdfs:label "Activities"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L616> ;
    ns1:fieldHeading "Activities" ;
    ns1:sourcePosition 1 ;
    ns1:sourceText "Understand Strategic Enterprise Data Needs (P)" .

ns1:ACT-01-001-field-10 a owl:NamedIndividual,
        ns1:SourceField ;
    rdfs:label "Indirect support"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L616> ;
    ns1:fieldHeading "Indirect support" ;
    ns1:sourcePosition 10 ;
    ns1:sourceText "Indirect support: Governance authority, stewardship and review can assign ownership, fund services and enforce FAIR acceptance criteria. For this activity, use the named deliverable to connect decisions, responsibilities or oversight to measurable FAIR outcomes; a governance record alone is insufficient." .

ns1:ACT-01-001-field-11 a owl:NamedIndividual,
        ns1:SourceField ;
    rdfs:label "What would demonstrate the supported FAIR requirement"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L616> ;
    ns1:fieldHeading "What would demonstrate the supported FAIR requirement" ;
    ns1:sourcePosition 11 ;
    ns1:sourceText "Supporting-process evidence: inspect the named deliverable, responsible/approving roles and dated operating or review records for this activity. No directly supported FAIR requirement is established. To demonstrate FAIR fulfilment, separately test identified data and metadata against the specific requirements commissioned through this process." .

