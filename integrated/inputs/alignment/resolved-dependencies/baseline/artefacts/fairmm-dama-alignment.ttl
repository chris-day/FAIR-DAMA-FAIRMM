ns1:ACT-08-007-field-11 a owl:NamedIndividual,
        ns1:SourceField ;
    rdfs:label "What would demonstrate the supported FAIR requirement"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1583> ;
    ns1:fieldHeading "What would demonstrate the supported FAIR requirement" ;
    ns1:sourcePosition 11 ;
    ns1:sourceText "F2: Inspect representative metadata linked to the described data; validate descriptive fields against a discovery profile covering meaning, scope, creator, temporal coverage and intended use as applicable. A requirements document or tool inventory alone is insufficient.; F4: Search the deployed index/catalogue using several attributes and confirm representative data/metadata records are registered and returned. Database tuning indexes and a repository without search do not establish F4.; Supporting-process evidence: inspect the named deliverable and its approval/maintenance records separately from the resource tests." .

