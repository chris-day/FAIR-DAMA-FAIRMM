align:ACT-02-007-field-8 a owl:NamedIndividual,
        align:SourceField ;
    rdfs:label "FAIR principles supported"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L756> ;
    align:fieldHeading "FAIR principles supported" ;
    align:sourcePosition 8 ;
    align:sourceText "I1 — formal, accessible, shared knowledge representation; I2 — use of vocabularies that follow FAIR principles; R1.3 — domain-relevant community standards" .

align:ACT-02-007-field-9 a owl:NamedIndividual,
        align:SourceField ;
    rdfs:label "How they can support FAIR"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L756> ;
    align:fieldHeading "How they can support FAIR" ;
    align:sourcePosition 9 ;
    align:sourceText "Define and Maintain Enterprise Ontologies, Taxonomies and Namespaces (P) \\[source: DataArchitectureManagement!A8:F8\\] — Deliverable: Enterprise Taxonomies, Industry Ontologies, ISO TC/68 alignment,  XML Namespaces,  Content Management Standards.; Inferred support: industry ontologies, taxonomies and XML namespaces can underpin formal representation and FAIR vocabulary use. ISO TC/68 alignment and content-management standards may support R1.3 where relevant to the domain community; no particular standard/version or conformance evidence is supplied. No implementation evidence is supplied." .

