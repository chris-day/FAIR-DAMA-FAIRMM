align:ACT-10-012-field-10 a owl:NamedIndividual,
        align:SourceField ;
    rdfs:label "Indirect support"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1860> ;
    align:fieldHeading "Indirect support" ;
    align:sourcePosition 10 ;
    align:sourceText "Indirect support: Quality requirements, tests, monitoring and remediation can maintain reliable data; extend them to FAIR metadata and resource tests explicitly. Data accuracy, cleanliness and fitness for business use do not by themselves establish F2 or R1 metadata richness, or any other FAIR requirement." .

align:ACT-10-012-field-11 a owl:NamedIndividual,
        align:SourceField ;
    rdfs:label "What would demonstrate the supported FAIR requirement"@en ;
