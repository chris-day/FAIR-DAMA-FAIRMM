ns1:CumulativeLevelRule a owl:NamedIndividual,
        ns1:DerivationRule ;
    rdfs:label "Cumulative knowledge-area association"@en ;
    ns1:ruleText "For each OnsetAlignment at ordinal k, emit one CumulativeAssociation at each level n with k <= n <= 5. Preserve practice, area and type. n=k is introduced; n>k is inherited. This is association, not capability or maturity inheritance." .

