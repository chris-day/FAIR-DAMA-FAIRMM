ns1:WB-ACT-04-003-indirect-A2 a owl:NamedIndividual,
        ns1:SourceAssertion ;
    dcterms:identifier "WB-ACT-04-003-indirect-A2" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#DataOperationsManagement!A4:L4> ;
    ns1:existingContributionType "Indirect" ;
    ns1:hasPractice ns1:ACT-04-003 ;
    ns1:inSourceTopic ns1:AREA-04 ;
    ns1:originalContributionType "Indirect" ;
    ns1:primarySource <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#DataOperationsManagement!A4:L4> ;
    ns1:rationale "Indirect support: Operations, availability and change management can sustain FAIR infrastructure where the relevant services are commissioned. Recovery, retention or archives can support availability. A2 additionally requires accessible metadata after the associated data cease to be available; this is not specified." ;
