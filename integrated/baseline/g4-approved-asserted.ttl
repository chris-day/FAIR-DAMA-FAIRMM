<urn:fair-dama-fairmm:alignment:ONT-AREA-area-alignment/big-data-data-science/direct/R1> a owl:NamedIndividual,
        ns1:SourceAssertion ;
    dcterms:identifier "ONT-AREA-area-alignment/big-data-data-science/direct/R1" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/dama-ontologies-v1.1.0/dama-fair-mapping.ttl> ;
    ns1:applicabilityCondition "Area-level proposal retained separately from activity and summary classifications." ;
    ns1:derivedFromSourceNode <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#area-alignment/big-data-data-science/direct/R1> ;
    ns1:existingContributionType "Direct" ;
    ns1:inSourceTopic ns1:AREA-13 ;
    ns1:originalContributionType "Direct" ;
    ns1:primarySource <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/dama-ontologies-v1.1.0/dama-fair-mapping.ttl> ;
    ns1:rationale "Inferred potential direct support: documented hypotheses and methods can supply accurate, relevant methodological context for reusing the associated analytical data. The diagram does not establish that these descriptions are complete or associated with identifiable resources." ;
    ns1:sourceLayer "ontology_area_assessment" ;
    ns1:targetsPrinciple <https://w3id.org/fair/principles/terms/R1> .

<urn:fair-dama-fairmm:alignment:ONT-AREA-area-alignment/big-data-data-science/indirect/A1> a owl:NamedIndividual,
        ns1:SourceAssertion ;
    dcterms:identifier "ONT-AREA-area-alignment/big-data-data-science/indirect/A1" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/dama-ontologies-v1.1.0/dama-fair-mapping.ttl> ;
    ns1:applicabilityCondition "Area-level proposal retained separately from activity and summary classifications." ;
    ns1:derivedFromSourceNode <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#area-alignment/big-data-data-science/indirect/A1> ;
    ns1:existingContributionType "Indirect" ;
    ns1:inSourceTopic ns1:AREA-13 ;
    ns1:originalContributionType "Indirect" ;
    ns1:primarySource <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/dama-ontologies-v1.1.0/dama-fair-mapping.ttl> ;
    ns1:rationale "Platform design can enable standardized retrieval, open protocols and controlled access if these are explicitly commissioned and implemented. Operations can sustain identifier-based access and record versioned inputs, model changes and execution history when those controls are explicitly included in the operations plan." ;
    ns1:sourceLayer "ontology_area_assessment" ;
    ns1:targetsPrinciple <https://w3id.org/fair/principles/terms/A1> .

