        ns1:SourceAssertion ;
    dcterms:identifier "ACT-08-003-indirect-A2" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1579> ;
    ns1:existingContributionType "Indirect" ;
    ns1:hasPractice ns1:ACT-08-003 ;
    ns1:inSourceTopic ns1:AREA-08 ;
    ns1:originalContributionType "Indirect" ;
    ns1:primarySource <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1579> ;
    ns1:rationale "Indirect support: Records governance and lifecycle management can sustain content descriptions, controlled access and preservation commitments. Backups and archives are not proof of A2. Commission independent metadata retention and test access after content withdrawal." ;
