    align:fieldHeading "Indirect support" ;
    align:sourcePosition 10 ;
    align:sourceText "Operations can sustain identifier-based access and record versioned inputs, model changes and execution history when those controls are explicitly included in the operations plan." .

align:ACT-13-009-field-11 a owl:NamedIndividual,
        align:SourceField ;
    rdfs:label "What would demonstrate the supported FAIR requirement"@en ;
