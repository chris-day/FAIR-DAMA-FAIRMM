@prefix dama: <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct: <http://purl.org/dc/terms/> .
dama:ToolShape a sh:NodeShape ; sh:targetClass dama:ToolCategory ;
 sh:property [ sh:path rdfs:label ; sh:minCount 1 ] ;
 sh:property [ sh:path dct:source ; sh:minCount 1 ; sh:nodeKind sh:IRI ] .
dama:OccurrenceShape a sh:NodeShape ; sh:targetClass dama:CatalogueOccurrence ;
 sh:property [ sh:path dama:catalogueCategory ; sh:minCount 1 ; sh:maxCount 1 ; sh:class dama:ToolCategory ] ;
 sh:property [ sh:path dama:inCatalogueSection ; sh:minCount 1 ; sh:maxCount 1 ; sh:class dama:CatalogueSection ] ;
 sh:property [ sh:path dama:sourceLine ; sh:minCount 1 ; sh:maxCount 1 ] ;
 sh:property [ sh:path dct:source ; sh:minCount 1 ; sh:nodeKind sh:IRI ] .
