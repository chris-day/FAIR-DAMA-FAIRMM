ns1:DimensionAlignment a owl:Class ;
    rdfs:label "DimensionAlignment"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:targetsDimension ],
        [ a owl:Restriction ;
            owl:maxCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:targetsLevel ],
        ns1:Alignment ;
    owl:disjointWith ns1:LevelAlignment ;
    skos:definition "An alignment with exactly one dimension target."@en .

ns1:Producer a owl:NamedIndividual,
        ns1:DataRole ;
    rdfs:label "Producer"@en ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/FAIR_roles/Data_Producer.md> ;
    skos:definition "A person, team, or system that creates or collects data. Ensuring the data, and its accompanying metadata, is sufficiently documented to comply with FAIR data princinples is an important element of this role." ;
    ns1:inFrameworkVersion ns1:FAIRMM-v1.2.5 .

ns1:Alignment a owl:Class ;
    rdfs:label "Alignment"@en ;
    rdfs:comment "Pattern reuse does not reuse map:fromPractice or map:targetsPrinciple: their FAIR-specific domains and ranges must not classify FAIRMM targets as FAIR subprinciples." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:fromPractice ] ;
    skos:definition "A qualified proposed assertion connecting a practice to a dimension or maturity level."@en .

ns1:SourceAssertion a owl:Class ;
    rdfs:label "SourceAssertion"@en ;
    skos:definition "An original FAIR-principle assertion retained in its own source layer."@en .

ns1:Enabler a owl:NamedIndividual,
        ns1:DataRole ;
    rdfs:label "Enabler"@en ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/FAIR_roles/Data_Enabler.md> ;
    skos:definition "A role (or set of roles) that enables FAIRness at scale by guiding teams and providing the practices, standards, tooling, and support needed so data remains FAIR across planning, creation, publication/sharing, and long-term maintenance." ;
    ns1:inFrameworkVersion ns1:FAIRMM-v1.2.5 .

ns1:RoleAssignmentCandidate a owl:Class ;
    rdfs:label "RoleAssignmentCandidate"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:dataRole ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:fairmmPersona ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:inPractice ] ;
    skos:definition "A proposed data role for a persona in a specific practice, not an appointment."@en .

ns1:SourceField a owl:Class ;
    rdfs:label "SourceField"@en ;
    skos:definition "An original table field, retaining its heading, position and exact text."@en .

ns1:LifecycleReview a owl:Class .

