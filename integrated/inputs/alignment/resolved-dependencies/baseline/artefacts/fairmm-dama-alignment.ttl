ns1:evidence-07b307829b38f6841a465955 a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level1.md#L149> ;
    ns1:matchingPhrase "content management systems" ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level1.md#L149> ;
    ns1:sourceText "There is some centralization of metadata, e.g. with content management systems,ELN systems, e.g. DKAN. There may be a deployment of other systems such as Github, Drupal, Sharepoints." ;
    ns1:supportedByDescriptor ns1:D7-L1 .

ns1:evidence-0cc12778feb35d36d30ffa15 a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L183> ;
    ns1:matchingPhrase "Initial infrastructure and tooling are in place for the first working POCs" ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L183> ;
    ns1:sourceText "Initial infrastructure and tooling are in place for the first working POCs. Now that POCs work and prove value, RFPs or company-wide plans for tooling and infrastructure are getting scoped, including additional capacity for putting that infrastructure and tooling in place (people and budget)." ;
    ns1:supportedByDescriptor ns1:D7-L2 .

ns1:evidence-116067390429ceaf01f3ebe8 a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L183> ;
    ns1:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L183> ;
    ns1:rationale "The named deliverable may address the I2 aspect of these clauses when its applicability condition is met." ;
    ns1:sourceText "The organization may look for reference \"tools\", e.g. controlled vocabularies, ontologies, data standards." ;
    ns1:supportedByDescriptor ns1:D7-L2 ;
    ns1:supportsInterpretation ns1:interpretation-b5edf7c79b0faa0ccdf50c79 .

ns1:evidence-191fa66b03f21013c759feb0 a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level1.md#L120> ;
    ns1:matchingPhrase "strategic integration approach" ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level1.md#L120> ;
    ns1:sourceText "We see a strategic integration approach with the pursuit of Initiatives to implement FAIR principles within specific functions or groups. As part of these efforts, processes may surface for identifying internal and external good practices related to FAIR data. This approach may imply a move toward more systematic and structured approaches to FAIR implementation, aligning with the organization's evolving understanding of the importance of standardized and accessible data." ;
    ns1:supportedByDescriptor ns1:D5-L1 .

ns1:evidence-1ac0ca729c8a48519a19fbb0 a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level5.md#L173> ;
    ns1:matchingPhrase "Data Exploration" ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level5.md#L173> ;
    ns1:sourceText "**Data Exploration**: The system offers tools to explore data with machines capable of interpreting metadata, which can also involve anonymized or aggregated data for tasks like cohorting and feasibility assessments." ;
    ns1:supportedByDescriptor ns1:D7-L5 .

ns1:evidence-2245a1c2d6aa549e46dc675a a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L158> ;
    ns1:matchingPhrase "evaluating and implementing FAIR standards" ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L158> ;
    ns1:sourceText "The organization initiates formal training for FAIR roles while a majority have embraced FAIR principles for major resources, backed by well-trained personnel capable of evaluating and implementing FAIR standards. At least one business unit actively employs FAIR processes in production, supported by documentation and training, with other FAIR initiatives underway and coordinated efforts recognized." ;
    ns1:supportedByDescriptor ns1:D5-L3 .

ns1:evidence-3005db9eebf2c9bf7ce69e06 a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level1.md#L120> ;
    ns1:matchingPhrase "what constitutes reference data" ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level1.md#L120> ;
    ns1:sourceText "The start of alignment discussions on metadata centralization, content management, and what constitutes reference data take place." ;
    ns1:supportedByDescriptor ns1:D5-L1 .

ns1:evidence-313167b8995a60b543c6f1be a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level1.md#L57> ;
    ns1:matchingPhrase "Some data is cataloged and hosted in a data lake" ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level1.md#L57> ;
    ns1:sourceText "Some data is cataloged and hosted in a data lake, and there is governance for accessibility; however, data is generally \"unconformed\" (meaning that no domain model is used to constrain information)." ;
    ns1:supportedByDescriptor ns1:D1-L1 .

ns1:evidence-3e7c18c187aaa85cd3b4f7bb a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L183> ;
    ns1:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L183> ;
    ns1:rationale "The named deliverable may address the A1.1 aspect of these clauses when its applicability condition is met." ;
    ns1:sourceText "The organization may look for reference \"tools\", e.g. controlled vocabularies, ontologies, data standards." ;
    ns1:supportedByDescriptor ns1:D7-L2 ;
    ns1:supportsInterpretation ns1:interpretation-9b780323901b73f34259a626 .

ns1:evidence-4411d57bd00d864e90da5942 a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L183> ;
    ns1:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L183> ;
    ns1:rationale "The named deliverable may address the I2 aspect of these clauses when its applicability condition is met." ;
    ns1:sourceText "At this stage, the following are likely to be implemented (at least in some departments, do not need to be company-wide):Tools introduced to capture and publish metadata; Tools to work with controlled vocabularies; Tools to work with / manage persistent identifiers (PIDs)." ;
    ns1:supportedByDescriptor ns1:D7-L2 ;
    ns1:supportsInterpretation ns1:interpretation-b5edf7c79b0faa0ccdf50c79 .

ns1:evidence-5494fcbd65b85f698edab226 a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L183> ;
    ns1:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L183> ;
    ns1:rationale "The named deliverable may address the D7 aspect of these clauses when its applicability condition is met." ;
    ns1:sourceText "Initial infrastructure and tooling are in place for the first working POCs. Now that POCs work and prove value, RFPs or company-wide plans for tooling and infrastructure are getting scoped, including additional capacity for putting that infrastructure and tooling in place (people and budget)." ;
    ns1:supportedByDescriptor ns1:D7-L2 ;
    ns1:supportsInterpretation ns1:interpretation-77710ddaf7e3c9a1645d6bc3 .

ns1:evidence-63aaa6251e299a21d532a040 a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L186> ;
    ns1:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L186> ;
    ns1:rationale "The named deliverable may address the A1.1 aspect of these clauses when its applicability condition is met." ;
    ns1:sourceText "The approval of Budget and capacity for delivery at scale, along with the launch of RFPs or similar and vendors are selected to put tooling and infrastructure in place for company-wide use." ;
    ns1:supportedByDescriptor ns1:D7-L3 ;
    ns1:supportsInterpretation ns1:interpretation-7751f8a7fbc849388e727d08 .

ns1:evidence-6fc9545414324db75ed57dec a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level4.md#L68> ;
    ns1:matchingPhrase "Cross-domain Analytics is enabled" ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level4.md#L68> ;
    ns1:sourceText "Cross-domain Analytics is enabled and showcases the \"Interoperability' functionality within a given company." ;
    ns1:supportedByDescriptor ns1:D1-L4 .

ns1:evidence-7734453817521dbf4ab92d6c a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level1.md#L120> ;
    ns1:matchingPhrase "data discovery, profiling, and optimization" ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level1.md#L120> ;
    ns1:sourceText "Data domains will have a data discovery, profiling, and optimization phase or project." ;
    ns1:supportedByDescriptor ns1:D5-L1 .

ns1:evidence-78ebedc93f961c56407a0f6d a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level1.md#L120> ;
    ns1:matchingPhrase "content management" ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level1.md#L120> ;
    ns1:sourceText "The start of alignment discussions on metadata centralization, content management, and what constitutes reference data take place." ;
    ns1:supportedByDescriptor ns1:D5-L1 .

ns1:evidence-87b3ab14bb94e694a234c6d2 a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level1.md#L149> ;
    ns1:matchingPhrase "Excel templates" ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level1.md#L149> ;
    ns1:sourceText "We see pragmatic progress in data and metadata creation and curation tools used to enhance existing IT practices (e.g. Excel templates, a drop-down list with limited selected items). There still needs to be complete FAIR tooling, but there is an inventory of the existing tooling and some determination of gaps along with the requirements for FAIR tooling." ;
    ns1:supportedByDescriptor ns1:D7-L1 .

ns1:evidence-94220a8a1a2933a3b9c20512 a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level1.md#L101> ;
    ns1:matchingPhrase "curator" ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level1.md#L101> ;
    ns1:sourceText "Key emerging roles: curator (e.g. corrects and complements data in systems, checks consistency, completeness, and accuracy); semantic expert (e.g. creates and corrects data dictionaries)" ;
    ns1:supportedByDescriptor ns1:D4-L1 .

ns1:evidence-a3aad31904e84fcece2e07e1 a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level1.md#L120> ;
    ns1:matchingPhrase "metadata centralization" ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level1.md#L120> ;
    ns1:sourceText "The start of alignment discussions on metadata centralization, content management, and what constitutes reference data take place." ;
    ns1:supportedByDescriptor ns1:D5-L1 .

ns1:evidence-a843d787f1de86b24cd39514 a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level1.md#L149> ;
    ns1:matchingPhrase "Initial plans for tooling and infrastructure for POCs start to take shape" ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level1.md#L149> ;
    ns1:sourceText "At this stage, there is an understanding of the data challenges and a recognition of the importance of FAIR data. Still, the organization needs to learn how to make it happen. Initial plans for tooling and infrastructure for POCs start to take shape, along with organizational buy-in." ;
    ns1:supportedByDescriptor ns1:D7-L1 .

ns1:evidence-add1ec0d83c08e65325edf14 a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level1.md#L149> ;
    ns1:matchingPhrase "At least one policy on unique resource locators" ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level1.md#L149> ;
    ns1:sourceText "The organization starts thinking about and implementing \"Findability\" with Uniform Resource Identifier (URI) / Globally Unique, Persistent, Resolvable Identifier (GUPRI)services, published metadata catalogs, controlled vocabularies, Master Data Management (MDM) system (What needs to be \"found\"? Who needs to find what?). At least one policy on unique resource locators." ;
    ns1:supportedByDescriptor ns1:D7-L1 .

ns1:evidence-af53c9b6ad7c7009cb2e7f1c a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level4.md#L109> ;
    ns1:matchingPhrase "integration of FAIR metrics into the data governance process" ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level4.md#L109> ;
    ns1:sourceText "The organization has set forth a comprehensive FAIR mandate across the enterprise. This mandate includes the integration of FAIR metrics into the data governance process and data risk management practices. The organization has allocated capacity (budget & people) to deliver on its FAIR data vision. The organization had the time to show the continuity of its strategy and can point to impact areas that have typically been there for several years." ;
    ns1:supportedByDescriptor ns1:D3-L4 .

ns1:evidence-b096462402dab98d79ef83cc a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L140> ;
    ns1:matchingPhrase "licenses, refresh cycles, lineage" ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L140> ;
    ns1:sourceText "The organization possesses comprehensive metadata and awareness of data specifics. Although not all data details are within a FAIR catalog, there's an insight into licenses, refresh cycles, lineage, rationale, intended usage, and business value. Process design ensures knowledge of these aspects, particularly in procurement, contributing to a more comprehensive understanding of data assets." ;
    ns1:supportedByDescriptor ns1:D5-L2 .

ns1:evidence-b51c5ba99f88c52f0cafa2aa a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L186> ;
    ns1:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L186> ;
    ns1:rationale "The named deliverable may address the I2 aspect of these clauses when its applicability condition is met." ;
    ns1:sourceText "Tools that help create FAIR Data and manage metadata collection templates and ontologies are available." ;
    ns1:supportedByDescriptor ns1:D7-L3 ;
    ns1:supportsInterpretation ns1:interpretation-d358104b88b02ad8903b9c79 .

ns1:evidence-b5a1b2c9c81b98c50ae4ee12 a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L186> ;
    ns1:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L186> ;
    ns1:rationale "The named deliverable may address the I2 aspect of these clauses when its applicability condition is met." ;
    ns1:sourceText "The process can start with external resources (people or tools) but needs to shift to internal resources (employees), rolling the tooling and infrastructure out, including training and support." ;
    ns1:supportedByDescriptor ns1:D7-L3 ;
    ns1:supportsInterpretation ns1:interpretation-d358104b88b02ad8903b9c79 .

