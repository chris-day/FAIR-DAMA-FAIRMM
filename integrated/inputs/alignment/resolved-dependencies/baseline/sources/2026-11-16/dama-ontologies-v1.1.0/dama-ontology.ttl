ns1:DMBOK2-2017 a owl:NamedIndividual,
        ns1:FrameworkEdition ;
    rdfs:label "DAMA-DMBOK2 (2017)"@en ;
    dcterms:hasPart ns1:DataArchitecture,
        ns1:DataGovernance,
        ns1:DataIntegrationAndInteroperability,
        ns1:DataModelingAndDesign,
        ns1:DataQualityManagement,
        ns1:DataSecurity,
        ns1:DataStorageAndOperations,
        ns1:DataWarehousingAndBusinessIntelligence,
        ns1:DocumentsAndContentManagement,
        ns1:MetadataManagement,
        ns1:ReferenceAndMasterDataManagement ;
    rdfs:isDefinedBy <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl> ;
    ns1:hasAdditionalTopic ns1:BigDataAndDataScience,
        ns1:DataHandlingEthics,
        ns1:DataManagementMaturityAssessment .

