    rdfs:label "FAIR principles supported"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1723> ;
    align:fieldHeading "FAIR principles supported" ;
    align:sourcePosition 8 ;
    align:sourceText "F2 — rich metadata describing data; R1 — multiple accurate, relevant descriptive attributes" .

align:ACT-09-005-field-9 a owl:NamedIndividual,
        align:SourceField ;
    rdfs:label "How they can support FAIR"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1723> ;
    align:fieldHeading "How they can support FAIR" ;
    align:sourcePosition 9 ;
    align:sourceText "Create and Maintain Metadata (O) \\[source: MetadataManagement!A6:F6\\] — Deliverable: Data Modelling Tools,; Database Management Systems,; Data Integration Tools,; Business Intelligence Tools,; System Management Tools,Database Management Systems; Object Modeling Tools,; Process Modeling Tools,; Report Generating Tools,; Data Quality Tools ,; Data Development and Administration Tools,; Reference and Master Data Management Tools.; Explicit partial support: creating and maintaining metadata supplies descriptions that can enable discovery and reuse. The deliverable is a tool list, so metadata richness and accuracy require record-level inspection. No implementation evidence is supplied." .

align:ACT-09-006-field-1 a owl:NamedIndividual,
        align:SourceField ;
    rdfs:label "Activities"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1724> ;
