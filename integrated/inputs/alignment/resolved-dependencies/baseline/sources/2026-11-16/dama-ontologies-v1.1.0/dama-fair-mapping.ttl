    rdfs:label "Publish rich resource discovery descriptions"@en ;
    ns1:assessmentStatus "Proposed evidence-producing practice; implementation not asserted"@en ;
    ns1:evidenceForPrinciple <https://w3id.org/fair/principles/terms/F2> ;
    ns1:inKnowledgeArea <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#MetadataManagement> .

