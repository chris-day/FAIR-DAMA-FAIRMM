        ns1:SourceAssertion ;
    dcterms:identifier "WB-ACT-10-001-indirect-F2" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#DataQuality!A2:L2> ;
    ns1:existingContributionType "Indirect" ;
    ns1:hasPractice ns1:ACT-10-001 ;
    ns1:inSourceTopic ns1:AREA-10 ;
    ns1:originalContributionType "Indirect" ;
    ns1:primarySource <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#DataQuality!A2:L2> ;
    ns1:rationale "Indirect support: Quality requirements, tests, monitoring and remediation can maintain reliable data; extend them to FAIR metadata and resource tests explicitly. Data accuracy, cleanliness and fitness for business use do not by themselves establish F2 or R1 metadata richness, or any other FAIR requirement." ;
