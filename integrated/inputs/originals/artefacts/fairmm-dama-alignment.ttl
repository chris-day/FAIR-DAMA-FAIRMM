align:ACT-04-003-indirect-A2 a owl:NamedIndividual,
        align:SourceAssertion ;
    dcterms:identifier "ACT-04-003-indirect-A2" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1040> ;
    align:existingContributionType "Indirect" ;
    align:hasPractice align:ACT-04-003 ;
    align:inSourceTopic align:AREA-04 ;
    align:originalContributionType "Indirect" ;
    align:primarySource <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1040> ;
    align:rationale "Indirect support: Operations, availability and change management can sustain FAIR infrastructure where the relevant services are commissioned. Recovery, retention or archives can support availability. A2 additionally requires accessible metadata after the associated data cease to be available; this is not specified." ;
    align:sourceCoordinate "DataOperationsManagement!A4:L4" ;
    align:sourceIntermediatePractice align:practice-2df1e2b53d6e636c66823938 ;
