align:ACT-02-007-indirect-F1 a owl:NamedIndividual,
        align:SourceAssertion ;
    dcterms:identifier "ACT-02-007-indirect-F1" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L756> ;
    align:existingContributionType "Indirect" ;
    align:hasPractice align:ACT-02-007 ;
    align:inSourceTopic align:AREA-02 ;
    align:originalContributionType "Indirect" ;
    align:primarySource <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L756> ;
    align:rationale "Indirect support: Architecture ownership and review can align implemented resources with agreed FAIR representations and service requirements. Namespace governance can enable F1 only if identifiers for data and metadata are globally unique and persistent; XML namespaces alone do not establish F1." ;
    align:sourceCoordinate "DataArchitectureManagement!A8:L8" ;
    align:sourceIntermediatePractice align:practice-25ecb81d4976e4cbdd631eb3 ;
    align:sourceLayer "activity_table" ;
    align:targetsPrinciple fair:F1 .

align:ACT-04-002-indirect-R1.1 a owl:NamedIndividual,
        align:SourceAssertion ;
    dcterms:identifier "ACT-04-002-indirect-R1.1" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1039> ;
    align:existingContributionType "Indirect" ;
    align:hasPractice align:ACT-04-002 ;
    align:inSourceTopic align:AREA-04 ;
    align:originalContributionType "Indirect" ;
    align:primarySource <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1039> ;
    align:rationale "Indirect support: Operations, availability and change management can sustain FAIR infrastructure where the relevant services are commissioned. Acquisition procedures can capture origin (R1.2) and establish release rights (R1.1), but neither is specified by the externally sourced data deliverable." ;
    align:sourceCoordinate "DataOperationsManagement!A3:L3" ;
    align:sourceIntermediatePractice align:practice-830aee39630a29a057b0854a ;
    align:sourceLayer "activity_table" ;
    align:targetsPrinciple fair:R1.1 .

