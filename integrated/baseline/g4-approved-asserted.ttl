<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-3> a owl:NamedIndividual,
        ns4:SourceActivity ;
    rdfs:label "Establish Big Data Environments"@en ;
    dcterms:identifier "BigDataDataScience!A3:L3" ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/assets/13_BigDataDataScience.webp>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/outputs/dama-20261116/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A3:L3> ;
    ns4:alignmentBasis "Activity-derived proposal; source image plus interpreted associations"@en ;
    ns4:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns4:deliverables "Big Data Landscape; Operations Plan"@en ;
    ns4:directSupportExplanation "A deployed platform, database or cloud service does not establish identifier-based retrieval or an open protocol."@en ;
    ns4:evidenceRequirement "Test retrieval of identified data and metadata through a specified standard protocol; inspect freely implementable protocol specifications; test required authentication and authorization. Platform availability alone is insufficient."@en ;
    ns4:inTopic ns2:BigDataAndDataScience ;
    ns4:indirectSupportExplanation "Platform design can enable standardized retrieval, open protocols and controlled access if these are explicitly commissioned and implemented."@en ;
    ns4:lifecycleCode "D"@en ;
    ns4:proposedApprovingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/it-executives> ;
    ns4:proposedContributingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-quality-and-governance-specialists>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/ingestion-architects>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/metadata-specialists> ;
    ns4:proposedResponsiblePersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/big-data-platform-architects> ;
    ns4:relevantDeliverables "Big Data Landscape; Operations Plan"@en ;
    ns4:sourceRow 3 ;
    ns4:sourceWorksheet "BigDataDataScience" .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-7> a owl:NamedIndividual,
        ns4:SourceActivity ;
    rdfs:label "Integrate/Align Data For Analysis"@en ;
    dcterms:identifier "BigDataDataScience!A7:L7" ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/assets/13_BigDataDataScience.webp>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/outputs/dama-20261116/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A7:L7> ;
    ns4:alignmentBasis "Activity-derived proposal; source image plus interpreted associations"@en ;
    ns4:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns4:deliverables "Data Analysis and Hypotheses"@en ;
    ns4:directSupportExplanation "Joining datasets or aligning statistical features does not by itself establish a shared knowledge-representation language or qualified resource references."@en ;
    ns4:evidenceRequirement "Inspect shared formal representations and identifiable resources with typed relations; trace transformations to source versions. Matching columns, feature vectors and internal keys alone are insufficient."@en ;
    ns4:inTopic ns2:BigDataAndDataScience ;
    ns4:indirectSupportExplanation "Integration can preserve provenance and implement explicit semantic representations and typed links when these requirements are included in the integration design."@en ;
    ns4:lifecycleCode "D"@en ;
    ns4:proposedApprovingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/analytic-design-lead>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/big-data-platform-architects> ;
    ns4:proposedContributingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-curators>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-quality-and-governance-specialists>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-smes>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/metadata-specialists> ;
    ns4:proposedResponsiblePersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-scientists>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/ingestion-architects> ;
    ns4:relevantDeliverables "Data Analysis and Hypotheses"@en ;
    ns4:sourceRow 7 ;
    ns4:sourceWorksheet "BigDataDataScience" .

ns2:DataStorageAndOperations a owl:NamedIndividual,
        ns2:DMBOK2-2017-KnowledgeArea ;
    rdfs:label "Data Storage & Operations"@en ;
    rdfs:isDefinedBy <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl> ;
    skos:definition "Ensures data is efficiently stored, retrieved, and maintained. This includes managing databases, implementing backup and recovery solutions, and optimizing data performance."@en .

