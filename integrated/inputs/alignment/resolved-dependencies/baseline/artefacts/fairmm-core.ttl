<urn:fair-dama-fairmm:alignment:AreaRoleOccurrence> a owl:Class ;
    rdfs:label "AreaRoleOccurrence"@en ;
    skos:definition "A supplier, participant or consumer occurrence in a source topic."@en .

<urn:fair-dama-fairmm:alignment:CapabilityProgressionProposal> a owl:Class .

<urn:fair-dama-fairmm:alignment:CapabilityProposal> a owl:Class .

<urn:fair-dama-fairmm:alignment:DiagnosticReview> a owl:Class ;
    rdfs:label "DiagnosticReview"@en ;
    rdfs:subClassOf <urn:fair-dama-fairmm:alignment:LevelReview> ;
    skos:definition "A baseline review that does not assert positive alignment."@en .

<urn:fair-dama-fairmm:alignment:DimensionAlignment> a owl:Class ;
    rdfs:label "DimensionAlignment"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <urn:fair-dama-fairmm:alignment:targetsDimension> ],
        [ a owl:Restriction ;
            owl:maxCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty <urn:fair-dama-fairmm:alignment:targetsLevel> ],
        <urn:fair-dama-fairmm:alignment:Alignment> ;
    owl:disjointWith <urn:fair-dama-fairmm:alignment:LevelAlignment> ;
    skos:definition "An alignment with exactly one dimension target."@en .

<urn:fair-dama-fairmm:alignment:DirectAlignment> a owl:Class ;
    rdfs:label "DirectAlignment"@en ;
    rdfs:subClassOf <urn:fair-dama-fairmm:alignment:Alignment> ;
    owl:disjointWith <urn:fair-dama-fairmm:alignment:IndirectAlignment> ;
    skos:definition "The practice directly produces or verifies evidence relevant to the target capability."@en .

<urn:fair-dama-fairmm:alignment:HistoricalRow> a owl:Class .

<urn:fair-dama-fairmm:alignment:LifecycleReview> a owl:Class .

<urn:fair-dama-fairmm:alignment:MaturityRangeProposal> a owl:Class .

<urn:fair-dama-fairmm:alignment:PracticeBundle> a owl:Class ;
    rdfs:label "PracticeBundle"@en ;
    rdfs:subClassOf <urn:fair-dama-fairmm:alignment:Practice> ;
    skos:definition "A composite practice comprising the source activities behind a level-onset judgement."@en .

<urn:fair-dama-fairmm:alignment:RoleCategory> a owl:Class ;
    rdfs:label "RoleCategory"@en ;
    skos:definition "A source involvement category, separate from a data role."@en .

<urn:fair-dama-fairmm:alignment:SourceSnapshot> a owl:Class ;
    rdfs:label "SourceSnapshot"@en ;
    skos:definition "A pinned source revision or file digest."@en .

<urn:fair-dama-fairmm:alignment:ToolPrincipleProposal> a owl:Class .

<urn:fair-dama-fairmm:alignment:UnresolvedAlignmentCandidate> a owl:Class ;
    rdfs:label "UnresolvedAlignmentCandidate"@en ;
    skos:definition "A documentary candidate with no sufficiently matched descriptor; not an asserted alignment."@en .

<urn:fair-dama-fairmm:alignment:Version125Dimension> a owl:Class .

<urn:fair-dama-fairmm:alignment:Version125MaturityLevel> a owl:Class .

