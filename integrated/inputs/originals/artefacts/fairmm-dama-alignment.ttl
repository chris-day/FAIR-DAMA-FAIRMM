align:evidence-0967979d5f6ad33abfd4d947 a owl:NamedIndividual,
        align:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L79> ;
    align:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    align:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L79> ;
    align:rationale "The named deliverable may address the D2 aspect of these clauses when its applicability condition is met." ;
    align:sourceText "More leadership members in the company have started to understand FAIR data and its value." ;
    align:supportedByDescriptor align:D2-L2 ;
    align:supportsInterpretation align:interpretation-4c89d93b7cf4a916bdf4c88f .

align:evidence-0f12f1b5195d987d9e160261 a owl:NamedIndividual,
        align:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L140> ;
    align:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    align:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L140> ;
    align:rationale "The named deliverable may address the F4 aspect of these clauses when its applicability condition is met." ;
    align:sourceText "Governance: recognize the need for governance processes related to FAIR principles and the processes for FAIR (e.g. master and reference data, consideration of dimensions for FAIR, RDMs )." ;
    align:supportedByDescriptor align:D5-L2 ;
    align:supportsInterpretation align:interpretation-6eb4b137662ec9cd5ca1f221 .

align:evidence-182b0cb38eefea9f0eea7d5f a owl:NamedIndividual,
        align:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L65> ;
    align:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    align:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L65> ;
    align:rationale "The named deliverable may address the F4 aspect of these clauses when its applicability condition is met." ;
    align:sourceText "Data, conformed to a local model, is cataloged (i.e. a metadata record of existence is created), and data resides in a data lake." ;
    align:supportedByDescriptor align:D1-L2 ;
    align:supportsInterpretation align:interpretation-58bc492081d70375669d2f9d .

align:evidence-2d529e9390b71648ab845672 a owl:NamedIndividual,
        align:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L140> ;
    align:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    align:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L140> ;
    align:rationale "The named deliverable may address the F4 aspect of these clauses when its applicability condition is met." ;
    align:sourceText "The organization possesses comprehensive metadata and awareness of data specifics. Although not all data details are within a FAIR catalog, there's an insight into licenses, refresh cycles, lineage, rationale, intended usage, and business value. Process design ensures knowledge of these aspects, particularly in procurement, contributing to a more comprehensive understanding of data assets." ;
    align:supportedByDescriptor align:D5-L2 ;
    align:supportsInterpretation align:interpretation-6eb4b137662ec9cd5ca1f221 .

align:evidence-39f79df7d473215c2a7572ff a owl:NamedIndividual,
        align:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L66> ;
    align:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    align:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L66> ;
    align:rationale "The named deliverable may address the F4 aspect of these clauses when its applicability condition is met." ;
    align:sourceText "One can find “FAIR” data in local environments such as a organization’s departments, divisions or functions." ;
    align:supportedByDescriptor align:D1-L3 ;
    align:supportsInterpretation align:interpretation-7916e71608d980241cda8967 .

align:evidence-4786faf245219f0a9a694ce5 a owl:NamedIndividual,
        align:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L158> ;
    align:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    align:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L158> ;
    align:rationale "The named deliverable may address the F4 aspect of these clauses when its applicability condition is met." ;
    align:sourceText "The organization initiates formal training for FAIR roles while a majority have embraced FAIR principles for major resources, backed by well-trained personnel capable of evaluating and implementing FAIR standards. At least one business unit actively employs FAIR processes in production, supported by documentation and training, with other FAIR initiatives underway and coordinated efforts recognized." ;
    align:supportedByDescriptor align:D5-L3 ;
    align:supportsInterpretation align:interpretation-8dd94d33c75963d7d8c8c307 .

align:evidence-549d9856d8c0739ace02dcb0 a owl:NamedIndividual,
        align:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L88> ;
    align:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    align:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L88> ;
    align:rationale "The named deliverable may address the D2 aspect of these clauses when its applicability condition is met." ;
    align:sourceText "Leadership has a vision and plans to make the entire company aware of FAIR data, FAIR practices and their value." ;
    align:supportedByDescriptor align:D2-L3 ;
    align:supportsInterpretation align:interpretation-928a1143210545387e04ed63 .

align:evidence-59ad702818c83c965ee9a789 a owl:NamedIndividual,
        align:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level1.md#L120> ;
    align:matchingPhrase "guidelines for creating FAIR data" ;
    align:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level1.md#L120> ;
    align:sourceText "In recognizing FAIR data's potential (business) value, there are processes to consider and determine which data we should makeFAIR retrospectively. Efforts are underway to establish processes that provide guidelines for creating FAIR data, including the policy development for globally unique identifiers to enable the \"F\" principle." ;
    align:supportedByDescriptor align:D5-L1 .

align:evidence-6336c7b780f4d68050dd8da0 a owl:NamedIndividual,
        align:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L186> ;
    align:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    align:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L186> ;
    align:rationale "The named deliverable may address the F4 aspect of these clauses when its applicability condition is met." ;
    align:sourceText "The process can start with external resources (people or tools) but needs to shift to internal resources (employees), rolling the tooling and infrastructure out, including training and support." ;
    align:supportedByDescriptor align:D7-L3 ;
    align:supportsInterpretation align:interpretation-fa91e1b2adb72ab6f7730b3f .

align:evidence-814c46ef7c6aae959ebcb6fa a owl:NamedIndividual,
        align:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L186> ;
    align:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    align:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L186> ;
    align:rationale "The named deliverable may address the I1 aspect of these clauses when its applicability condition is met." ;
    align:sourceText "An \"anchor/reference model\", or \"enterprise-wide data model\", is being built (cf. refer to the Strategy dimension). This model can also be a semantic model external to the organization but selected based on business needs and suitability." ;
    align:supportedByDescriptor align:D7-L3 ;
    align:supportsInterpretation align:interpretation-51b4a5787af4c76faa4fdba4 .

align:evidence-834c76761e92b41a2c47e384 a owl:NamedIndividual,
        align:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L123> ;
    align:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    align:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L123> ;
    align:rationale "The named deliverable may address the D4 aspect of these clauses when its applicability condition is met." ;
    align:sourceText "The same individual often has multiple hats, or can embody multiple personas. However, designated roles start to take shape in the company. Organisaitons begin to have designated FAIR-related roles: advertising for new positions and recognising explicitly the FAIRification work that some people have done implicitly (and often without recognition) in their previous roles." ;
    align:supportedByDescriptor align:D4-L2 ;
    align:supportsInterpretation align:interpretation-c9b19eb0329ae7df3cb9feed .

align:evidence-84f0760d368e34fe3bbf8fa7 a owl:NamedIndividual,
        align:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L183> ;
    align:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    align:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L183> ;
    align:rationale "The named deliverable may address the I1 aspect of these clauses when its applicability condition is met." ;
    align:sourceText "Tool(s) or infrastructure component which contributes, enhances or enriches Findability:" ;
    align:supportedByDescriptor align:D7-L2 ;
    align:supportsInterpretation align:interpretation-5d25756965cbeac3a069a057 .

align:evidence-b6b1594c1eb6b1fe3bd4e239 a owl:NamedIndividual,
        align:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L158> ;
    align:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    align:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L158> ;
    align:rationale "The named deliverable may address the F4 aspect of these clauses when its applicability condition is met." ;
    align:sourceText "The FAIR data training is part of employee onboarding and continuous education development. The organization tailors specific FAIR processes to suit its needs and incorporates guidelines for providing FAIR data into standard IT procedures. Efforts to make metadata implementation accessible in a standardized manner without changing existing processes. The organization begins to integrate FAIR practices into workflows and configure systems to facilitate FAIR practices, demonstrating a commitment to normalising FAIR standards within organizational operations." ;
    align:supportedByDescriptor align:D5-L3 ;
    align:supportsInterpretation align:interpretation-8dd94d33c75963d7d8c8c307 .

align:evidence-b6f08d8ab9b895e12040aea1 a owl:NamedIndividual,
        align:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L135> ;
    align:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    align:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L135> ;
    align:rationale "The named deliverable may address the D4 aspect of these clauses when its applicability condition is met." ;
    align:sourceText "Teams with complementary roles emerge. For example, IT and business functions may collaborate in creating Knowledge Graphs with the help of teams including personas such as  [Subject_Matter_Expert](FAIR_personas/Subject_Matter_Expert.md) ,[Business_Analyst](FAIR_personas/Business_Analyst.md) , [FAIR_Data_Architect](FAIR_personas/FAIR_Data_Architect.md),  [Data_Engineer](FAIR_personas/Data_Engineer.md), [Ontologist](FAIR_personas/Ontologist.md)" ;
    align:supportedByDescriptor align:D4-L3 ;
    align:supportsInterpretation align:interpretation-680d20eae233d06b08578574 .

align:evidence-b8b99c9bc8ccb78b768f30b7 a owl:NamedIndividual,
        align:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L186> ;
