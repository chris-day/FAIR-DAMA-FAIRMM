    ns1:sourceText "O" .

ns1:ACT-09-009-field-7 a owl:NamedIndividual,
        ns1:SourceField ;
    rdfs:label "Relevant deliverables"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1727> ;
    ns1:fieldHeading "Relevant deliverables" ;
    ns1:sourcePosition 7 ;
    ns1:sourceText "Quality Metadata, Metadata Management Operational Analysis, Metadata Analysis,; Data Lineage,; Change Impact Analysis" .

ns1:ACT-09-009-field-8 a owl:NamedIndividual,
        ns1:SourceField ;
    rdfs:label "FAIR principles supported"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1727> ;
    ns1:fieldHeading "FAIR principles supported" ;
    ns1:sourcePosition 8 ;
    ns1:sourceText "F4 — registration/indexing in a searchable resource; R1 — multiple accurate, relevant descriptive attributes; R1.2 — detailed provenance associated with data and metadata" .

ns1:ACT-09-009-field-9 a owl:NamedIndividual,
        ns1:SourceField ;
    rdfs:label "How they can support FAIR"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1727> ;
    ns1:fieldHeading "How they can support FAIR" ;
    ns1:sourcePosition 9 ;
    ns1:sourceText "Query, Report and Analyse Metadata (O)  \\[source: MetadataManagement!A10:F10\\] — Deliverable: Quality Metadata, Metadata Management Operational Analysis, Metadata Analysis,; Data Lineage,; Change Impact Analysis.; Explicit partial support: metadata query/reporting supports discovery, quality metadata supports reuse descriptions, and the named Data Lineage deliverable supports provenance. Search indexing, rich accurate attributes and detailed associated lineage remain to be verified. No implementation evidence is supplied." .

ns1:ACT-10-001-field-1 a owl:NamedIndividual,
        ns1:SourceField ;
    rdfs:label "Activities"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1849> ;
    ns1:fieldHeading "Activities" ;
    ns1:sourcePosition 1 ;
    ns1:sourceText "Develop and Promote Data Quality Awareness (O)" .

ns1:ACT-10-001-field-10 a owl:NamedIndividual,
        ns1:SourceField ;
    rdfs:label "Indirect support"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1849> ;
    ns1:fieldHeading "Indirect support" ;
    ns1:sourcePosition 10 ;
    ns1:sourceText "Indirect support: Quality requirements, tests, monitoring and remediation can maintain reliable data; extend them to FAIR metadata and resource tests explicitly. Data accuracy, cleanliness and fitness for business use do not by themselves establish F2 or R1 metadata richness, or any other FAIR requirement." .

ns1:ACT-10-001-field-11 a owl:NamedIndividual,
        ns1:SourceField ;
    rdfs:label "What would demonstrate the supported FAIR requirement"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1849> ;
