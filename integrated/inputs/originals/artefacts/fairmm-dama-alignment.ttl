    align:sourceLayer "ontology_area_assessment" ;
    align:targetsPrinciple fair:R1.1 .

<urn:fair-dama-fairmm:alignment:ONT-AREA-area-alignment/big-data-data-science/indirect/R1.2> a owl:NamedIndividual,
        align:SourceAssertion ;
    dcterms:identifier "ONT-AREA-area-alignment/big-data-data-science/indirect/R1.2" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/dama-ontologies-v1.1.0/dama-fair-mapping.ttl> ;
    align:applicabilityCondition "Area-level proposal retained separately from activity and summary classifications." ;
    align:derivedFromSourceNode <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#area-alignment/big-data-data-science/indirect/R1.2> ;
    align:existingContributionType "Indirect" ;
    align:inSourceTopic align:AREA-13 ;
    align:originalContributionType "Indirect" ;
    align:primarySource <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/dama-ontologies-v1.1.0/dama-fair-mapping.ttl> ;
    align:rationale "Source evaluation can record origin, permitted reuse and descriptive context, enabling provenance and licensing requirements when resource-linked records and accessible terms are retained. Ingestion can capture resource descriptions, source versions, acquisition times and transformations if metadata capture is added as an explicit requirement. Versioned methods and input records can enable provenance when linked to the resulting data and model outputs. Integration can preserve provenance and implement explicit semantic representations and typed links when these requirements are included in the integration design. Exploration can enrich reuse descriptions and provenance if assumptions, limitations, source versions, model versions and analytical steps are recorded with the resulting resources. Operations can sustain identifier-based access and record versioned inputs, model changes and execution history when those controls are explicitly included in the operations plan." ;
    align:sourceLayer "ontology_area_assessment" ;
    align:targetsPrinciple fair:R1.2 .

<urn:fair-dama-fairmm:alignment:ONT-AREA-area-alignment/big-data-data-science/indirect/R1.3> a owl:NamedIndividual,
        align:SourceAssertion ;
    dcterms:identifier "ONT-AREA-area-alignment/big-data-data-science/indirect/R1.3" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/dama-ontologies-v1.1.0/dama-fair-mapping.ttl> ;
    align:applicabilityCondition "Area-level proposal retained separately from activity and summary classifications." ;
    align:derivedFromSourceNode <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#area-alignment/big-data-data-science/indirect/R1.3> ;
    align:existingContributionType "Indirect" ;
    align:inSourceTopic align:AREA-13 ;
    align:originalContributionType "Indirect" ;
    align:primarySource <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/dama-ontologies-v1.1.0/dama-fair-mapping.ttl> ;
    align:rationale "Standards selection can commission domain-relevant community conformance if named external standards, versions and acceptance tests are explicitly adopted. Internal IT standards alone are insufficient." ;
    align:sourceLayer "ontology_area_assessment" ;
    align:targetsPrinciple fair:R1.3 .

