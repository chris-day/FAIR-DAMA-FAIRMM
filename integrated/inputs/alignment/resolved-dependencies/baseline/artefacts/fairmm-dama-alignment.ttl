ns1:evidence-581bd51d89fe3a168976633b a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L140> ;
    ns1:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L140> ;
    ns1:rationale "The named deliverable may address the R1.3 aspect of these clauses when its applicability condition is met." ;
    ns1:sourceText "Governance processes may have other names. They focus on conflict resolution, reconciliation, and community building." ;
    ns1:supportedByDescriptor ns1:D5-L2 ;
    ns1:supportsInterpretation ns1:interpretation-ab2e3af8338d93b93e473ec7 .

ns1:evidence-7149f1c134f25e18bdb34e7c a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L158> ;
    ns1:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L158> ;
    ns1:rationale "The named deliverable may address the R1.3 aspect of these clauses when its applicability condition is met." ;
    ns1:sourceText "The FAIR data training is part of employee onboarding and continuous education development. The organization tailors specific FAIR processes to suit its needs and incorporates guidelines for providing FAIR data into standard IT procedures. Efforts to make metadata implementation accessible in a standardized manner without changing existing processes. The organization begins to integrate FAIR practices into workflows and configure systems to facilitate FAIR practices, demonstrating a commitment to normalising FAIR standards within organizational operations." ;
    ns1:supportedByDescriptor ns1:D5-L3 ;
    ns1:supportsInterpretation ns1:interpretation-08c859d4a37f94f845d527ed .

ns1:evidence-74f6efacc1d3281a423c8619 a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L158> ;
    ns1:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L158> ;
    ns1:rationale "The named deliverable may address the R1.3 aspect of these clauses when its applicability condition is met." ;
    ns1:sourceText "The organization initiates formal training for FAIR roles while a majority have embraced FAIR principles for major resources, backed by well-trained personnel capable of evaluating and implementing FAIR standards. At least one business unit actively employs FAIR processes in production, supported by documentation and training, with other FAIR initiatives underway and coordinated efforts recognized." ;
    ns1:supportedByDescriptor ns1:D5-L3 ;
    ns1:supportsInterpretation ns1:interpretation-08c859d4a37f94f845d527ed .

ns1:evidence-799737bc0034a7aee871a36c a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level1.md#L57> ;
    ns1:matchingPhrase "emerging awareness and application of metadata" ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level1.md#L57> ;
    ns1:sourceText "Heterogeneity is a feature of this stage: some data may be unstructured, while pockets of structured data may be in the organization. There is an emerging awareness and application of metadata. Scoping starts with making data FAIR. The deployment of Identifiers and metadata is beginning. Multiple types of identifiers (not necessarily GUPRI) may exist." ;
    ns1:supportedByDescriptor ns1:D1-L1 .

ns1:evidence-cbe4db17f5d6cf54fbfe6683 a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L65> ;
    ns1:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L65> ;
    ns1:rationale "The named deliverable may address the R1.3 aspect of these clauses when its applicability condition is met." ;
    ns1:sourceText "At the organization level, data is conformed system-by-system and may not map to a domain data model." ;
    ns1:supportedByDescriptor ns1:D1-L2 ;
    ns1:supportsInterpretation ns1:interpretation-3274cdfbdc42954c91e6d497 .

ns1:evidence-ed7f57f3a29b40d99b0fa6af a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level1.md#L85> ;
    ns1:matchingPhrase "A vision and plan for FAIR data begins to emerge" ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level1.md#L85> ;
    ns1:sourceText "Awareness of FAIR data started. A vision and plan for FAIR data begins to emerge. Different strategies are possible and are embryonic." ;
    ns1:supportedByDescriptor ns1:D3-L1 .

ns1:evidence-ef8b89e376e5eea298bd8bdf a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L66> ;
    ns1:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L66> ;
    ns1:rationale "The named deliverable may address the R1.3 aspect of these clauses when its applicability condition is met." ;
    ns1:sourceText "Data is “conformed” using a domain-level data model. It is integrated, processed and audited to support specific consumption patterns." ;
    ns1:supportedByDescriptor ns1:D1-L3 ;
    ns1:supportsInterpretation ns1:interpretation-99d8b7057d133902d19bcc41 .

ns1:evidence-f83cc29773ced04527577f49 a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L140> ;
    ns1:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L140> ;
    ns1:rationale "The named deliverable may address the R1.3 aspect of these clauses when its applicability condition is met." ;
    ns1:sourceText "Efforts toward aligning individual FAIR data processes are underway but still need to be standardized, with ongoing coordination and integrated proof-of-concept projects in development." ;
    ns1:supportedByDescriptor ns1:D5-L2 ;
    ns1:supportsInterpretation ns1:interpretation-ab2e3af8338d93b93e473ec7 .

