        <https://w3id.org/fair/principles/terms/FAIR-SubPrinciple> ;
    rdfs:label "I3"@en ;
    rdfs:isDefinedBy <https://w3id.org/fair/principles/latest/I3> ;
    skos:definition "(meta)data include qualified references to other (meta)data"@en .

ns1:D1 a owl:NamedIndividual,
        ns1:Dimension,
        ns1:Version125Dimension ;
    rdfs:label "FAIR Data"@en ;
    dcterms:identifier "D1" ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/fmm-d1.md> ;
    skos:definition "This dimension concerns metadata, data, and data products. Several frameworks to evaluate the maturity of FAIR data exist publicly and in private organizational environments. The intention of this dimension is to provide a qualitative pragmatic indication, not to replace existing FAIR data assessment models. For a catalogue of FAIR data assessment tools and methods we refer to: FAIR assist tools.  Especially at the initial levels, a FAIR assessment tool should help identify the FAIR data principles in focus when starting a FAIR data implementation journey. This dimension closely connects to FAIR tools, infrastructures, processes, and personas." ;
    ns1:inFrameworkVersion ns1:FAIRMM-v1.2.5 ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/fmm-d1.md> ;
    ns1:sourceText "This dimension concerns metadata, data, and data products. Several frameworks to evaluate the maturity of FAIR data exist publicly and in private organizational environments. The intention of this dimension is to provide a qualitative pragmatic indication, not to replace existing FAIR data assessment models. For a catalogue of FAIR data assessment tools and methods we refer to: [FAIR assist tools](https://fairassist.org/tools).  Especially at the initial levels, a FAIR assessment tool should help identify the FAIR data principles in focus when starting a FAIR data implementation journey. This dimension closely connects to FAIR tools, infrastructures, processes, and personas." .

