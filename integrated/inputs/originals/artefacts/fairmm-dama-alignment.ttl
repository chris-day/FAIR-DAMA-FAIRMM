    align:sourceLayer "activity_table" ;
    align:targetsPrinciple fair:A1 .

align:ACT-08-003-indirect-A2 a owl:NamedIndividual,
        align:SourceAssertion ;
    dcterms:identifier "ACT-08-003-indirect-A2" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1579> ;
