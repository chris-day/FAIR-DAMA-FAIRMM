    ns1:primarySource <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L907> ;
    ns1:rationale "Design Data Integration Services (D)  \\[source: DataDevelopment!A9:F9\\] — Deliverable: Source-to-Target Maps, ETL Design Specs, Conversion Designs.; Explicit partial support for R1.2: source-to-target maps and ETL/conversion designs record transformation context. Inferred support for I3: those mappings can be expressed as typed references to identifiable source/target resources; design documents alone do not prove implementation. No implementation evidence is supplied." ;
    ns1:sourceCoordinate "DataModelingDesign!A9:L9" ;
    ns1:sourceLayer "activity_table" ;
    ns1:targetsPrinciple <https://w3id.org/fair/principles/terms/I3> .

ns1:ACT-03-008-direct-R1.2 a owl:NamedIndividual,
        ns1:SourceAssertion ;
    dcterms:identifier "ACT-03-008-direct-R1.2" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L907> ;
    ns1:existingContributionType "Direct" ;
    ns1:hasPractice ns1:ACT-03-008 ;
    ns1:inSourceTopic ns1:AREA-03 ;
    ns1:originalContributionType "Direct" ;
    ns1:primarySource <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L907> ;
    ns1:rationale "Design Data Integration Services (D)  \\[source: DataDevelopment!A9:F9\\] — Deliverable: Source-to-Target Maps, ETL Design Specs, Conversion Designs.; Explicit partial support for R1.2: source-to-target maps and ETL/conversion designs record transformation context. Inferred support for I3: those mappings can be expressed as typed references to identifiable source/target resources; design documents alone do not prove implementation. No implementation evidence is supplied." ;
    ns1:sourceCoordinate "DataModelingDesign!A9:L9" ;
    ns1:sourceLayer "activity_table" ;
    ns1:targetsPrinciple <https://w3id.org/fair/principles/terms/R1.2> .

ns1:ACT-03-011-direct-R1.2 a owl:NamedIndividual,
        ns1:SourceAssertion ;
    dcterms:identifier "ACT-03-011-direct-R1.2" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L910> ;
    ns1:existingContributionType "Direct" ;
    ns1:hasPractice ns1:ACT-03-011 ;
    ns1:inSourceTopic ns1:AREA-03 ;
    ns1:originalContributionType "Direct" ;
    ns1:primarySource <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L910> ;
    ns1:rationale "Manage Data Model Versioning and Integration (C)  \\[source: DataDevelopment!A12:F12\\] — Deliverable: Model Management Libraries and Contents.; Explicit partial support: model management libraries and versioning can record the provenance of model artefacts if these are in the FAIR scope. Version records must be associated with released model data/metadata; versioning alone is incomplete provenance. No implementation evidence is supplied." ;
    ns1:sourceCoordinate "DataModelingDesign!A12:L12" ;
    ns1:sourceLayer "activity_table" ;
    ns1:targetsPrinciple <https://w3id.org/fair/principles/terms/R1.2> .

ns1:ACT-03-016-direct-A1 a owl:NamedIndividual,
        ns1:SourceAssertion ;
    dcterms:identifier "ACT-03-016-direct-A1" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L915> ;
    ns1:existingContributionType "Direct" ;
    ns1:hasPractice ns1:ACT-03-016 ;
    ns1:inSourceTopic ns1:AREA-03 ;
    ns1:originalContributionType "Direct" ;
    ns1:primarySource <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L915> ;
    ns1:rationale "Build and Test Data Access Services (D) \\[source: DataDevelopment!A17:F17\\] — Deliverable: Data Access Services,(interfaces).; Inferred support: built and tested data access services can implement retrieval by identifier using a standard protocol; interface existence and generic service tests are insufficient. No implementation evidence is supplied." ;
    ns1:sourceCoordinate "DataModelingDesign!A17:L17" ;
    ns1:sourceLayer "activity_table" ;
    ns1:targetsPrinciple <https://w3id.org/fair/principles/terms/A1> .

ns1:ACT-04-004-indirect-A2 a owl:NamedIndividual,
        ns1:SourceAssertion ;
    dcterms:identifier "ACT-04-004-indirect-A2" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1041> ;
    ns1:existingContributionType "Indirect" ;
    ns1:hasPractice ns1:ACT-04-004 ;
    ns1:inSourceTopic ns1:AREA-04 ;
    ns1:originalContributionType "Indirect" ;
    ns1:primarySource <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1041> ;
    ns1:rationale "Indirect support: Operations, availability and change management can sustain FAIR infrastructure where the relevant services are commissioned. Recovery, retention or archives can support availability. A2 additionally requires accessible metadata after the associated data cease to be available; this is not specified." ;
    ns1:sourceCoordinate "DataOperationsManagement!A5:L5" ;
    ns1:sourceIntermediatePractice ns1:practice-2df1e2b53d6e636c66823938 ;
    ns1:sourceLayer "activity_table" ;
    ns1:targetsPrinciple <https://w3id.org/fair/principles/terms/A2> .

ns1:ACT-05-008-indirect-A1.2 a owl:NamedIndividual,
        ns1:SourceAssertion ;
    dcterms:identifier "ACT-05-008-indirect-A1.2" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1178> ;
    ns1:existingContributionType "Indirect" ;
    ns1:hasPractice ns1:ACT-05-008 ;
    ns1:inSourceTopic ns1:AREA-05 ;
    ns1:originalContributionType "Indirect" ;
    ns1:primarySource <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1178> ;
    ns1:rationale "Indirect support: Security governance and classification can determine legitimate access conditions and oversee their operation. Security controls must be incorporated into the retrieval protocol to fulfil A1.2; source confidentiality does not imply a FAIR accessibility result." ;
    ns1:sourceCoordinate "DataSecurityManagement!A9:L9" ;
    ns1:sourceIntermediatePractice ns1:practice-5048b9cb33558af92342eec5 ;
    ns1:sourceLayer "activity_table" ;
    ns1:targetsPrinciple <https://w3id.org/fair/principles/terms/A1.2> .

ns1:ACT-07-004-direct-F4 a owl:NamedIndividual,
        ns1:SourceAssertion ;
    dcterms:identifier "ACT-07-004-direct-F4" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1445> ;
