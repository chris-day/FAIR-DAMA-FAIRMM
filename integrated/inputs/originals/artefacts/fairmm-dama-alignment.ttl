align:evidence-3344d118edecb0785dd50ce9 a owl:NamedIndividual,
        align:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level1.md#L57> ;
    align:matchingPhrase "governance for accessibility" ;
    align:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level1.md#L57> ;
    align:sourceText "Some data is cataloged and hosted in a data lake, and there is governance for accessibility; however, data is generally \"unconformed\" (meaning that no domain model is used to constrain information)." ;
    align:supportedByDescriptor align:D1-L1 .

align:evidence-35e899e233a060df0751c871 a owl:NamedIndividual,
        align:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L183> ;
    align:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    align:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L183> ;
    align:rationale "The named deliverable may address the A1.2 aspect of these clauses when its applicability condition is met." ;
    align:sourceText "At this stage, the following are likely to be implemented (at least in some departments, do not need to be company-wide):Tools introduced to capture and publish metadata; Tools to work with controlled vocabularies; Tools to work with / manage persistent identifiers (PIDs)." ;
    align:supportedByDescriptor align:D7-L2 ;
    align:supportsInterpretation align:interpretation-116912c078a12de1dbf03b3e .

align:evidence-570a02fa66252079268eccf3 a owl:NamedIndividual,
        align:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L186> ;
    align:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    align:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L186> ;
    align:rationale "The named deliverable may address the A1.2 aspect of these clauses when its applicability condition is met." ;
    align:sourceText "The process can start with external resources (people or tools) but needs to shift to internal resources (employees), rolling the tooling and infrastructure out, including training and support." ;
    align:supportedByDescriptor align:D7-L3 ;
    align:supportsInterpretation align:interpretation-016c66dfe36a9acbac02bbd3 .

align:evidence-7bb2392071c34b91d73217f2 a owl:NamedIndividual,
        align:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L164> ;
    align:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    align:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L164> ;
    align:rationale "The named deliverable may address the D6 aspect of these clauses when its applicability condition is met." ;
    align:sourceText "FAIR knowledge is largely in people yet needs more formalization." ;
    align:supportedByDescriptor align:D6-L2 ;
    align:supportsInterpretation align:interpretation-c396f8c5683c7cab6c5a873b .

align:evidence-890369e6ad2659ce4303d776 a owl:NamedIndividual,
        align:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L183> ;
    align:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    align:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L183> ;
    align:rationale "The named deliverable may address the A1.2 aspect of these clauses when its applicability condition is met." ;
    align:sourceText "Tool(s) or infrastructure component(s) which contributes, enhances or enriches Accessibility." ;
    align:supportedByDescriptor align:D7-L2 ;
    align:supportsInterpretation align:interpretation-116912c078a12de1dbf03b3e .

align:evidence-98c9ecdb9db1ffdbadc067e6 a owl:NamedIndividual,
        align:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L171> ;
    align:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    align:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L171> ;
    align:rationale "The named deliverable may address the D6 aspect of these clauses when its applicability condition is met." ;
    align:sourceText "A community of knowledgeable FAIR practitioners have met and have started sharing experiences in making data FAIR, at least at the department level." ;
    align:supportedByDescriptor align:D6-L3 ;
    align:supportsInterpretation align:interpretation-5c1ca28f608f20a249f202d5 .

align:evidence-adfe5ee7794bda56abb199e9 a owl:NamedIndividual,
        align:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L186> ;
    align:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    align:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L186> ;
    align:rationale "The named deliverable may address the A1.2 aspect of these clauses when its applicability condition is met." ;
    align:sourceText "Tool(s) or infrastructure component(s) which contributes, enhances or enriches Accessibility." ;
    align:supportedByDescriptor align:D7-L3 ;
    align:supportsInterpretation align:interpretation-016c66dfe36a9acbac02bbd3 .

align:evidence-e40b298ee7a5e939df85b82a a owl:NamedIndividual,
        align:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L171> ;
    align:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    align:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L171> ;
    align:rationale "The named deliverable may address the D6 aspect of these clauses when its applicability condition is met." ;
    align:sourceText "The Community of Practice drives domain knowledge through the common understanding and interpretation of data and its context." ;
    align:supportedByDescriptor align:D6-L3 ;
    align:supportsInterpretation align:interpretation-5c1ca28f608f20a249f202d5 .

align:evidence-e6dfe0846365d6f3da2ac6c1 a owl:NamedIndividual,
        align:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L164> ;
    align:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    align:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L164> ;
    align:rationale "The named deliverable may address the D6 aspect of these clauses when its applicability condition is met." ;
    align:sourceText "Community of practice also forms internally and facilitates knowledge exchanges ( for example, exchanges around emerging/good practices for FAIR and data Stewardship )." ;
    align:supportedByDescriptor align:D6-L2 ;
    align:supportsInterpretation align:interpretation-c396f8c5683c7cab6c5a873b .

