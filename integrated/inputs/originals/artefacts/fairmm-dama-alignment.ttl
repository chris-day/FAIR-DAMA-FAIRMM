    align:fieldHeading "Indirect support" ;
    align:sourcePosition 10 ;
    align:sourceText "Recording historical inputs, model versions, events and triggered actions can provide provenance for derived outputs." .

align:ACT-11-014-field-11 a owl:NamedIndividual,
