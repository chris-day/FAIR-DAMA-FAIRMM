        ns1:interpretation-b5edf7c79b0faa0ccdf50c79,
        ns1:interpretation-d58cd3c7e1401530410e6a73,
        ns1:interpretation-fa3f086e1bf9403022609a46 ;
    ns1:inDimension ns1:D7 ;
    ns1:inFrameworkVersion ns1:FAIRMM-v1.2.5 ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L183> .

