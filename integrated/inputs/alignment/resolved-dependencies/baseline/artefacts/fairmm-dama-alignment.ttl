ns1:ACT-03-005-direct-I1 a owl:NamedIndividual,
        ns1:SourceAssertion ;
    dcterms:identifier "ACT-03-005-direct-I1" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L904> ;
