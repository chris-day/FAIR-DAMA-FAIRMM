ns1:ACT-06-006-field-8 a owl:NamedIndividual,
        ns1:SourceField ;
    rdfs:label "FAIR principles supported"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1309> ;
    ns1:fieldHeading "FAIR principles supported" ;
    ns1:sourcePosition 8 ;
    ns1:sourceText "I3 — qualified references to other data or metadata; R1.2 — detailed provenance associated with data and metadata" .

ns1:ACT-06-006-field-9 a owl:NamedIndividual,
        ns1:SourceField ;
    rdfs:label "How they can support FAIR"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1309> ;
    ns1:fieldHeading "How they can support FAIR" ;
    ns1:sourcePosition 9 ;
    ns1:sourceText "Establish Golden Records (C) \\[source: ReferenceMasterDataManagement!A7:F7\\] — Deliverable: Reliable Reference and Master Data,; Cross-Reference Data,; Data Lineage Reports,; Data Quality Reports.; Explicit partial support for R1.2: Data Lineage Reports can record origins and changes. Inferred support for I3: Cross-Reference Data can become typed references to identified resources; reliable golden records alone do not establish FAIRness. No implementation evidence is supplied." .

ns1:ACT-06-007-field-1 a owl:NamedIndividual,
