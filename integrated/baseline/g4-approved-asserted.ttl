    ns1:originalContributionType "Indirect" ;
    ns1:primarySource <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/dama-ontologies-v1.1.0/dama-fair-mapping.ttl> ;
    ns1:rationale "Standards selection can commission domain-relevant community conformance if named external standards, versions and acceptance tests are explicitly adopted. Internal IT standards alone are insufficient." ;
    ns1:sourceLayer "ontology_area_assessment" ;
    ns1:targetsPrinciple <https://w3id.org/fair/principles/terms/R1.3> .

