align:ACT-03-007-field-9 a owl:NamedIndividual,
        align:SourceField ;
    rdfs:label "How they can support FAIR"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L906> ;
    align:fieldHeading "How they can support FAIR" ;
    align:sourcePosition 9 ;
    align:sourceText "Design Data Access Services (D) \\[source: DataDevelopment!A8:F8\\] — Deliverable: Data Access Service Design Specifications.; Inferred support: access-service design can specify identifier-based retrieval through a standard protocol; neither identifiers nor protocols are named in the source. No implementation evidence is supplied." .

