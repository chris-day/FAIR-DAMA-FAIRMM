    align:rationale """Identify Reference Data Sources and Contributors (P) [source: ReferenceMasterDataManagement!A3:F3] — Deliverable: Description and Assessment of Sources and Contributors.
Explicit partial support: descriptions of sources and contributors capture origin and responsibility relevant to provenance; association with specific data/metadata and transformation history are still needed. No implementation evidence is supplied.""" ;
    align:sourceCoordinate "ReferenceMasterDataManagement!A3:L3" ;
    align:sourceLayer "workbook_activity_table" ;
    align:targetsPrinciple fair:R1.2 .

align:WB-ACT-06-006-direct-I3 a owl:NamedIndividual,
        align:SourceAssertion ;
    dcterms:identifier "WB-ACT-06-006-direct-I3" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#ReferenceMasterDataManagement!A7:L7> ;
    align:existingContributionType "Direct" ;
    align:hasPractice align:ACT-06-006 ;
    align:inSourceTopic align:AREA-06 ;
    align:originalContributionType "Direct" ;
    align:primarySource <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#ReferenceMasterDataManagement!A7:L7> ;
    align:rationale """Establish Golden Records (C) [source: ReferenceMasterDataManagement!A7:F7] — Deliverable: Reliable Reference and Master Data,
Cross-Reference Data,
Data Lineage Reports,
Data Quality Reports.
Explicit partial support for R1.2: Data Lineage Reports can record origins and changes. Inferred support for I3: Cross-Reference Data can become typed references to identified resources; reliable golden records alone do not establish FAIRness. No implementation evidence is supplied.""" ;
    align:sourceCoordinate "ReferenceMasterDataManagement!A7:L7" ;
    align:sourceLayer "workbook_activity_table" ;
    align:targetsPrinciple fair:I3 .

