    rdfs:label "FAIR principles supported"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L756> ;
    ns1:fieldHeading "FAIR principles supported" ;
    ns1:sourcePosition 8 ;
    ns1:sourceText "I1 — formal, accessible, shared knowledge representation; I2 — use of vocabularies that follow FAIR principles; R1.3 — domain-relevant community standards" .

ns1:ACT-02-007-field-9 a owl:NamedIndividual,
        ns1:SourceField ;
    rdfs:label "How they can support FAIR"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L756> ;
    ns1:fieldHeading "How they can support FAIR" ;
    ns1:sourcePosition 9 ;
    ns1:sourceText "Define and Maintain Enterprise Ontologies, Taxonomies and Namespaces (P) \\[source: DataArchitectureManagement!A8:F8\\] — Deliverable: Enterprise Taxonomies, Industry Ontologies, ISO TC/68 alignment,  XML Namespaces,  Content Management Standards.; Inferred support: industry ontologies, taxonomies and XML namespaces can underpin formal representation and FAIR vocabulary use. ISO TC/68 alignment and content-management standards may support R1.3 where relevant to the domain community; no particular standard/version or conformance evidence is supplied. No implementation evidence is supplied." .

