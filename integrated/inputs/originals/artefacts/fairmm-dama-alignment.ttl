align:ACT-02-005-field-9 a owl:NamedIndividual,
        align:SourceField ;
    rdfs:label "How they can support FAIR"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L754> ;
    align:fieldHeading "How they can support FAIR" ;
    align:sourcePosition 9 ;
    align:sourceText "Define and Maintain the Data Integration Architecture (P)  \\[source: DataArchitectureManagement!A6:F6\\] — Deliverable: Data Integration Architecture Data Lineage / Flows Entity Lifecycles.; Explicit partial support for R1.2: named Data Lineage/Flows and Entity Lifecycles can document origins and changes. Inferred support for I3: flows can be typed references between identifiable resources when implemented. No implementation evidence is supplied." .

