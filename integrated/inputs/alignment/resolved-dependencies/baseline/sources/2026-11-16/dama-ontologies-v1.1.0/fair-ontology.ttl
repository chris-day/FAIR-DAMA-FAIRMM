<http://semanticscience.org/resource/000090> a owl:Class ;
    rdfs:label "specification"@en .

<https://w3id.org/fair/principles/terms/A> a owl:NamedIndividual,
        <https://w3id.org/fair/principles/terms/FAIR-Principle> ;
    rdfs:label "Accessible"@en ;
    dcterms:hasPart <https://w3id.org/fair/principles/terms/A1>,
        <https://w3id.org/fair/principles/terms/A2> ;
    rdfs:isDefinedBy <https://w3id.org/fair/principles/latest/A> .

<https://w3id.org/fair/principles/terms/A1> a owl:NamedIndividual,
        <https://w3id.org/fair/principles/terms/FAIR-SubPrinciple> ;
    rdfs:label "A1"@en ;
    dcterms:hasPart <https://w3id.org/fair/principles/terms/A1.1>,
        <https://w3id.org/fair/principles/terms/A1.2> ;
    rdfs:isDefinedBy <https://w3id.org/fair/principles/latest/A1> ;
    skos:definition "(meta)data are retrievable by their identifier using a standardized communications protocol"@en .

<https://w3id.org/fair/principles/terms/A1.1> a owl:NamedIndividual,
        <https://w3id.org/fair/principles/terms/FAIR-SubPrinciple> ;
    rdfs:label "A1.1"@en ;
    rdfs:isDefinedBy <https://w3id.org/fair/principles/latest/A1.1> ;
    skos:definition "the protocol is open, free, and universally implementable"@en .

<https://w3id.org/fair/principles/terms/A1.2> a owl:NamedIndividual,
        <https://w3id.org/fair/principles/terms/FAIR-SubPrinciple> ;
    rdfs:label "A1.2"@en ;
    rdfs:isDefinedBy <https://w3id.org/fair/principles/latest/A1.2> ;
    skos:definition "the protocol allows for an authentication and authorization procedure, where necessary"@en .

<https://w3id.org/fair/principles/terms/A2> a owl:NamedIndividual,
        <https://w3id.org/fair/principles/terms/FAIR-SubPrinciple> ;
    rdfs:label "A2"@en ;
    rdfs:isDefinedBy <https://w3id.org/fair/principles/latest/A2> ;
    skos:definition "metadata are accessible, even when the data are no longer available"@en .

<https://w3id.org/fair/principles/terms/F> a owl:NamedIndividual,
        <https://w3id.org/fair/principles/terms/FAIR-Principle> ;
    rdfs:label "Findable"@en ;
    dcterms:hasPart <https://w3id.org/fair/principles/terms/F1>,
        <https://w3id.org/fair/principles/terms/F2>,
        <https://w3id.org/fair/principles/terms/F3>,
        <https://w3id.org/fair/principles/terms/F4> ;
    rdfs:isDefinedBy <https://w3id.org/fair/principles/latest/F> .

<https://w3id.org/fair/principles/terms/F1> a owl:NamedIndividual,
        <https://w3id.org/fair/principles/terms/FAIR-SubPrinciple> ;
    rdfs:label "F1"@en ;
    rdfs:isDefinedBy <https://w3id.org/fair/principles/latest/F1> ;
    skos:definition "(meta)data are assigned a globally unique and persistent identifier"@en .

<https://w3id.org/fair/principles/terms/F2> a owl:NamedIndividual,
        <https://w3id.org/fair/principles/terms/FAIR-SubPrinciple> ;
    rdfs:label "F2"@en ;
    rdfs:isDefinedBy <https://w3id.org/fair/principles/latest/F2> ;
    skos:definition "data are described with rich metadata (defined by R1 below)"@en .

<https://w3id.org/fair/principles/terms/F3> a owl:NamedIndividual,
        <https://w3id.org/fair/principles/terms/FAIR-SubPrinciple> ;
    rdfs:label "F3"@en ;
    rdfs:isDefinedBy <https://w3id.org/fair/principles/latest/F3> ;
    skos:definition "metadata clearly and explicitly include the identifier of the data it describes"@en .

<https://w3id.org/fair/principles/terms/F4> a owl:NamedIndividual,
        <https://w3id.org/fair/principles/terms/FAIR-SubPrinciple> ;
    rdfs:label "F4"@en ;
    rdfs:isDefinedBy <https://w3id.org/fair/principles/latest/F4> ;
    skos:definition "(meta)data are registered or indexed in a searchable resource"@en .

<https://w3id.org/fair/principles/terms/FAIR-Principle-or-SubPrinciple> a owl:Class ;
    rdfs:label "FAIR Principle or Sub-Principle"@en ;
    dcterms:partOf <https://w3id.org/fair/principles/terms/FAIR> ;
    rdfs:isDefinedBy <https://w3id.org/fair/principles/latest/FAIR-Principle-or-SubPrinciple> ;
    skos:definition "Either a FAIR principle or one of its sub-principles."@en .

<https://w3id.org/fair/principles/terms/I> a owl:NamedIndividual,
        <https://w3id.org/fair/principles/terms/FAIR-Principle> ;
    rdfs:label "Interoperable"@en ;
    dcterms:hasPart <https://w3id.org/fair/principles/terms/I1>,
        <https://w3id.org/fair/principles/terms/I2>,
        <https://w3id.org/fair/principles/terms/I3> ;
    rdfs:isDefinedBy <https://w3id.org/fair/principles/latest/I> .

<https://w3id.org/fair/principles/terms/I1> a owl:NamedIndividual,
        <https://w3id.org/fair/principles/terms/FAIR-SubPrinciple> ;
    rdfs:label "I1"@en ;
    rdfs:isDefinedBy <https://w3id.org/fair/principles/latest/I1> ;
    skos:definition "(meta)data use a formal, accessible, shared, and broadly applicable language for knowledge representation"@en .

<https://w3id.org/fair/principles/terms/I2> a owl:NamedIndividual,
        <https://w3id.org/fair/principles/terms/FAIR-SubPrinciple> ;
    rdfs:label "I2"@en ;
    rdfs:isDefinedBy <https://w3id.org/fair/principles/latest/I2> ;
    skos:definition "(meta)data use vocabularies that follow FAIR principles"@en .

<https://w3id.org/fair/principles/terms/I3> a owl:NamedIndividual,
        <https://w3id.org/fair/principles/terms/FAIR-SubPrinciple> ;
    rdfs:label "I3"@en ;
    rdfs:isDefinedBy <https://w3id.org/fair/principles/latest/I3> ;
    skos:definition "(meta)data include qualified references to other (meta)data"@en .

<https://w3id.org/fair/principles/terms/R> a owl:NamedIndividual,
        <https://w3id.org/fair/principles/terms/FAIR-Principle> ;
    rdfs:label "Reusable"@en ;
    dcterms:hasPart <https://w3id.org/fair/principles/terms/R1> ;
    rdfs:isDefinedBy <https://w3id.org/fair/principles/latest/R> .

<https://w3id.org/fair/principles/terms/R1> a owl:NamedIndividual,
        <https://w3id.org/fair/principles/terms/FAIR-SubPrinciple> ;
    rdfs:label "R1"@en ;
    dcterms:hasPart <https://w3id.org/fair/principles/terms/R1.1>,
        <https://w3id.org/fair/principles/terms/R1.2>,
        <https://w3id.org/fair/principles/terms/R1.3> ;
    rdfs:isDefinedBy <https://w3id.org/fair/principles/latest/R1> ;
    skos:definition "meta(data) are richly described with a plurality of accurate and relevant attributes"@en .

<https://w3id.org/fair/principles/terms/R1.1> a owl:NamedIndividual,
        <https://w3id.org/fair/principles/terms/FAIR-SubPrinciple> ;
    rdfs:label "R1.1"@en ;
    rdfs:isDefinedBy <https://w3id.org/fair/principles/latest/R1.1> ;
    skos:definition "(meta)data are released with a clear and accessible data usage license"@en .

<https://w3id.org/fair/principles/terms/R1.2> a owl:NamedIndividual,
        <https://w3id.org/fair/principles/terms/FAIR-SubPrinciple> ;
    rdfs:label "R1.2"@en ;
    rdfs:isDefinedBy <https://w3id.org/fair/principles/latest/R1.2> ;
    skos:definition "(meta)data are associated with detailed provenance"@en .

<https://w3id.org/fair/principles/terms/R1.3> a owl:NamedIndividual,
        <https://w3id.org/fair/principles/terms/FAIR-SubPrinciple> ;
    rdfs:label "R1.3"@en ;
    rdfs:isDefinedBy <https://w3id.org/fair/principles/latest/R1.3> ;
    skos:definition "(meta)data meet domain-relevant community standards"@en .

<https://w3id.org/fair/principles/terms/FAIR> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "FAIR principles"@en ;
    dcterms:hasPart <https://w3id.org/fair/principles/terms/A>,
        <https://w3id.org/fair/principles/terms/F>,
        <https://w3id.org/fair/principles/terms/I>,
        <https://w3id.org/fair/principles/terms/R> ;
    rdfs:isDefinedBy <https://w3id.org/fair/principles/latest/FAIR> ;
    rdfs:seeAlso <https://www.dtls.nl/fair-data/fair-principles-explained/> ;
    rdfs:subClassOf <http://semanticscience.org/resource/000090> .

<https://w3id.org/fair/principles/terms/FAIR-Principle> a owl:Class ;
    rdfs:label "FAIR Principle"@en ;
    dcterms:partOf <https://w3id.org/fair/principles/terms/FAIR> ;
    rdfs:isDefinedBy <https://w3id.org/fair/principles/latest/FAIR-Principle> ;
    rdfs:subClassOf <https://w3id.org/fair/principles/terms/FAIR-Principle-or-SubPrinciple> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/fair/principles/terms/A> <https://w3id.org/fair/principles/terms/F> <https://w3id.org/fair/principles/terms/I> <https://w3id.org/fair/principles/terms/R> ) ] ;
    skos:definition "A FAIR principle describes an essential aspect of FAIR."@en .

<https://w3id.org/fair/principles/terms/FAIR-SubPrinciple> a owl:Class ;
    rdfs:label "FAIR SubPrinciple"@en ;
    dcterms:partOf <https://w3id.org/fair/principles/terms/FAIR> ;
    rdfs:isDefinedBy <https://w3id.org/fair/principles/latest/FAIR-SubPrinciple> ;
    rdfs:subClassOf <https://w3id.org/fair/principles/terms/FAIR-Principle-or-SubPrinciple> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/fair/principles/terms/A1> <https://w3id.org/fair/principles/terms/A1.1> <https://w3id.org/fair/principles/terms/A1.2> <https://w3id.org/fair/principles/terms/A2> <https://w3id.org/fair/principles/terms/F1> <https://w3id.org/fair/principles/terms/F2> <https://w3id.org/fair/principles/terms/F3> <https://w3id.org/fair/principles/terms/F4> <https://w3id.org/fair/principles/terms/I1> <https://w3id.org/fair/principles/terms/I2> <https://w3id.org/fair/principles/terms/I3> <https://w3id.org/fair/principles/terms/R1> <https://w3id.org/fair/principles/terms/R1.1> <https://w3id.org/fair/principles/terms/R1.2> <https://w3id.org/fair/principles/terms/R1.3> ) ] ;
    skos:definition "A sub-principle of a FAIR principle."@en .

