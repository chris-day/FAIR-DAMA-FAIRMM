ns1:evidence-71b168be10b05b7bd6abea5c a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L110> ;
    ns1:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L110> ;
    ns1:rationale "The named deliverable may address the D3 aspect of these clauses when its applicability condition is met." ;
    ns1:sourceText "There is a clear understanding of why making data FAIR adds value; this may extend beyond a given corporate function or domain. This value-adding process begins to be tracked or monitored. Strategies begin to encompass enterprise-level dimensions." ;
    ns1:supportedByDescriptor ns1:D3-L3 ;
    ns1:supportsInterpretation ns1:interpretation-edc850a6481f9378eb0c5441 .

