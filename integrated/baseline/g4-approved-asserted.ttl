    ns1:inSourceTopic ns1:AREA-13 ;
    ns1:originalContributionType "Indirect" ;
    ns1:primarySource <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/dama-ontologies-v1.1.0/dama-fair-mapping.ttl> ;
    ns1:rationale "Ingestion can capture resource descriptions, source versions, acquisition times and transformations if metadata capture is added as an explicit requirement." ;
    ns1:sourceIntermediatePractice ns4:PublishRichDiscoveryMetadata ;
    ns1:sourceLayer "ontology_contribution" ;
    ns1:targetsPrinciple <https://w3id.org/fair/principles/terms/F2> .

