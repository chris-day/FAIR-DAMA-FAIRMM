    align:rationale "Build and Test Data Access Services (D) \\[source: DataDevelopment!A17:F17\\] — Deliverable: Data Access Services,(interfaces).; Inferred support: built and tested data access services can implement retrieval by identifier using a standard protocol; interface existence and generic service tests are insufficient. No implementation evidence is supplied." ;
    align:sourceCoordinate "DataModelingDesign!A17:L17" ;
    align:sourceLayer "activity_table" ;
    align:targetsPrinciple fair:A1 .

align:ACT-04-004-indirect-A2 a owl:NamedIndividual,
        align:SourceAssertion ;
    dcterms:identifier "ACT-04-004-indirect-A2" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1041> ;
    align:existingContributionType "Indirect" ;
    align:hasPractice align:ACT-04-004 ;
    align:inSourceTopic align:AREA-04 ;
    align:originalContributionType "Indirect" ;
    align:primarySource <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1041> ;
    align:rationale "Indirect support: Operations, availability and change management can sustain FAIR infrastructure where the relevant services are commissioned. Recovery, retention or archives can support availability. A2 additionally requires accessible metadata after the associated data cease to be available; this is not specified." ;
    align:sourceCoordinate "DataOperationsManagement!A5:L5" ;
    align:sourceIntermediatePractice align:practice-2df1e2b53d6e636c66823938 ;
    align:sourceLayer "activity_table" ;
    align:targetsPrinciple fair:A2 .

align:ACT-05-008-indirect-A1.2 a owl:NamedIndividual,
        align:SourceAssertion ;
    dcterms:identifier "ACT-05-008-indirect-A1.2" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1178> ;
    align:existingContributionType "Indirect" ;
    align:hasPractice align:ACT-05-008 ;
    align:inSourceTopic align:AREA-05 ;
    align:originalContributionType "Indirect" ;
    align:primarySource <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1178> ;
    align:rationale "Indirect support: Security governance and classification can determine legitimate access conditions and oversee their operation. Security controls must be incorporated into the retrieval protocol to fulfil A1.2; source confidentiality does not imply a FAIR accessibility result." ;
    align:sourceCoordinate "DataSecurityManagement!A9:L9" ;
    align:sourceIntermediatePractice align:practice-5048b9cb33558af92342eec5 ;
    align:sourceLayer "activity_table" ;
    align:targetsPrinciple fair:A1.2 .

