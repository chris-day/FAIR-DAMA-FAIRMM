align:evidence-c0c0625ffb9c568a9fb5ea5c a owl:NamedIndividual,
        align:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L123> ;
    align:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    align:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L123> ;
    align:rationale "The named deliverable may address the D4 aspect of these clauses when its applicability condition is met." ;
    align:sourceText "Emerging personas include:  [Data_Steward](FAIR_personas/Data_Steward.md), [Curator](FAIR_personas/Curator.md), [Data_Standards_and_Governance_Expert](FAIR_personas/Data_Standards_and_Governance_Expert.md) , [Data_Integration_Specialist](FAIR_personas/Data_Integration_Specialist.md) with semantic expertise may be brought in. [Data_Strategy_Owner](FAIR_personas/Data_Strategy_Owner.md), [Data_Owner](FAIR_personas/Data_Owner.md) are engaging in the FAIR data transition. Further [FAIR_Community_Manager](FAIR_personas/FAIR_Community_Manager.md) may begin to appear." ;
    align:supportedByDescriptor align:D4-L2 ;
    align:supportsInterpretation align:interpretation-c9b19eb0329ae7df3cb9feed .

align:evidence-c1722c959f6fdd82f0738490 a owl:NamedIndividual,
        align:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L79> ;
    align:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
