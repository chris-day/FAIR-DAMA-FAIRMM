@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:creator a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:hasPart a owl:ObjectProperty .

dcterms:identifier a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:modified a owl:AnnotationProperty .

dcterms:partOf a owl:AnnotationProperty .

dcterms:rights a owl:AnnotationProperty .

dcterms:source a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

<http://semanticscience.org/resource/000090> a owl:Class .

skos:definition a owl:AnnotationProperty .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl> a owl:Ontology ;
    dcterms:creator <https://orcid.org/0000-0001-5095-7052> ;
    dcterms:modified "2026-11-16"^^xsd:date ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA_Segments_High_Level_v1.18.0.md>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl>,
        <https://w3id.org/fair/principles/terms/FAIR-Vocabulary> ;
    dcterms:title "DAMA to FAIR Contribution Ontology"@en ;
    owl:versionInfo "1.1.0" .

ns1:AssignProvenanceResponsibilityToR1_2 a owl:NamedIndividual,
        ns1:IndirectContribution ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#DataGovernance>,
        <https://w3id.org/fair/principles/terms/R1.2> ;
    ns1:fromPractice ns1:AssignProvenanceResponsibility ;
    ns1:rationale "Assigning responsibility enables the publication of detailed dataset provenance."@en ;
    ns1:targetsPrinciple <https://w3id.org/fair/principles/terms/R1.2> ;
    ns1:viaPractice ns1:PublishProvenance .

ns1:AttachUsageLicenseToR1_1 a owl:NamedIndividual,
        ns1:DirectContribution ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#MetadataManagement>,
        <https://w3id.org/fair/principles/terms/R1.1> ;
    ns1:applicabilityCondition "The license applies to the resource and is clear and accessible."@en ;
    ns1:fromPractice ns1:AttachUsageLicense ;
    ns1:rationale "The published license states the terms under which the data or metadata may be used."@en ;
    ns1:targetsPrinciple <https://w3id.org/fair/principles/terms/R1.1> .

ns1:ConfigureRetrievalAuthorizationToA1_2 a owl:NamedIndividual,
        ns1:DirectContribution ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#DataSecurity>,
        <https://w3id.org/fair/principles/terms/A1.2> ;
    ns1:applicabilityCondition "Access control is needed and the retrieval protocol supports both authentication and authorization."@en ;
    ns1:fromPractice ns1:ConfigureRetrievalAuthorization ;
    ns1:rationale "The retrieval configuration provides evidence that the protocol supports authentication and authorization."@en ;
    ns1:targetsPrinciple <https://w3id.org/fair/principles/terms/A1.2> .

ns1:IncludeDatasetIdentifierToF3 a owl:NamedIndividual,
        ns1:DirectContribution ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#MetadataManagement>,
        <https://w3id.org/fair/principles/terms/F3> ;
    ns1:applicabilityCondition "The identifier in the metadata is the identifier of the described data."@en ;
    ns1:fromPractice ns1:IncludeDatasetIdentifier ;
    ns1:rationale "The metadata record explicitly identifies the data it describes."@en ;
    ns1:targetsPrinciple <https://w3id.org/fair/principles/terms/F3> .

ns1:IndexInSearchableCatalogToF4 a owl:NamedIndividual,
        ns1:DirectContribution ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#MetadataManagement>,
        <https://w3id.org/fair/principles/terms/F4> ;
    ns1:applicabilityCondition "The catalog is searchable and contains an index entry for the relevant data or metadata."@en ;
    ns1:fromPractice ns1:IndexInSearchableCatalog ;
    ns1:rationale "A searchable catalog entry provides evidence that the data or metadata have been indexed."@en ;
    ns1:targetsPrinciple <https://w3id.org/fair/principles/terms/F4> .

ns1:PublishProvenanceToR1_2 a owl:NamedIndividual,
        ns1:DirectContribution ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#MetadataManagement>,
        <https://w3id.org/fair/principles/terms/R1.2> ;
    ns1:applicabilityCondition "Detailed provenance is associated with the data or metadata."@en ;
    ns1:fromPractice ns1:PublishProvenance ;
    ns1:rationale "The provenance record provides evidence about the origins and history of the data."@en ;
    ns1:targetsPrinciple <https://w3id.org/fair/principles/terms/R1.2> .

ns1:PublishSharedRepresentationToI1 a owl:NamedIndividual,
        ns1:DirectContribution ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#DataIntegrationAndInteroperability>,
        <https://w3id.org/fair/principles/terms/I1> ;
    ns1:applicabilityCondition "The language is formal, accessible, shared and broadly applicable."@en ;
    ns1:fromPractice ns1:PublishSharedRepresentation ;
    ns1:rationale "The published representation provides evidence of the knowledge representation language used."@en ;
    ns1:targetsPrinciple <https://w3id.org/fair/principles/terms/I1> .

ns1:SetDataSecurityPolicyToA1_2 a owl:NamedIndividual,
        ns1:IndirectContribution ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#DataSecurity>,
        <https://w3id.org/fair/principles/terms/A1.2> ;
    ns1:applicabilityCondition "The policy applies to the retrieval service and calls for authentication and authorization where needed."@en ;
    ns1:fromPractice ns1:SetDataSecurityPolicy ;
    ns1:rationale "The policy drives the configuration of authentication and authorization for data or metadata retrieval."@en ;
    ns1:targetsPrinciple <https://w3id.org/fair/principles/terms/A1.2> ;
    ns1:viaPractice ns1:ConfigureRetrievalAuthorization .

ns1:SetLicensingPolicyToR1_1 a owl:NamedIndividual,
        ns1:IndirectContribution ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#DataGovernance>,
        <https://w3id.org/fair/principles/terms/R1.1> ;
    ns1:fromPractice ns1:SetLicensingPolicy ;
    ns1:rationale "The policy enables a publishing practice that attaches the applicable usage license."@en ;
    ns1:targetsPrinciple <https://w3id.org/fair/principles/terms/R1.1> ;
    ns1:viaPractice ns1:AttachUsageLicense .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/DataHandlingEthics/row-6> a owl:NamedIndividual,
        ns1:SourceActivity ;
    rdfs:label "Execute the Training and Communications Plan"@en ;
    dcterms:identifier "DataHandlingEthics!A6:L6" ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/assets/01_DataHandlingEthics.webp>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/outputs/dama-20261116/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#DataHandlingEthics!A6:L6> ;
    ns1:alignmentBasis "Activity-derived proposal; source image plus interpreted associations"@en ;
    ns1:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns1:deliverables "Communication Plan; Ethics Training Program; Awareness to Ethical Data Issues"@en ;
    ns1:directSupportExplanation "No direct FAIR requirement is established by this ethical-practice activity or its named deliverables. Ethical responsibility and FAIR fulfilment are related but distinct."@en ;
    ns1:evidenceRequirement "Inspect training objectives, materials and attendance as process evidence. Before assigning any FAIR ID, identify explicit FAIR requirements taught and separately test their implementation on resources. Training completion alone does not demonstrate FAIR fulfilment."@en ;
    ns1:inTopic <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#DataHandlingEthics> ;
    ns1:indirectSupportExplanation "Training and communications can improve ethical behavior and awareness, but the image supplies no principle-specific training content."@en ;
    ns1:lifecycleCode "D"@en ;
    ns1:proposedApprovingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-governance-bodies> ;
    ns1:proposedContributingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/coordinating-data-stewards>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/employees>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/executives>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/subject-matter-experts> ;
    ns1:proposedResponsiblePersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/change-managers>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/dm-services> ;
    ns1:relevantDeliverables "Communication Plan; Ethics Training Program; Awareness to Ethical Data Issues"@en ;
    ns1:sourceRow 6 ;
    ns1:sourceWorksheet "DataHandlingEthics" .

ns1:alignedPrinciple a owl:ObjectProperty ;
    rdfs:label "aligned FAIR principle"@en ;
    rdfs:domain ns1:AreaAlignmentAssessment ;
    rdfs:range <https://w3id.org/fair/principles/terms/FAIR-SubPrinciple> .

ns1:alignmentBasis a owl:AnnotationProperty ;
    rdfs:label "alignment basis"@en .

ns1:alignmentType a owl:AnnotationProperty ;
    rdfs:label "alignment type"@en .

ns1:applicabilityCondition a owl:AnnotationProperty .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#area-alignment/big-data-data-science/direct/R1> a owl:NamedIndividual,
        ns1:AreaAlignmentAssessment ;
    rdfs:label "Big Data & Data Science → R1 (Direct)"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA_FAIR_Sankey_v1.3.0.zip> ;
    ns1:alignedPrinciple <https://w3id.org/fair/principles/terms/R1> ;
    ns1:alignmentBasis "Activity-derived proposal (additional topic)"@en ;
    ns1:alignmentType "Direct" ;
    ns1:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns1:deliverables "Data Analysis and Hypotheses"@en ;
    ns1:derivedFromActivity <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-6> ;
    ns1:fromTopic <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#BigDataAndDataScience> ;
    ns1:rationale "Inferred potential direct support: documented hypotheses and methods can supply accurate, relevant methodological context for reusing the associated analytical data. The diagram does not establish that these descriptions are complete or associated with identifiable resources."@en .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#area-alignment/big-data-data-science/indirect/A1> a owl:NamedIndividual,
        ns1:AreaAlignmentAssessment ;
    rdfs:label "Big Data & Data Science → A1 (Indirect)"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA_FAIR_Sankey_v1.3.0.zip> ;
    ns1:alignedPrinciple <https://w3id.org/fair/principles/terms/A1> ;
    ns1:alignmentBasis "Activity-derived proposal (additional topic)"@en ;
    ns1:alignmentType "Indirect" ;
    ns1:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns1:deliverables "Big Data Landscape; Operations Plan; Model Performance; Model Enhancement Plan"@en ;
    ns1:derivedFromActivity <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-10>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-3> ;
    ns1:fromTopic <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#BigDataAndDataScience> ;
    ns1:rationale "Platform design can enable standardized retrieval, open protocols and controlled access if these are explicitly commissioned and implemented. Operations can sustain identifier-based access and record versioned inputs, model changes and execution history when those controls are explicitly included in the operations plan."@en .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#area-alignment/big-data-data-science/indirect/A1.1> a owl:NamedIndividual,
