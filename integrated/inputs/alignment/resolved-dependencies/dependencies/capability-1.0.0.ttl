<urn:capability-ontology:ontology> a owl:Ontology ;
    dcterms:description "Domain-neutral functional abilities, requirements, profiles and contextual realisations. A potential capability is not evidence of implementation."@en ;
    dcterms:title "Capability ontology"@en ;
    owl:versionIRI <urn:capability-ontology:ontology:version:1.0.0> ;
    owl:versionInfo "1.0.0" .

<urn:capability-ontology:rationale> a owl:AnnotationProperty ;
    rdfs:range xsd:string .

<urn:capability-ontology:realisesCapability> a owl:ObjectProperty ;
    rdfs:domain <urn:capability-ontology:Realisation> ;
    rdfs:range <urn:capability-ontology:Capability> .

<urn:capability-ontology:requiresCapability> a owl:ObjectProperty ;
    rdfs:domain <urn:capability-ontology:Requirement> ;
    rdfs:range <urn:capability-ontology:Capability> .

<urn:capability-ontology:requiresCondition> a owl:ObjectProperty ;
    rdfs:range <urn:capability-ontology:ImplementationCondition> .

<urn:capability-ontology:verificationState> a owl:ObjectProperty ;
    rdfs:domain <urn:capability-ontology:Realisation> ;
    rdfs:range <urn:capability-ontology:VerificationState> .

