ns2:Producer a owl:NamedIndividual,
        ns2:DataRole ;
    rdfs:label "Producer"@en ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/FAIR_roles/Data_Producer.md> ;
    skos:definition "A person, team, or system that creates or collects data. Ensuring the data, and its accompanying metadata, is sufficiently documented to comply with FAIR data princinples is an important element of this role." ;
    ns2:inFrameworkVersion ns2:FAIRMM-v1.2.5 .

ns2:Consumer a owl:NamedIndividual,
        ns2:DataRole ;
    rdfs:label "Consumer"@en ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/FAIR_roles/Data_Consumer.md> ;
    skos:definition "A person, team, or application that finds, accesses, and uses data (and metadata) for analysis, decision-making, or building downstream products, relying on FAIR practices to make data discoverable, understandable, and reusable." ;
    ns2:inFrameworkVersion ns2:FAIRMM-v1.2.5 .

ns2:Enabler a owl:NamedIndividual,
        ns2:DataRole ;
    rdfs:label "Enabler"@en ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/FAIR_roles/Data_Enabler.md> ;
    skos:definition "A role (or set of roles) that enables FAIRness at scale by guiding teams and providing the practices, standards, tooling, and support needed so data remains FAIR across planning, creation, publication/sharing, and long-term maintenance." ;
    ns2:inFrameworkVersion ns2:FAIRMM-v1.2.5 .

