    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#ReferenceMasterDataManagement!A7:L7> ;
    ns1:existingContributionType "Direct" ;
    ns1:hasPractice ns1:ACT-06-006 ;
    ns1:inSourceTopic ns1:AREA-06 ;
    ns1:originalContributionType "Direct" ;
    ns1:primarySource <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#ReferenceMasterDataManagement!A7:L7> ;
    ns1:rationale """Establish Golden Records (C) [source: ReferenceMasterDataManagement!A7:F7] — Deliverable: Reliable Reference and Master Data,
Cross-Reference Data,
Data Lineage Reports,
Data Quality Reports.
Explicit partial support for R1.2: Data Lineage Reports can record origins and changes. Inferred support for I3: Cross-Reference Data can become typed references to identified resources; reliable golden records alone do not establish FAIRness. No implementation evidence is supplied.""" ;
    ns1:sourceCoordinate "ReferenceMasterDataManagement!A7:L7" ;
    ns1:sourceLayer "workbook_activity_table" ;
    ns1:targetsPrinciple <https://w3id.org/fair/principles/terms/R1.2> .

