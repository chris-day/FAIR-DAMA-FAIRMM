    ns1:rationale "Platform design can enable standardized retrieval, open protocols and controlled access if these are explicitly commissioned and implemented." ;
    ns1:sourceIntermediatePractice ns4:EnableIdentifierBasedRetrieval ;
    ns1:sourceLayer "ontology_contribution" ;
    ns1:targetsPrinciple <https://w3id.org/fair/principles/terms/A1> .

