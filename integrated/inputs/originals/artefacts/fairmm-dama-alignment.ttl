    align:primarySource <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1579> ;
    align:rationale "Indirect support: Records governance and lifecycle management can sustain content descriptions, controlled access and preservation commitments. Backups and archives are not proof of A2. Commission independent metadata retention and test access after content withdrawal." ;
    align:sourceCoordinate "DocumentContentManagement!A4:L4" ;
    align:sourceIntermediatePractice align:practice-2df1e2b53d6e636c66823938 ;
    align:sourceLayer "activity_table" ;
    align:targetsPrinciple fair:A2 .

