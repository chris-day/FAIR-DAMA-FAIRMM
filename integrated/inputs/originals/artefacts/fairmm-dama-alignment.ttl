align:evidence-07ed3df98b5caea67fea60a0 a owl:NamedIndividual,
        align:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L140> ;
    align:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    align:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L140> ;
    align:rationale "The named deliverable may address the A1.1 aspect of these clauses when its applicability condition is met." ;
    align:sourceText "Governance: recognize the need for governance processes related to FAIR principles and the processes for FAIR (e.g. master and reference data, consideration of dimensions for FAIR, RDMs )." ;
    align:supportedByDescriptor align:D5-L2 ;
    align:supportsInterpretation align:interpretation-4384047e3f146ad444d71a7b .

align:evidence-088f6f2a34d3474ccd5d0bc3 a owl:NamedIndividual,
        align:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L158> ;
    align:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    align:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L158> ;
    align:rationale "The named deliverable may address the A1.1 aspect of these clauses when its applicability condition is met." ;
    align:sourceText "The FAIR data training is part of employee onboarding and continuous education development. The organization tailors specific FAIR processes to suit its needs and incorporates guidelines for providing FAIR data into standard IT procedures. Efforts to make metadata implementation accessible in a standardized manner without changing existing processes. The organization begins to integrate FAIR practices into workflows and configure systems to facilitate FAIR practices, demonstrating a commitment to normalising FAIR standards within organizational operations." ;
    align:supportedByDescriptor align:D5-L3 ;
    align:supportsInterpretation align:interpretation-932dbc1a8b10d3ceebc2ba35 .

align:evidence-092360af03bd1ab4c23a1f48 a owl:NamedIndividual,
        align:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L158> ;
    align:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    align:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L158> ;
    align:rationale "The named deliverable may address the I2 aspect of these clauses when its applicability condition is met." ;
    align:sourceText "The organization initiates formal training for FAIR roles while a majority have embraced FAIR principles for major resources, backed by well-trained personnel capable of evaluating and implementing FAIR standards. At least one business unit actively employs FAIR processes in production, supported by documentation and training, with other FAIR initiatives underway and coordinated efforts recognized." ;
    align:supportedByDescriptor align:D5-L3 ;
    align:supportsInterpretation align:interpretation-1a2d079850b0c00084008444 .

align:evidence-0d68a7aab199d642b5c51bba a owl:NamedIndividual,
        align:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level5.md#L138> ;
    align:matchingPhrase "planned processes to maintain FAIR implementation standards and tools" ;
    align:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level5.md#L138> ;
    align:sourceText "There are planned processes to maintain FAIR implementation standards and tools (e.g., CV, ontologies) at the company and across data ecosystem partners." ;
    align:supportedByDescriptor align:D5-L5 .

align:evidence-2fc75df3c1688a2f2a584407 a owl:NamedIndividual,
        align:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L158> ;
    align:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    align:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L158> ;
    align:rationale "The named deliverable may address the I2 aspect of these clauses when its applicability condition is met." ;
    align:sourceText "The FAIR data training is part of employee onboarding and continuous education development. The organization tailors specific FAIR processes to suit its needs and incorporates guidelines for providing FAIR data into standard IT procedures. Efforts to make metadata implementation accessible in a standardized manner without changing existing processes. The organization begins to integrate FAIR practices into workflows and configure systems to facilitate FAIR practices, demonstrating a commitment to normalising FAIR standards within organizational operations." ;
    align:supportedByDescriptor align:D5-L3 ;
    align:supportsInterpretation align:interpretation-1a2d079850b0c00084008444 .

align:evidence-3057c692182663b16b77fc7d a owl:NamedIndividual,
        align:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L140> ;
    align:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    align:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L140> ;
    align:rationale "The named deliverable may address the I2 aspect of these clauses when its applicability condition is met." ;
    align:sourceText "Governance processes may have other names. They focus on conflict resolution, reconciliation, and community building." ;
    align:supportedByDescriptor align:D5-L2 ;
    align:supportsInterpretation align:interpretation-108c379d72cf53ccc4ed633c .

align:evidence-6d36c9895756693380b5b984 a owl:NamedIndividual,
        align:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L65> ;
    align:matchingPhrase "conformed to a local model" ;
    align:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L65> ;
    align:sourceText "Data, conformed to a local model, is cataloged (i.e. a metadata record of existence is created), and data resides in a data lake." ;
    align:supportedByDescriptor align:D1-L2 .

align:evidence-7e77bda8652e2c1bef9c0c17 a owl:NamedIndividual,
        align:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L66> ;
    align:matchingPhrase "analytics-ready 'data-marts'" ;
    align:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L66> ;
    align:sourceText "The creation of analytics-ready 'data-marts' enabling self-service analytics is under way." ;
    align:supportedByDescriptor align:D1-L3 .

