<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/DataHandlingEthics/row-4/indirect/A1.2> a owl:NamedIndividual,
        ns4:IndirectContribution ;
    rdfs:label "Create an Ethical Data Handling Strategy → A1.2"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/outputs/dama-20261116/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#DataHandlingEthics!A4:L4> ;
    ns4:alignmentBasis "Activity-derived proposal"@en ;
    ns4:applicabilityCondition "Inspect approved policy or control requirements that explicitly distinguish access authorization from permitted reuse. Test any resulting authentication and authorization procedure for identified resources (A1.2) and inspect the clear, accessible usage licence attached to data and metadata (R1.1). An ethics statement, privacy notice or generic compliance metric alone is insufficient."@en ;
    ns4:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns4:evidenceRequirement "Inspect approved policy or control requirements that explicitly distinguish access authorization from permitted reuse. Test any resulting authentication and authorization procedure for identified resources (A1.2) and inspect the clear, accessible usage licence attached to data and metadata (R1.1). An ethics statement, privacy notice or generic compliance metric alone is insufficient."@en ;
    ns4:fromPractice <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/DataHandlingEthics/row-4> ;
    ns4:rationale "The strategy can commission authentication, authorization and resource-specific usage licensing when those obligations are explicitly stated."@en ;
    ns4:targetsPrinciple <https://w3id.org/fair/principles/terms/A1.2> ;
    ns4:viaPractice ns4:ConfigureRetrievalAuthorization .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/DataHandlingEthics/row-4/indirect/R1.1> a owl:NamedIndividual,
        ns4:IndirectContribution ;
    rdfs:label "Create an Ethical Data Handling Strategy → R1.1"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/outputs/dama-20261116/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#DataHandlingEthics!A4:L4> ;
    ns4:alignmentBasis "Activity-derived proposal"@en ;
    ns4:applicabilityCondition "Inspect approved policy or control requirements that explicitly distinguish access authorization from permitted reuse. Test any resulting authentication and authorization procedure for identified resources (A1.2) and inspect the clear, accessible usage licence attached to data and metadata (R1.1). An ethics statement, privacy notice or generic compliance metric alone is insufficient."@en ;
    ns4:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns4:evidenceRequirement "Inspect approved policy or control requirements that explicitly distinguish access authorization from permitted reuse. Test any resulting authentication and authorization procedure for identified resources (A1.2) and inspect the clear, accessible usage licence attached to data and metadata (R1.1). An ethics statement, privacy notice or generic compliance metric alone is insufficient."@en ;
    ns4:fromPractice <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/DataHandlingEthics/row-4> ;
    ns4:rationale "The strategy can commission authentication, authorization and resource-specific usage licensing when those obligations are explicitly stated."@en ;
    ns4:targetsPrinciple <https://w3id.org/fair/principles/terms/R1.1> ;
    ns4:viaPractice ns4:AttachUsageLicense .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/DataHandlingEthics/row-5/indirect/A1.2> a owl:NamedIndividual,
