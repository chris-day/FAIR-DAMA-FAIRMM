<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#area-alignment/data-handling-ethics/indirect/A1.2> a owl:NamedIndividual,
        ns1:AreaAlignmentAssessment ;
    rdfs:label "Data Handling Ethics → A1.2 (Indirect)"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA_FAIR_Sankey_v1.3.0.zip> ;
    ns1:alignedPrinciple <https://w3id.org/fair/principles/terms/A1.2> ;
    ns1:alignmentBasis "Activity-derived proposal (additional topic)"@en ;
    ns1:alignmentType "Indirect" ;
    ns1:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns1:deliverables "Current Practices and Gaps; Ethical Data Handling Strategy; Ethical Corporate Statements on Data; Updated Policies; Aligned Incentives, KPIs, and Targets; Ethical Data Handling Reporting"@en ;
    ns1:derivedFromActivity <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/DataHandlingEthics/row-2>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/DataHandlingEthics/row-3>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/DataHandlingEthics/row-4>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/DataHandlingEthics/row-5>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/DataHandlingEthics/row-7>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/DataHandlingEthics/row-8> ;
    ns1:fromTopic <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#DataHandlingEthics> ;
    ns1:rationale "Review can identify gaps in authorized access and permitted reuse if the review criteria explicitly include them. Risk assessment can establish requirements for controlled access and clear reuse permissions; neither requirement is specified by the activity label alone. The strategy can commission authentication, authorization and resource-specific usage licensing when those obligations are explicitly stated. Remediation can address gaps in access controls and reuse permissions only where those gaps and the affected resources are identified. Mitigation can commission access-authorization and reuse-permission controls when the ethical risk assessment identifies those specific requirements. Monitoring can sustain explicitly defined authorization and licensing controls. General ethics compliance incidents do not establish a FAIR-specific result."@en .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#area-alignment/data-handling-ethics/indirect/R1.1> a owl:NamedIndividual,
        ns1:AreaAlignmentAssessment ;
    rdfs:label "Data Handling Ethics → R1.1 (Indirect)"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA_FAIR_Sankey_v1.3.0.zip> ;
    ns1:alignedPrinciple <https://w3id.org/fair/principles/terms/R1.1> ;
    ns1:alignmentBasis "Activity-derived proposal (additional topic)"@en ;
    ns1:alignmentType "Indirect" ;
    ns1:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns1:deliverables "Current Practices and Gaps; Ethical Data Handling Strategy; Ethical Corporate Statements on Data; Updated Policies; Aligned Incentives, KPIs, and Targets; Ethical Data Handling Reporting"@en ;
    ns1:derivedFromActivity <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/DataHandlingEthics/row-2>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/DataHandlingEthics/row-3>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/DataHandlingEthics/row-4>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/DataHandlingEthics/row-5>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/DataHandlingEthics/row-7>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/DataHandlingEthics/row-8> ;
    ns1:fromTopic <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#DataHandlingEthics> ;
    ns1:rationale "Review can identify gaps in authorized access and permitted reuse if the review criteria explicitly include them. Risk assessment can establish requirements for controlled access and clear reuse permissions; neither requirement is specified by the activity label alone. The strategy can commission authentication, authorization and resource-specific usage licensing when those obligations are explicitly stated. Remediation can address gaps in access controls and reuse permissions only where those gaps and the affected resources are identified. Mitigation can commission access-authorization and reuse-permission controls when the ethical risk assessment identifies those specific requirements. Monitoring can sustain explicitly defined authorization and licensing controls. General ethics compliance incidents do not establish a FAIR-specific result."@en .

