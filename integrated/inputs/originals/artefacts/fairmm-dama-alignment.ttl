align:ACT-13-005-field-10 a owl:NamedIndividual,
        align:SourceField ;
    rdfs:label "Indirect support"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L2166> ;
    align:fieldHeading "Indirect support" ;
    align:sourcePosition 10 ;
    align:sourceText "Versioned methods and input records can enable provenance when linked to the resulting data and model outputs." .

align:ACT-13-005-field-11 a owl:NamedIndividual,
        align:SourceField ;
    rdfs:label "What would demonstrate the supported FAIR requirement"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L2166> ;
    align:fieldHeading "What would demonstrate the supported FAIR requirement" ;
    align:sourcePosition 11 ;
    align:sourceText "For R1, inspect resource-linked descriptions of hypotheses, methods, assumptions, units, scope and limitations, and verify their accuracy and relevance for reuse. For R1.2, additionally inspect input versions, methods, agents and execution history. An unexplained model or hypothesis list is insufficient." .

