PREFIX align: <urn:fair-dama-fairmm:alignment:>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?areaID ?dimensionID ?kind (COUNT(?assertion) AS ?records)
WHERE {
  ?assertion a align:DimensionAlignment ; align:sourceTopic ?area ;
    align:targetsDimension ?dimension ; align:contributionType ?kind .
  ?area dcterms:identifier ?areaID .
  ?dimension dcterms:identifier ?dimensionID .
}
GROUP BY ?areaID ?dimensionID ?kind
ORDER BY ?areaID ?dimensionID ?kind
