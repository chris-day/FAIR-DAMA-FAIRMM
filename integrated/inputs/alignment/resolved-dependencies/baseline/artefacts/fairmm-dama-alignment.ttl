ns1:ACT-05-001-indirect-A1.2 a owl:NamedIndividual,
        ns1:SourceAssertion ;
    dcterms:identifier "ACT-05-001-indirect-A1.2" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1171> ;
    ns1:existingContributionType "Indirect" ;
    ns1:hasPractice ns1:ACT-05-001 ;
    ns1:inSourceTopic ns1:AREA-05 ;
    ns1:originalContributionType "Indirect" ;
    ns1:primarySource <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1171> ;
    ns1:rationale "Indirect support: Security governance and classification can determine legitimate access conditions and oversee their operation. Security controls must be incorporated into the retrieval protocol to fulfil A1.2; source confidentiality does not imply a FAIR accessibility result." ;
