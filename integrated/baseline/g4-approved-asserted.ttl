    ns1:rationale "Define and Maintain Enterprise Taxonomies (P)  \\[source: DocumentContentManagement!A7:F7\\] — Deliverable: Enterprise Taxonomies (Information Content Architecture).; Inferred support: enterprise taxonomies can supply controlled terms for content metadata; I2 additionally requires the vocabulary resources themselves to be FAIR. No implementation evidence is supplied." ;
    ns1:sourceCoordinate "DocumentContentManagement!A7:L7" ;
    ns1:sourceLayer "activity_table" ;
    ns1:targetsPrinciple <https://w3id.org/fair/principles/terms/I2> .

ns1:ACT-08-007-direct-F2 a owl:NamedIndividual,
        ns1:SourceAssertion ;
    dcterms:identifier "ACT-08-007-direct-F2" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1583> ;
    ns1:existingContributionType "Direct" ;
    ns1:hasPractice ns1:ACT-08-007 ;
    ns1:inSourceTopic ns1:AREA-08 ;
    ns1:originalContributionType "Direct" ;
    ns1:primarySource <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1583> ;
    ns1:rationale "Document / Index Information Content Metadata (D) \\[source: DocumentContentManagement!A8:F8\\] — Deliverable: Indexed Keywords, Metadata.; Explicit partial support: indexing content metadata and keywords can enable searchable registration and descriptions. Index search and sufficient descriptive richness must be demonstrated. No implementation evidence is supplied." ;
    ns1:sourceCoordinate "DocumentContentManagement!A8:L8" ;
