        align:SourceField ;
    rdfs:label "Indirect support"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L2163> ;
    align:fieldHeading "Indirect support" ;
    align:sourcePosition 10 ;
    align:sourceText "Platform design can enable standardized retrieval, open protocols and controlled access if these are explicitly commissioned and implemented." .

align:ACT-13-002-field-11 a owl:NamedIndividual,
        align:SourceField ;
    rdfs:label "What would demonstrate the supported FAIR requirement"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L2163> ;
    align:fieldHeading "What would demonstrate the supported FAIR requirement" ;
    align:sourcePosition 11 ;
    align:sourceText "Test retrieval of identified data and metadata through a specified standard protocol; inspect freely implementable protocol specifications; test required authentication and authorization. Platform availability alone is insufficient." .

align:ACT-13-002-field-12 a owl:NamedIndividual,
        align:SourceField ;
    rdfs:label "FAIR principles indirectly supported"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L2163> ;
