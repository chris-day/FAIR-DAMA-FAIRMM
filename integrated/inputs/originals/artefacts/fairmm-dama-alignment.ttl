    align:fieldHeading "Indirect support" ;
    align:sourcePosition 10 ;
    align:sourceText "Standards selection can commission domain-relevant community conformance if named external standards, versions and acceptance tests are explicitly adopted. Internal IT standards alone are insufficient." .

align:ACT-13-001-field-11 a owl:NamedIndividual,
        align:SourceField ;
    rdfs:label "What would demonstrate the supported FAIR requirement"@en ;
