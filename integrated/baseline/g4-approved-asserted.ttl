    ns4:applicabilityCondition "Inspect shared formal representations and identifiable resources with typed relations; trace transformations to source versions. Matching columns, feature vectors and internal keys alone are insufficient."@en ;
    ns4:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns4:evidenceRequirement "Inspect shared formal representations and identifiable resources with typed relations; trace transformations to source versions. Matching columns, feature vectors and internal keys alone are insufficient."@en ;
    ns4:fromPractice <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-7> ;
    ns4:rationale "Integration can preserve provenance and implement explicit semantic representations and typed links when these requirements are included in the integration design."@en ;
    ns4:targetsPrinciple <https://w3id.org/fair/principles/terms/R1.2> ;
    ns4:viaPractice ns4:PublishProvenance .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/BigDataDataScience/row-8/indirect/R1> a owl:NamedIndividual,
        ns4:IndirectContribution ;
    rdfs:label "Explore Data Using Models → R1"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/outputs/dama-20261116/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A8:L8> ;
    ns4:alignmentBasis "Activity-derived proposal"@en ;
    ns4:applicabilityCondition "Inspect resource-linked descriptions of analytical context and limitations and a traceable execution record linking inputs, model versions and outputs. Performance scores alone are insufficient."@en ;
    ns4:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns4:evidenceRequirement "Inspect resource-linked descriptions of analytical context and limitations and a traceable execution record linking inputs, model versions and outputs. Performance scores alone are insufficient."@en ;
    ns4:fromPractice <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-8> ;
    ns4:rationale "Exploration can enrich reuse descriptions and provenance if assumptions, limitations, source versions, model versions and analytical steps are recorded with the resulting resources."@en ;
    ns4:targetsPrinciple <https://w3id.org/fair/principles/terms/R1> ;
    ns4:viaPractice ns4:PublishRichReuseDescriptions .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/BigDataDataScience/row-8/indirect/R1.2> a owl:NamedIndividual,
        ns4:IndirectContribution ;
    rdfs:label "Explore Data Using Models → R1.2"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/outputs/dama-20261116/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A8:L8> ;
    ns4:alignmentBasis "Activity-derived proposal"@en ;
    ns4:applicabilityCondition "Inspect resource-linked descriptions of analytical context and limitations and a traceable execution record linking inputs, model versions and outputs. Performance scores alone are insufficient."@en ;
    ns4:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns4:evidenceRequirement "Inspect resource-linked descriptions of analytical context and limitations and a traceable execution record linking inputs, model versions and outputs. Performance scores alone are insufficient."@en ;
    ns4:fromPractice <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-8> ;
    ns4:rationale "Exploration can enrich reuse descriptions and provenance if assumptions, limitations, source versions, model versions and analytical steps are recorded with the resulting resources."@en ;
    ns4:targetsPrinciple <https://w3id.org/fair/principles/terms/R1.2> ;
    ns4:viaPractice ns4:PublishProvenance .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/BigDataDataScience/row-9/indirect/F2> a owl:NamedIndividual,
        ns4:IndirectContribution ;
    rdfs:label "Communicate Output to Stakeholders → F2"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/outputs/dama-20261116/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A9:L9> ;
    ns4:alignmentBasis "Activity-derived proposal"@en ;
    ns4:applicabilityCondition "Inspect resource-linked discovery and reuse descriptions covering meaning, methods, coverage, assumptions and limitations. A presentation without associated resource descriptions is insufficient."@en ;
    ns4:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns4:evidenceRequirement "Inspect resource-linked discovery and reuse descriptions covering meaning, methods, coverage, assumptions and limitations. A presentation without associated resource descriptions is insufficient."@en ;
    ns4:fromPractice <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-9> ;
    ns4:rationale "Communications can make discovery and reuse context available if findings are accompanied by accurate descriptions linked to the analytical resources."@en ;
    ns4:targetsPrinciple <https://w3id.org/fair/principles/terms/F2> ;
    ns4:viaPractice ns4:PublishRichDiscoveryMetadata .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/BigDataDataScience/row-9/indirect/R1> a owl:NamedIndividual,
        ns4:IndirectContribution ;
    rdfs:label "Communicate Output to Stakeholders → R1"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/outputs/dama-20261116/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A9:L9> ;
    ns4:alignmentBasis "Activity-derived proposal"@en ;
    ns4:applicabilityCondition "Inspect resource-linked discovery and reuse descriptions covering meaning, methods, coverage, assumptions and limitations. A presentation without associated resource descriptions is insufficient."@en ;
    ns4:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns4:evidenceRequirement "Inspect resource-linked discovery and reuse descriptions covering meaning, methods, coverage, assumptions and limitations. A presentation without associated resource descriptions is insufficient."@en ;
    ns4:fromPractice <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-9> ;
    ns4:rationale "Communications can make discovery and reuse context available if findings are accompanied by accurate descriptions linked to the analytical resources."@en ;
    ns4:targetsPrinciple <https://w3id.org/fair/principles/terms/R1> ;
    ns4:viaPractice ns4:PublishRichReuseDescriptions .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/DataHandlingEthics/row-2/indirect/A1.2> a owl:NamedIndividual,
        ns4:IndirectContribution ;
    rdfs:label "Review Data-Handling Practices → A1.2"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/outputs/dama-20261116/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#DataHandlingEthics!A2:L2> ;
    ns4:alignmentBasis "Activity-derived proposal"@en ;
    ns4:applicabilityCondition "Inspect approved policy or control requirements that explicitly distinguish access authorization from permitted reuse. Test any resulting authentication and authorization procedure for identified resources (A1.2) and inspect the clear, accessible usage licence attached to data and metadata (R1.1). An ethics statement, privacy notice or generic compliance metric alone is insufficient."@en ;
    ns4:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns4:evidenceRequirement "Inspect approved policy or control requirements that explicitly distinguish access authorization from permitted reuse. Test any resulting authentication and authorization procedure for identified resources (A1.2) and inspect the clear, accessible usage licence attached to data and metadata (R1.1). An ethics statement, privacy notice or generic compliance metric alone is insufficient."@en ;
    ns4:fromPractice <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/DataHandlingEthics/row-2> ;
    ns4:rationale "Review can identify gaps in authorized access and permitted reuse if the review criteria explicitly include them."@en ;
    ns4:targetsPrinciple <https://w3id.org/fair/principles/terms/A1.2> ;
    ns4:viaPractice ns4:ConfigureRetrievalAuthorization .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/DataHandlingEthics/row-2/indirect/R1.1> a owl:NamedIndividual,
        ns4:IndirectContribution ;
    rdfs:label "Review Data-Handling Practices → R1.1"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/outputs/dama-20261116/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#DataHandlingEthics!A2:L2> ;
    ns4:alignmentBasis "Activity-derived proposal"@en ;
    ns4:applicabilityCondition "Inspect approved policy or control requirements that explicitly distinguish access authorization from permitted reuse. Test any resulting authentication and authorization procedure for identified resources (A1.2) and inspect the clear, accessible usage licence attached to data and metadata (R1.1). An ethics statement, privacy notice or generic compliance metric alone is insufficient."@en ;
    ns4:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns4:evidenceRequirement "Inspect approved policy or control requirements that explicitly distinguish access authorization from permitted reuse. Test any resulting authentication and authorization procedure for identified resources (A1.2) and inspect the clear, accessible usage licence attached to data and metadata (R1.1). An ethics statement, privacy notice or generic compliance metric alone is insufficient."@en ;
    ns4:fromPractice <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/DataHandlingEthics/row-2> ;
    ns4:rationale "Review can identify gaps in authorized access and permitted reuse if the review criteria explicitly include them."@en ;
    ns4:targetsPrinciple <https://w3id.org/fair/principles/terms/R1.1> ;
    ns4:viaPractice ns4:AttachUsageLicense .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/DataHandlingEthics/row-3/indirect/A1.2> a owl:NamedIndividual,
        ns4:IndirectContribution ;
    rdfs:label "Identify Principles, Practices, and Risk Factors → A1.2"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/outputs/dama-20261116/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#DataHandlingEthics!A3:L3> ;
    ns4:alignmentBasis "Activity-derived proposal"@en ;
    ns4:applicabilityCondition "Inspect approved policy or control requirements that explicitly distinguish access authorization from permitted reuse. Test any resulting authentication and authorization procedure for identified resources (A1.2) and inspect the clear, accessible usage licence attached to data and metadata (R1.1). An ethics statement, privacy notice or generic compliance metric alone is insufficient."@en ;
    ns4:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns4:evidenceRequirement "Inspect approved policy or control requirements that explicitly distinguish access authorization from permitted reuse. Test any resulting authentication and authorization procedure for identified resources (A1.2) and inspect the clear, accessible usage licence attached to data and metadata (R1.1). An ethics statement, privacy notice or generic compliance metric alone is insufficient."@en ;
    ns4:fromPractice <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/DataHandlingEthics/row-3> ;
    ns4:rationale "Risk assessment can establish requirements for controlled access and clear reuse permissions; neither requirement is specified by the activity label alone."@en ;
    ns4:targetsPrinciple <https://w3id.org/fair/principles/terms/A1.2> ;
    ns4:viaPractice ns4:ConfigureRetrievalAuthorization .

