<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-10> a owl:NamedIndividual,
        ns4:SourceActivity ;
    rdfs:label "Deploy and Monitor"@en ;
    dcterms:identifier "BigDataDataScience!A10:L10" ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/assets/13_BigDataDataScience.webp>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/outputs/dama-20261116/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A10:L10> ;
    ns4:alignmentBasis "Activity-derived proposal; source image plus interpreted associations"@en ;
    ns4:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns4:deliverables "Operations Plan; Model Performance; Model Enhancement Plan"@en ;
    ns4:directSupportExplanation "Deployment, availability and model performance do not directly establish a FAIR principle."@en ;
    ns4:evidenceRequirement "Test standardized retrieval of identified resources and inspect version-linked deployment and execution provenance. Monitoring predictive accuracy or infrastructure utilization alone is insufficient."@en ;
    ns4:inTopic ns2:BigDataAndDataScience ;
    ns4:indirectSupportExplanation "Operations can sustain identifier-based access and record versioned inputs, model changes and execution history when those controls are explicitly included in the operations plan."@en ;
    ns4:lifecycleCode "O,C"@en ;
    ns4:proposedApprovingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/business-executives>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/it-executives> ;
    ns4:proposedContributingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/analytic-design-lead>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-quality-and-governance-specialists>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/ingestion-architects>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/metadata-specialists> ;
    ns4:proposedResponsiblePersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/big-data-platform-architects>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-scientists> ;
    ns4:relevantDeliverables "Operations Plan; Model Performance; Model Enhancement Plan"@en ;
    ns4:sourceRow 10 ;
    ns4:sourceWorksheet "BigDataDataScience" .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-4> a owl:NamedIndividual,
        ns4:SourceActivity ;
    rdfs:label "Choose Data Sources"@en ;
    dcterms:identifier "BigDataDataScience!A4:L4" ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/assets/13_BigDataDataScience.webp>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/outputs/dama-20261116/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A4:L4> ;
    ns4:alignmentBasis "Activity-derived proposal; source image plus interpreted associations"@en ;
    ns4:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns4:deliverables "Data Sourcing Plan"@en ;
    ns4:directSupportExplanation "Selecting sources does not by itself publish resource descriptions, provenance or usage licences."@en ;
    ns4:evidenceRequirement "Trace selected source versions to providers and acquisition context; inspect accessible usage licences linked to each resource. A commercial purchase or access agreement alone is not a FAIR usage licence."@en ;
    ns4:inTopic ns2:BigDataAndDataScience ;
    ns4:indirectSupportExplanation "Source evaluation can record origin, permitted reuse and descriptive context, enabling provenance and licensing requirements when resource-linked records and accessible terms are retained."@en ;
    ns4:lifecycleCode "P"@en ;
    ns4:proposedApprovingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/analytic-design-lead> ;
    ns4:proposedContributingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-producers>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-quality-and-governance-specialists>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-smes>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-suppliers> ;
    ns4:proposedResponsiblePersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-curators>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-scientists> ;
    ns4:relevantDeliverables "Data Sourcing Plan"@en ;
    ns4:sourceRow 4 ;
    ns4:sourceWorksheet "BigDataDataScience" .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-5> a owl:NamedIndividual,
        ns4:SourceActivity ;
    rdfs:label "Acquire & Ingest Data Sources"@en ;
    dcterms:identifier "BigDataDataScience!A5:L5" ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/assets/13_BigDataDataScience.webp>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/outputs/dama-20261116/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A5:L5> ;
    ns4:alignmentBasis "Activity-derived proposal; source image plus interpreted associations"@en ;
    ns4:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns4:deliverables "Acquired Data Sources"@en ;
    ns4:directSupportExplanation "Ingesting data is not direct evidence of rich metadata or provenance; the diagram does not explicitly specify their capture."@en ;
    ns4:evidenceRequirement "Inspect descriptions linked to ingested resources and provenance records identifying sources, versions, agents, acquisition times and transformations. Successful loading and scanning alone are insufficient."@en ;
    ns4:inTopic ns2:BigDataAndDataScience ;
    ns4:indirectSupportExplanation "Ingestion can capture resource descriptions, source versions, acquisition times and transformations if metadata capture is added as an explicit requirement."@en ;
    ns4:lifecycleCode "D"@en ;
    ns4:proposedApprovingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/big-data-platform-architects> ;
    ns4:proposedContributingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-producers>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-scientists>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-suppliers>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/metadata-specialists> ;
    ns4:proposedResponsiblePersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-curators>,
