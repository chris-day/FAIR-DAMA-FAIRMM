    ns1:originalContributionType "Direct" ;
    ns1:primarySource <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1445> ;
    ns1:rationale "Implement Business Intelligence Tools and User Interfaces (D)  \\[source: DWandBIActivities!A5:F5\\] — Deliverable: BI Tools and User Environments, Query and Reporting, Dashboards, Scorecards, Analytic Applications, etc..; Inferred support: query/reporting interfaces can provide searchable registration for datasets or metadata if those resources are indexed. Querying business facts, dashboards or scorecards alone does not establish F4. No implementation evidence is supplied." ;
    ns1:sourceCoordinate "DWandBIActivities!A5:L5" ;
    ns1:sourceLayer "activity_table" ;
    ns1:targetsPrinciple <https://w3id.org/fair/principles/terms/F4> .

ns1:ACT-08-002-direct-A1 a owl:NamedIndividual,
        ns1:SourceAssertion ;
    dcterms:identifier "ACT-08-002-direct-A1" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1578> ;
