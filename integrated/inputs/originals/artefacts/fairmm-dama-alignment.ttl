align:ACT-06-006-field-11 a owl:NamedIndividual,
        align:SourceField ;
    rdfs:label "What would demonstrate the supported FAIR requirement"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1309> ;
    align:fieldHeading "What would demonstrate the supported FAIR requirement" ;
    align:sourcePosition 11 ;
    align:sourceText "I3: Inspect sample data/metadata for references to identifiable related resources with explicit relation types and context; check targets and meanings. Matching keys or diagrammed entity relationships alone are insufficient.; R1.2: Trace representative data and metadata to identified sources, contributors/agents, transformations, dates and versions. Inspect associated provenance records; an unlinked source assessment, ETL design or change log documents only part of the requirement.; Supporting-process evidence: inspect the named deliverable and its approval/maintenance records separately from the resource tests." .

