ns1:ACT-13-006-field-10 a owl:NamedIndividual,
        ns1:SourceField ;
    rdfs:label "Indirect support"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L2167> ;
    ns1:fieldHeading "Indirect support" ;
    ns1:sourcePosition 10 ;
    ns1:sourceText "Integration can preserve provenance and implement explicit semantic representations and typed links when these requirements are included in the integration design." .

ns1:ACT-13-006-field-11 a owl:NamedIndividual,
        ns1:SourceField ;
    rdfs:label "What would demonstrate the supported FAIR requirement"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L2167> ;
    ns1:fieldHeading "What would demonstrate the supported FAIR requirement" ;
    ns1:sourcePosition 11 ;
    ns1:sourceText "Inspect shared formal representations and identifiable resources with typed relations; trace transformations to source versions. Matching columns, feature vectors and internal keys alone are insufficient." .

