    align:primarySource <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L756> ;
    align:rationale "Define and Maintain Enterprise Ontologies, Taxonomies and Namespaces (P) \\[source: DataArchitectureManagement!A8:F8\\] — Deliverable: Enterprise Taxonomies, Industry Ontologies, ISO TC/68 alignment,  XML Namespaces,  Content Management Standards.; Inferred support: industry ontologies, taxonomies and XML namespaces can underpin formal representation and FAIR vocabulary use. ISO TC/68 alignment and content-management standards may support R1.3 where relevant to the domain community; no particular standard/version or conformance evidence is supplied. No implementation evidence is supplied." ;
    align:sourceCoordinate "DataArchitectureManagement!A8:L8" ;
    align:sourceLayer "activity_table" ;
    align:targetsPrinciple fair:I1 .

