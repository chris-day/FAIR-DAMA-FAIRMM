    ns1:rationale "Ingestion can capture resource descriptions, source versions, acquisition times and transformations if metadata capture is added as an explicit requirement." ;
    ns1:sourceIntermediatePractice <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#PublishRichDiscoveryMetadata> ;
    ns1:sourceLayer "ontology_contribution" ;
