    ns1:fieldHeading "Deliverables" ;
    ns1:sourcePosition 2 ;
    ns1:sourceText "Enterprise Taxonomies, Industry Ontologies, ISO TC/68 alignment,  XML Namespaces,  Content Management Standards;" .

