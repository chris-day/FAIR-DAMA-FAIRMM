<urn:fair-dama-fairmm:alignment:ONT-contribution/BigDataDataScience/row-2/indirect/R1.3> a owl:NamedIndividual,
        ns1:SourceAssertion ;
    dcterms:identifier "ONT-contribution/BigDataDataScience/row-2/indirect/R1.3" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/dama-ontologies-v1.1.0/dama-fair-mapping.ttl> ;
    ns1:applicabilityCondition "Inspect approved standards and their domain relevance, then validate actual data and metadata against the applicable community specifications. Strategy approval alone does not demonstrate conformance." ;
    ns1:derivedFromSourceNode <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/BigDataDataScience/row-2/indirect/R1.3> ;
    ns1:existingContributionType "Indirect" ;
    ns1:hasPractice <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-2> ;
    ns1:inSourceTopic ns1:AREA-13 ;
    ns1:originalContributionType "Indirect" ;
    ns1:primarySource <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/dama-ontologies-v1.1.0/dama-fair-mapping.ttl> ;
    ns1:rationale "Standards selection can commission domain-relevant community conformance if named external standards, versions and acceptance tests are explicitly adopted. Internal IT standards alone are insufficient." ;
    ns1:sourceIntermediatePractice ns4:ValidateCommunityStandards ;
    ns1:sourceLayer "ontology_contribution" ;
    ns1:targetsPrinciple <https://w3id.org/fair/principles/terms/R1.3> .

<urn:fair-dama-fairmm:alignment:ONT-contribution/BigDataDataScience/row-3/indirect/A1> a owl:NamedIndividual,
        ns1:SourceAssertion ;
