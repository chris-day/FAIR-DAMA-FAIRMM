ns1:ACT-02-002-direct-I1 a owl:NamedIndividual,
        ns1:SourceAssertion ;
    dcterms:identifier "ACT-02-002-direct-I1" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L751> ;
    ns1:existingContributionType "Direct" ;
    ns1:hasPractice ns1:ACT-02-002 ;
    ns1:inSourceTopic ns1:AREA-02 ;
    ns1:originalContributionType "Direct" ;
    ns1:primarySource <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L751> ;
    ns1:rationale "Develop and Maintain the Enterprise Data Model (P) This will be the Enterprise Ontology and Knowledge Graph \\[source: DataArchitectureManagement!A3:F3\\] — Deliverable: Enterprise Data Model: Subject Area Model, Conceptual Model, Logical Model, Glossary.; Inferred support: the stated enterprise ontology/knowledge graph can implement shared formal representation, FAIR vocabulary use and qualified links. The deliverable also lists conceptual/logical models and a glossary, which alone do not establish these properties. No implementation evidence is supplied." ;
    ns1:sourceCoordinate "DataArchitectureManagement!A3:L3" ;
    ns1:sourceLayer "activity_table" ;
    ns1:targetsPrinciple <https://w3id.org/fair/principles/terms/I1> .

