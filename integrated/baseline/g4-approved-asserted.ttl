skos:definition a owl:AnnotationProperty .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/DataHandlingEthics/row-6> a owl:NamedIndividual,
        ns4:SourceActivity ;
    rdfs:label "Execute the Training and Communications Plan"@en ;
    dcterms:identifier "DataHandlingEthics!A6:L6" ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/assets/01_DataHandlingEthics.webp>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/outputs/dama-20261116/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#DataHandlingEthics!A6:L6> ;
    ns4:alignmentBasis "Activity-derived proposal; source image plus interpreted associations"@en ;
    ns4:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns4:deliverables "Communication Plan; Ethics Training Program; Awareness to Ethical Data Issues"@en ;
    ns4:directSupportExplanation "No direct FAIR requirement is established by this ethical-practice activity or its named deliverables. Ethical responsibility and FAIR fulfilment are related but distinct."@en ;
    ns4:evidenceRequirement "Inspect training objectives, materials and attendance as process evidence. Before assigning any FAIR ID, identify explicit FAIR requirements taught and separately test their implementation on resources. Training completion alone does not demonstrate FAIR fulfilment."@en ;
    ns4:inTopic ns2:DataHandlingEthics ;
    ns4:indirectSupportExplanation "Training and communications can improve ethical behavior and awareness, but the image supplies no principle-specific training content."@en ;
    ns4:lifecycleCode "D"@en ;
    ns4:proposedApprovingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-governance-bodies> ;
    ns4:proposedContributingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/coordinating-data-stewards>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/employees>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/executives>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/subject-matter-experts> ;
    ns4:proposedResponsiblePersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/change-managers>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/dm-services> ;
    ns4:relevantDeliverables "Communication Plan; Ethics Training Program; Awareness to Ethical Data Issues"@en ;
    ns4:sourceRow 6 ;
    ns4:sourceWorksheet "DataHandlingEthics" .

ns4:alignedPrinciple a owl:ObjectProperty ;
    rdfs:label "aligned FAIR principle"@en ;
    rdfs:domain ns4:AreaAlignmentAssessment ;
    rdfs:range <https://w3id.org/fair/principles/terms/FAIR-SubPrinciple> .

ns4:alignmentBasis a owl:AnnotationProperty ;
    rdfs:label "alignment basis"@en .

ns4:alignmentType a owl:AnnotationProperty ;
    rdfs:label "alignment type"@en .

ns4:applicabilityCondition a owl:AnnotationProperty .

ns4:assessmentStatus a owl:AnnotationProperty ;
    rdfs:label "assessment status"@en .

ns4:deliverables a owl:AnnotationProperty ;
    rdfs:label "deliverables"@en .

ns4:derivedFromActivity a owl:ObjectProperty ;
    rdfs:label "derived from source activity"@en ;
    rdfs:domain ns4:AreaAlignmentAssessment ;
    rdfs:range ns4:SourceActivity .

ns4:directSupportExplanation a owl:AnnotationProperty ;
    rdfs:label "direct support explanation"@en .

ns4:evidenceForPrinciple a owl:ObjectProperty ;
    rdfs:label "provides evidence for principle"@en ;
    rdfs:domain ns4:Practice ;
    rdfs:range <https://w3id.org/fair/principles/terms/FAIR-SubPrinciple> .

ns4:evidenceRequirement a owl:AnnotationProperty ;
    rdfs:label "evidence requirement"@en .

ns4:fromTopic a owl:ObjectProperty ;
    rdfs:label "from management topic"@en ;
    rdfs:domain ns4:AreaAlignmentAssessment ;
    rdfs:range ns2:ManagementTopic .

ns4:inKnowledgeArea a owl:ObjectProperty ;
    rdfs:domain ns4:Practice ;
    rdfs:range ns2:KnowledgeArea ;
    rdfs:subPropertyOf ns4:inTopic .

ns4:indirectSupportExplanation a owl:AnnotationProperty ;
    rdfs:label "indirect support explanation"@en .

ns4:lifecycleCode a owl:AnnotationProperty ;
    rdfs:label "lifecycle code"@en .

ns4:proposedApprovingPersona a owl:ObjectProperty ;
    rdfs:label "proposed approving persona"@en ;
    rdfs:domain ns4:SourceActivity ;
    rdfs:range ns3:Persona .

ns4:proposedContributingPersona a owl:ObjectProperty ;
    rdfs:label "proposed contributing persona"@en ;
    rdfs:domain ns4:SourceActivity ;
    rdfs:range ns3:Persona .

ns4:proposedResponsiblePersona a owl:ObjectProperty ;
    rdfs:label "proposed responsible persona"@en ;
    rdfs:domain ns4:SourceActivity ;
    rdfs:range ns3:Persona .

ns4:rationale a owl:AnnotationProperty .

ns4:relevantDeliverables a owl:AnnotationProperty ;
    rdfs:label "relevant deliverables"@en .

ns4:sourceRow a owl:AnnotationProperty ;
    rdfs:label "source row"@en .

ns4:sourceWorksheet a owl:AnnotationProperty ;
    rdfs:label "source worksheet"@en .

ns2:DMBOK2-2017 a owl:NamedIndividual,
        ns2:FrameworkEdition ;
    rdfs:label "DAMA-DMBOK2 (2017)"@en ;
    dcterms:hasPart ns2:DataArchitecture,
        ns2:DataGovernance,
        ns2:DataIntegrationAndInteroperability,
        ns2:DataModelingAndDesign,
        ns2:DataQualityManagement,
        ns2:DataSecurity,
        ns2:DataStorageAndOperations,
        ns2:DataWarehousingAndBusinessIntelligence,
        ns2:DocumentsAndContentManagement,
        ns2:MetadataManagement,
        ns2:ReferenceAndMasterDataManagement ;
    rdfs:isDefinedBy <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl> ;
    ns2:hasAdditionalTopic ns2:BigDataAndDataScience,
        ns2:DataHandlingEthics,
        ns2:DataManagementMaturityAssessment .

