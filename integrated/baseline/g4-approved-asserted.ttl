ns1:Persona-Lab_Manager a owl:NamedIndividual,
        ns1:Persona ;
    rdfs:label "Lab_Manager"@en ;
    dcterms:identifier "Lab_Manager" ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/FAIR_personas/Lab_Manager.md> ;
    skos:definition "Oversees the daily operation of research or testing laboratories, ensuring that experiments, equipment, personnel, and data workflows run efficiently, safely, and in compliance with regulatory and quality standards. They coordinate between scientists, data teams, and quality or regulatory functions to maintain accurate experimental records, ensure data integrity, and optimize resource utilization. The role combines scientific leadership with operational and digital oversight, increasingly relying on data-driven decision-making to improve productivity and reproducibility. The role may include a wide range of responsibilities, including budget and spends, overseeing daily operations, ensuring safety, managing lab and IT equipments and supplies, and supervising staff." ;
    ns1:inFrameworkVersion ns1:FAIRMM-v1.2.5 ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/FAIR_personas/Lab_Manager.md> ;
    ns1:sourceText "Oversees the daily operation of research or testing laboratories, ensuring that experiments, equipment, personnel, and data workflows run efficiently, safely, and in compliance with regulatory and quality standards. They coordinate between scientists, data teams, and quality or regulatory functions to maintain accurate experimental records, ensure data integrity, and optimize resource utilization. The role combines scientific leadership with operational and digital oversight, increasingly relying on data-driven decision-making to improve productivity and reproducibility. The role may include a wide range of responsibilities, including budget and spends, overseeing daily operations, ensuring safety, managing lab and IT equipments and supplies, and supervising staff." .

