    align:primarySource <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1305> ;
    align:rationale "Identify Reference Data Sources and Contributors (P) \\[source: ReferenceMasterDataManagement!A3:F3\\] — Deliverable: Description and Assessment of Sources and Contributors.; Explicit partial support: descriptions of sources and contributors capture origin and responsibility relevant to provenance; association with specific data/metadata and transformation history are still needed. No implementation evidence is supplied." ;
    align:sourceCoordinate "ReferenceMasterDataManagement!A3:L3" ;
    align:sourceLayer "activity_table" ;
    align:targetsPrinciple fair:R1.2 .

align:ACT-06-006-direct-I3 a owl:NamedIndividual,
        align:SourceAssertion ;
    dcterms:identifier "ACT-06-006-direct-I3" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1309> ;
