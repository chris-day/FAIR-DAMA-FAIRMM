    ns4:fromPractice <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-3> ;
    ns4:rationale "Platform design can enable standardized retrieval, open protocols and controlled access if these are explicitly commissioned and implemented."@en ;
    ns4:targetsPrinciple <https://w3id.org/fair/principles/terms/A1.1> ;
    ns4:viaPractice ns4:ImplementOpenRetrievalProtocol .

