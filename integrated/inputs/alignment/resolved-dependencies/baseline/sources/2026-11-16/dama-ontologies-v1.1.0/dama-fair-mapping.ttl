    rdfs:label "Integrate/Align Data For Analysis → I3"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/outputs/dama-20261116/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A7:L7> ;
