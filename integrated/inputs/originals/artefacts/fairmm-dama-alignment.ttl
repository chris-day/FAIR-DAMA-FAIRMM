<urn:fair-dama-fairmm:alignment:ONT-contribution/BigDataDataScience/row-8/indirect/R1> a owl:NamedIndividual,
        align:SourceAssertion ;
    dcterms:identifier "ONT-contribution/BigDataDataScience/row-8/indirect/R1" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/dama-ontologies-v1.1.0/dama-fair-mapping.ttl> ;
    align:applicabilityCondition "Inspect resource-linked descriptions of analytical context and limitations and a traceable execution record linking inputs, model versions and outputs. Performance scores alone are insufficient." ;
    align:derivedFromSourceNode <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/BigDataDataScience/row-8/indirect/R1> ;
    align:existingContributionType "Indirect" ;
    align:hasPractice <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-8> ;
    align:inSourceTopic align:AREA-13 ;
    align:originalContributionType "Indirect" ;
    align:primarySource <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/dama-ontologies-v1.1.0/dama-fair-mapping.ttl> ;
    align:rationale "Exploration can enrich reuse descriptions and provenance if assumptions, limitations, source versions, model versions and analytical steps are recorded with the resulting resources." ;
    align:sourceIntermediatePractice map:PublishRichReuseDescriptions ;
    align:sourceLayer "ontology_contribution" ;
    align:targetsPrinciple fair:R1 .

