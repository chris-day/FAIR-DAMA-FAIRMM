align:ACT-02-002-direct-I1 a owl:NamedIndividual,
        align:SourceAssertion ;
    dcterms:identifier "ACT-02-002-direct-I1" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L751> ;
    align:existingContributionType "Direct" ;
    align:hasPractice align:ACT-02-002 ;
    align:inSourceTopic align:AREA-02 ;
    align:originalContributionType "Direct" ;
    align:primarySource <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L751> ;
    align:rationale "Develop and Maintain the Enterprise Data Model (P) This will be the Enterprise Ontology and Knowledge Graph \\[source: DataArchitectureManagement!A3:F3\\] — Deliverable: Enterprise Data Model: Subject Area Model, Conceptual Model, Logical Model, Glossary.; Inferred support: the stated enterprise ontology/knowledge graph can implement shared formal representation, FAIR vocabulary use and qualified links. The deliverable also lists conceptual/logical models and a glossary, which alone do not establish these properties. No implementation evidence is supplied." ;
    align:sourceCoordinate "DataArchitectureManagement!A3:L3" ;
    align:sourceLayer "activity_table" ;
    align:targetsPrinciple fair:I1 .

