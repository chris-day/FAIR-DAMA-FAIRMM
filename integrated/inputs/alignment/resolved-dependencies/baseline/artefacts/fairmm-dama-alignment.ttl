<urn:fair-dama-fairmm:alignment:ONT-contribution/BigDataDataScience/row-4/indirect/R1.1> a owl:NamedIndividual,
        ns1:SourceAssertion ;
    dcterms:identifier "ONT-contribution/BigDataDataScience/row-4/indirect/R1.1" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/dama-ontologies-v1.1.0/dama-fair-mapping.ttl> ;
    ns1:applicabilityCondition "Trace selected source versions to providers and acquisition context; inspect accessible usage licences linked to each resource. A commercial purchase or access agreement alone is not a FAIR usage licence." ;
    ns1:derivedFromSourceNode <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/BigDataDataScience/row-4/indirect/R1.1> ;
