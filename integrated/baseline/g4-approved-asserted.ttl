ns1:Persona-Data_Strategy_Owner a owl:NamedIndividual,
        ns1:Persona ;
    rdfs:label "Data_Strategy_Owner"@en ;
    dcterms:identifier "Data_Strategy_Owner" ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/FAIR_personas/Data_Strategy_Owner.md> ;
    skos:definition "A senior leader responsible for defining, developing, and executing an organization's overarching data strategy to align with business goals. This role translates business strategy into a data strategy, establishing the roadmap for how data will be collected, managed, governed, and leveraged to drive value and innovation across the company." ;
    ns1:inFrameworkVersion ns1:FAIRMM-v1.2.5 ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/FAIR_personas/Data_Strategy_Owner.md> ;
    ns1:sourceText "A senior leader responsible for defining, developing, and executing an organization's overarching data strategy to align with business goals. This role translates business strategy into a data strategy, establishing the roadmap for how data will be collected, managed, governed, and leveraged to drive value and innovation across the company." .

ns1:Persona-Subject_Matter_Expert a owl:NamedIndividual,
        ns1:Persona ;
    rdfs:label "Subject_Matter_Expert"@en ;
    dcterms:identifier "Subject_Matter_Expert" ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/FAIR_personas/Subject_Matter_Expert.md> ;
    skos:definition "Deep domain expert who consumes and validates FAIR data rather than managing it. A subject matter expert (SME) is a person with deep domain knowledge, often as a practitioner of the area of knowledge. SME are often consulted by knowledge engineers and ontologists in what is known as ‘knowledge elicitation exercice’ to express use cases and concepts which are then organized and modeled in semantic artifact by knowledge engineers. (NB: SME also stands for Small to Medium Enterprise)." ;
    ns1:inFrameworkVersion ns1:FAIRMM-v1.2.5 ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/FAIR_personas/Subject_Matter_Expert.md> ;
    ns1:sourceText "Deep domain expert who consumes and validates FAIR data rather than managing it. A subject matter expert (SME) is a person with deep domain knowledge, often as a practitioner of the area of knowledge. SME are often consulted by knowledge engineers and ontologists in what is known as ‘knowledge elicitation exercice’ to express use cases and concepts which are then organized and modeled in semantic artifact by knowledge engineers. (NB: SME also stands for Small to Medium Enterprise)." .

