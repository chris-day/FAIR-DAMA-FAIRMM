<urn:fair-dama-fairmm:integrated:ontology> a owl:Ontology ;
    dcterms:title "FAIR DAMA integrated ontology"@en ;
    owl:versionIRI <urn:fair-dama-fairmm:integrated:ontology:version:1.0.0> ;
    owl:versionInfo "1.0.0" .

<http://semanticscience.org/resource/000090> a owl:Class ;
    rdfs:label "specification"@en .

ns4:AssignProvenanceResponsibilityToR1_2 a owl:NamedIndividual,
        ns4:IndirectContribution ;
    dcterms:source ns2:DataGovernance,
        <https://w3id.org/fair/principles/terms/R1.2> ;
    ns4:fromPractice ns4:AssignProvenanceResponsibility ;
    ns4:rationale "Assigning responsibility enables the publication of detailed dataset provenance."@en ;
    ns4:targetsPrinciple <https://w3id.org/fair/principles/terms/R1.2> ;
    ns4:viaPractice ns4:PublishProvenance .

ns4:AttachUsageLicenseToR1_1 a owl:NamedIndividual,
        ns4:DirectContribution ;
    dcterms:source ns2:MetadataManagement,
        <https://w3id.org/fair/principles/terms/R1.1> ;
    ns4:applicabilityCondition "The license applies to the resource and is clear and accessible."@en ;
    ns4:fromPractice ns4:AttachUsageLicense ;
    ns4:rationale "The published license states the terms under which the data or metadata may be used."@en ;
    ns4:targetsPrinciple <https://w3id.org/fair/principles/terms/R1.1> .

ns4:ConfigureRetrievalAuthorizationToA1_2 a owl:NamedIndividual,
        ns4:DirectContribution ;
    dcterms:source ns2:DataSecurity,
        <https://w3id.org/fair/principles/terms/A1.2> ;
    ns4:applicabilityCondition "Access control is needed and the retrieval protocol supports both authentication and authorization."@en ;
    ns4:fromPractice ns4:ConfigureRetrievalAuthorization ;
    ns4:rationale "The retrieval configuration provides evidence that the protocol supports authentication and authorization."@en ;
    ns4:targetsPrinciple <https://w3id.org/fair/principles/terms/A1.2> .

ns4:IncludeDatasetIdentifierToF3 a owl:NamedIndividual,
        ns4:DirectContribution ;
    dcterms:source ns2:MetadataManagement,
        <https://w3id.org/fair/principles/terms/F3> ;
    ns4:applicabilityCondition "The identifier in the metadata is the identifier of the described data."@en ;
    ns4:fromPractice ns4:IncludeDatasetIdentifier ;
    ns4:rationale "The metadata record explicitly identifies the data it describes."@en ;
    ns4:targetsPrinciple <https://w3id.org/fair/principles/terms/F3> .

ns4:IndexInSearchableCatalogToF4 a owl:NamedIndividual,
        ns4:DirectContribution ;
    dcterms:source ns2:MetadataManagement,
        <https://w3id.org/fair/principles/terms/F4> ;
    ns4:applicabilityCondition "The catalog is searchable and contains an index entry for the relevant data or metadata."@en ;
    ns4:fromPractice ns4:IndexInSearchableCatalog ;
    ns4:rationale "A searchable catalog entry provides evidence that the data or metadata have been indexed."@en ;
    ns4:targetsPrinciple <https://w3id.org/fair/principles/terms/F4> .

ns4:PublishProvenanceToR1_2 a owl:NamedIndividual,
        ns4:DirectContribution ;
    dcterms:source ns2:MetadataManagement,
        <https://w3id.org/fair/principles/terms/R1.2> ;
    ns4:applicabilityCondition "Detailed provenance is associated with the data or metadata."@en ;
    ns4:fromPractice ns4:PublishProvenance ;
    ns4:rationale "The provenance record provides evidence about the origins and history of the data."@en ;
    ns4:targetsPrinciple <https://w3id.org/fair/principles/terms/R1.2> .

ns4:PublishSharedRepresentationToI1 a owl:NamedIndividual,
        ns4:DirectContribution ;
    dcterms:source ns2:DataIntegrationAndInteroperability,
        <https://w3id.org/fair/principles/terms/I1> ;
    ns4:applicabilityCondition "The language is formal, accessible, shared and broadly applicable."@en ;
    ns4:fromPractice ns4:PublishSharedRepresentation ;
    ns4:rationale "The published representation provides evidence of the knowledge representation language used."@en ;
    ns4:targetsPrinciple <https://w3id.org/fair/principles/terms/I1> .

ns4:SetDataSecurityPolicyToA1_2 a owl:NamedIndividual,
        ns4:IndirectContribution ;
    dcterms:source ns2:DataSecurity,
        <https://w3id.org/fair/principles/terms/A1.2> ;
    ns4:applicabilityCondition "The policy applies to the retrieval service and calls for authentication and authorization where needed."@en ;
    ns4:fromPractice ns4:SetDataSecurityPolicy ;
    ns4:rationale "The policy drives the configuration of authentication and authorization for data or metadata retrieval."@en ;
    ns4:targetsPrinciple <https://w3id.org/fair/principles/terms/A1.2> ;
    ns4:viaPractice ns4:ConfigureRetrievalAuthorization .

ns4:SetLicensingPolicyToR1_1 a owl:NamedIndividual,
        ns4:IndirectContribution ;
    dcterms:source ns2:DataGovernance,
        <https://w3id.org/fair/principles/terms/R1.1> ;
    ns4:fromPractice ns4:SetLicensingPolicy ;
    ns4:rationale "The policy enables a publishing practice that attaches the applicable usage license."@en ;
    ns4:targetsPrinciple <https://w3id.org/fair/principles/terms/R1.1> ;
    ns4:viaPractice ns4:AttachUsageLicense .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#area-alignment/big-data-data-science/direct/R1> a owl:NamedIndividual,
        ns4:AreaAlignmentAssessment ;
    rdfs:label "Big Data & Data Science → R1 (Direct)"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA_FAIR_Sankey_v1.3.0.zip> ;
    ns4:alignedPrinciple <https://w3id.org/fair/principles/terms/R1> ;
    ns4:alignmentBasis "Activity-derived proposal (additional topic)"@en ;
    ns4:alignmentType "Direct" ;
    ns4:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns4:deliverables "Data Analysis and Hypotheses"@en ;
    ns4:derivedFromActivity <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-6> ;
    ns4:fromTopic ns2:BigDataAndDataScience ;
    ns4:rationale "Inferred potential direct support: documented hypotheses and methods can supply accurate, relevant methodological context for reusing the associated analytical data. The diagram does not establish that these descriptions are complete or associated with identifiable resources."@en .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#area-alignment/big-data-data-science/indirect/A1> a owl:NamedIndividual,
        ns4:AreaAlignmentAssessment ;
    rdfs:label "Big Data & Data Science → A1 (Indirect)"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA_FAIR_Sankey_v1.3.0.zip> ;
    ns4:alignedPrinciple <https://w3id.org/fair/principles/terms/A1> ;
    ns4:alignmentBasis "Activity-derived proposal (additional topic)"@en ;
    ns4:alignmentType "Indirect" ;
    ns4:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns4:deliverables "Big Data Landscape; Operations Plan; Model Performance; Model Enhancement Plan"@en ;
    ns4:derivedFromActivity <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-10>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-3> ;
    ns4:fromTopic ns2:BigDataAndDataScience ;
    ns4:rationale "Platform design can enable standardized retrieval, open protocols and controlled access if these are explicitly commissioned and implemented. Operations can sustain identifier-based access and record versioned inputs, model changes and execution history when those controls are explicitly included in the operations plan."@en .

