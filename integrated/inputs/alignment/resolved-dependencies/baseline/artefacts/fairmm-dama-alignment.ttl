    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L140> ;
    ns1:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L140> ;
    ns1:rationale "The named deliverable may address the F1 aspect of these clauses when its applicability condition is met." ;
    ns1:sourceText "Governance: recognize the need for governance processes related to FAIR principles and the processes for FAIR (e.g. master and reference data, consideration of dimensions for FAIR, RDMs )." ;
    ns1:supportedByDescriptor ns1:D5-L2 ;
    ns1:supportsInterpretation ns1:interpretation-43c6ae6358a1379348709fe1 .

ns1:evidence-5715fd274d5147c0a6c588b5 a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L97> ;
    ns1:matchingPhrase "vision, strategy and plan has approval" ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L97> ;
    ns1:sourceText "The first version of the vision, strategy and plan has approval." ;
    ns1:supportedByDescriptor ns1:D3-L2 .

ns1:evidence-5a026e227708c354f5996e6c a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level5.md#L173> ;
    ns1:matchingPhrase "FAIR Data Validation" ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level5.md#L173> ;
    ns1:sourceText "**FAIR Data Validation**: Tools are in place to validate the FAIRness of data throughout its lifecycle." ;
    ns1:supportedByDescriptor ns1:D7-L5 .

ns1:evidence-5dfefb471b9edb9d90111f32 a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level5.md#L103> ;
    ns1:matchingPhrase "Metrics and methodologies to measure these outcomes" ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level5.md#L103> ;
    ns1:sourceText "Establishing Metrics and methodologies to measure these outcomes reinforces the strategy's connection to essential tools. Importantly, the organization comprehends the impact of FAIRness on its financial performance, prioritizing it as a part of its overarching business strategy, supported by empirical cost-benefit analyses." ;
    ns1:supportedByDescriptor ns1:D3-L5 .

ns1:evidence-63abad0819648d70b64d3e49 a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L65> ;
    ns1:matchingPhrase "is cataloged" ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L65> ;
    ns1:sourceText "Data, conformed to a local model, is cataloged (i.e. a metadata record of existence is created), and data resides in a data lake." ;
    ns1:supportedByDescriptor ns1:D1-L2 .

ns1:evidence-69f4f0a35b2ded98b0d85baa a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L186> ;
    ns1:matchingPhrase "enterprise-wide data model" ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L186> ;
    ns1:sourceText "An \"anchor/reference model\", or \"enterprise-wide data model\", is being built (cf. refer to the Strategy dimension). This model can also be a semantic model external to the organization but selected based on business needs and suitability." ;
    ns1:supportedByDescriptor ns1:D7-L3 .

ns1:evidence-7345804023b740cf76dd87e0 a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level4.md#L124> ;
    ns1:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level4.md#L124> ;
    ns1:rationale "The named deliverable may address the D4 aspect of these clauses when its applicability condition is met." ;
    ns1:sourceText "Key roles are in place for metadata, data and governance management. The additional personas  that emerged more clearly -or are more clearly part of the FAIR enablers - include [Citizen_Data_Scientist](FAIR_personas/Citizen_Data_Scientist.md) , [Ontologist](FAIR_personas/Ontologist.md), [Master_Data_Manager](FAIR_personas/Master_Data_Manager.md), [Data_Owner](FAIR_personas/Data_Owner.md) , [Data_Strategy_Owner](FAIR_personas/Data_Strategy_Owner.md)and **Data product owner**." ;
    ns1:supportedByDescriptor ns1:D4-L4 ;
    ns1:supportsInterpretation ns1:interpretation-c090c0fd0e5e5f7cf786dae6 .

ns1:evidence-74dcd4149c9a867b113a63e5 a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L186> ;
    ns1:matchingPhrase "Established processes for producing and managing FAIR data" ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L186> ;
    ns1:sourceText "Established processes for producing and managing FAIR data, with tools, either internally developed or available by vendors and other organizations, could be limited in terms of entities and the level of sophistication." ;
    ns1:supportedByDescriptor ns1:D7-L3 .

ns1:evidence-79a73ca0ba78a230bcdb0f0b a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L158> ;
    ns1:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L158> ;
    ns1:rationale "The named deliverable may address the F1 aspect of these clauses when its applicability condition is met." ;
    ns1:sourceText "The FAIR data training is part of employee onboarding and continuous education development. The organization tailors specific FAIR processes to suit its needs and incorporates guidelines for providing FAIR data into standard IT procedures. Efforts to make metadata implementation accessible in a standardized manner without changing existing processes. The organization begins to integrate FAIR practices into workflows and configure systems to facilitate FAIR practices, demonstrating a commitment to normalising FAIR standards within organizational operations." ;
    ns1:supportedByDescriptor ns1:D5-L3 ;
    ns1:supportsInterpretation ns1:interpretation-810e2fd29c7a50996759bfe2 .

ns1:evidence-835d8dd91a6a54b638588189 a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level4.md#L188> ;
    ns1:matchingPhrase "Defined Interaction mechanisms with FAIR data have been consistently implemented" ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level4.md#L188> ;
    ns1:sourceText "**Defined Interaction Mechanisms:** Defined Interaction mechanisms with FAIR data have been consistently implemented across the organization and meet prioritized, organization-specific business needs." ;
    ns1:supportedByDescriptor ns1:D7-L4 .

ns1:evidence-89b9cf56b85a80d7bcd54abf a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level4.md#L170> ;
    ns1:matchingPhrase "validating instance metadata against annotation requirements and data shapes" ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level4.md#L170> ;
    ns1:sourceText "Knowledge about validating instance metadata against annotation requirements and data shapes is evident." ;
    ns1:supportedByDescriptor ns1:D6-L4 .

ns1:evidence-8b90e1c9a44b0efcb73841cf a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L158> ;
    ns1:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L158> ;
    ns1:rationale "The named deliverable may address the F1 aspect of these clauses when its applicability condition is met." ;
    ns1:sourceText "The organization initiates formal training for FAIR roles while a majority have embraced FAIR principles for major resources, backed by well-trained personnel capable of evaluating and implementing FAIR standards. At least one business unit actively employs FAIR processes in production, supported by documentation and training, with other FAIR initiatives underway and coordinated efforts recognized." ;
    ns1:supportedByDescriptor ns1:D5-L3 ;
    ns1:supportsInterpretation ns1:interpretation-810e2fd29c7a50996759bfe2 .

ns1:evidence-8db4ac78f6b9071673b78a36 a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level5.md#L138> ;
    ns1:matchingPhrase "seamless FAIR data exchange among entities" ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level5.md#L138> ;
    ns1:sourceText "World-class training programs are established and disseminated through courses. Organizations employ adaptable FAIR data frameworks that provide common standards, facilitating seamless FAIR data exchange among entities via fit-for-purpose FAIR-enabled APIs or tools." ;
    ns1:supportedByDescriptor ns1:D5-L5 .

ns1:evidence-8f741afba8a07e2d0d8522c8 a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level5.md#L138> ;
    ns1:matchingPhrase "Mechanisms exist to sustain metadata across organizations" ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level5.md#L138> ;
    ns1:sourceText "The organization actively shares its learnings internally and externally, among others, through communities of practices. Processes are in a position to align data harmonisation efforts beyond the organization, such as feedback loops with standard-setting bodies. Mechanisms exist to sustain metadata across organizations, including update and feedback processes between data vendors and consumers." ;
    ns1:supportedByDescriptor ns1:D5-L5 .

ns1:evidence-933602b45d65baba5cd6097f a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L183> ;
    ns1:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L183> ;
    ns1:rationale "The named deliverable may address the R1.3 aspect of these clauses when its applicability condition is met." ;
    ns1:sourceText "Initial infrastructure and tooling are in place for the first working POCs. Now that POCs work and prove value, RFPs or company-wide plans for tooling and infrastructure are getting scoped, including additional capacity for putting that infrastructure and tooling in place (people and budget)." ;
    ns1:supportedByDescriptor ns1:D7-L2 ;
    ns1:supportsInterpretation ns1:interpretation-3fd7c849dc1329db0613751c .

ns1:evidence-a5b2aa913927fee11d5f6dbe a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L140> ;
    ns1:matchingPhrase "integrated proof-of-concept projects" ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L140> ;
    ns1:sourceText "Efforts toward aligning individual FAIR data processes are underway but still need to be standardized, with ongoing coordination and integrated proof-of-concept projects in development." ;
    ns1:supportedByDescriptor ns1:D5-L2 .

ns1:evidence-aa0cc825da580b4406b22537 a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level4.md#L124> ;
    ns1:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level4.md#L124> ;
    ns1:rationale "The named deliverable may address the D4 aspect of these clauses when its applicability condition is met." ;
    ns1:sourceText "Leadership personas ([Business Leaders](), [Business Owner](FAIR_personas/Business_Owner.md) and [Technology_Leader](FAIR_personas/Technology_Leader.md).) keep playing a key role and enables a data-centric enterprise, but all employees are involved implicitly (cf [FAIR tools at level 4](level4.md#level-4-really-fair-fair-tools-and-infrastructures)) or explicitly in the FAIR data principle implementation." ;
    ns1:supportedByDescriptor ns1:D4-L4 ;
    ns1:supportsInterpretation ns1:interpretation-c090c0fd0e5e5f7cf786dae6 .

ns1:evidence-b3c39a876811c70c96d9b8e9 a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level4.md#L68> ;
    ns1:matchingPhrase "cross-domain data or industry model" ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level4.md#L68> ;
    ns1:sourceText "In addition to the level of [Pretty FAIR](level3.md), Data is described in a cross-domain data or industry model." ;
    ns1:supportedByDescriptor ns1:D1-L4 .

ns1:evidence-b4b18569fd1764fee069fc1b a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level4.md#L188> ;
    ns1:matchingPhrase "periodically evaluates historical and current solutions" ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level4.md#L188> ;
    ns1:sourceText "**Registry of FAIRification Tools**: Establishing a registry of tools specific to the organization's industry specialization. These tools are applied during the design phase before implementation and company-level processes are in place. Standards and governance practices integrate these tools, and a list of tools or internal experts with an overview of their capability is available. The organization periodically evaluates historical and current solutions, ensuring they remain current and effective." ;
    ns1:supportedByDescriptor ns1:D7-L4 .

ns1:evidence-dd033f7244b7b39928791ea3 a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L65> ;
    ns1:matchingPhrase "Controls on access at the system level" ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L65> ;
    ns1:sourceText "Controls on access at the system level." ;
    ns1:supportedByDescriptor ns1:D1-L2 .

ns1:evidence-de212cf74cc90bd6fcaaf98d a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level5.md#L67> ;
    ns1:matchingPhrase "knowledge language or ontology" ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level5.md#L67> ;
    ns1:sourceText "In addition to the features described in [Really FAIR](level4.md), we fully describe the data using a knowledge language or ontology of the types that carry GUPRIs (Role: [Knowledge-Enabled Citizens](FAIR_personas/Knowledge-Enabled_Citizen.md) )." ;
    ns1:supportedByDescriptor ns1:D1-L5 .

ns1:evidence-ebe9cafc1871894efac1c081 a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L183> ;
    ns1:matchingPhrase "assigning PIDs to key documents" ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L183> ;
    ns1:sourceText "Configure existing systems to implement FAIR, e.g., assigning PIDs to key documents, persons in organizational structures dealing with Human Resource, grant management, and publishing (authoring)." ;
    ns1:supportedByDescriptor ns1:D7-L2 .

ns1:evidence-f18ab9855f1d2c782eaa0439 a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level5.md#L173> ;
    ns1:matchingPhrase "Authentication and Authorization Infrastructure" ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level5.md#L173> ;
    ns1:sourceText "**Authentication and Authorization Infrastructure (AAI):** This ensures permissible accessibility for individuals and machines, aligning with industry standards." ;
    ns1:supportedByDescriptor ns1:D7-L5 .

ns1:evidence-f32f47627c7c6308706a0088 a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L183> ;
    ns1:matchingPhrase "Tools to work with controlled vocabularies" ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L183> ;
    ns1:sourceText "At this stage, the following are likely to be implemented (at least in some departments, do not need to be company-wide):Tools introduced to capture and publish metadata; Tools to work with controlled vocabularies; Tools to work with / manage persistent identifiers (PIDs)." ;
    ns1:supportedByDescriptor ns1:D7-L2 .

ns1:evidence-f5ef37fb534ebf3ab456e92f a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level4.md#L170> ;
    ns1:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level4.md#L170> ;
    ns1:rationale "The named deliverable may address the D6 aspect of these clauses when its applicability condition is met." ;
    ns1:sourceText "An organization-wide cross-domain FAIR community of practice is established, with a named leader and regular cadence of meetings with a standing agenda of project reviews, best practice development, real-world experiences, and sharing of learnings." ;
    ns1:supportedByDescriptor ns1:D6-L4 ;
    ns1:supportsInterpretation ns1:interpretation-2deed418accc041fb069a38a .

ns1:evidence-f713c63ad9c9f860f1eb56e2 a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level5.md#L67> ;
    ns1:matchingPhrase "new data generated is \"FAIR by design\"" ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level5.md#L67> ;
    ns1:sourceText "FAIR data are a key strategic asset and advantage of the company. Based on expected business value, critical data assets comply with the FAIR data principle, and new data generated is \"FAIR by design\"." ;
    ns1:supportedByDescriptor ns1:D1-L5 .

