align:ACT-08-002-field-8 a owl:NamedIndividual,
        align:SourceField ;
    rdfs:label "FAIR principles supported"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1578> ;
    align:fieldHeading "FAIR principles supported" ;
    align:sourcePosition 8 ;
    align:sourceText "A1 — retrieval by identifier via a standard communications protocol; A1.2 — retrieval protocol supports authentication and authorisation" .

align:ACT-08-002-field-9 a owl:NamedIndividual,
        align:SourceField ;
    rdfs:label "How they can support FAIR"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1578> ;
    align:fieldHeading "How they can support FAIR" ;
    align:sourcePosition 9 ;
    align:sourceText "Implement Document / Record Management Systems for Acquisition, Storage, Access, and Security Controls (O, C) \\[source: DocumentContentManagement!A3:F3\\] — Deliverable: Document / Record Management Systems (including image and e-mail systems), Portals,Paper and Electronic Documents (text, graphics, images, audio, video).; Inferred support: access and security controls in electronic document systems can implement identifier-based protocol retrieval and authorisation. Paper documents, storage or portals alone do not meet those requirements. No implementation evidence is supplied." .

align:ACT-08-003-field-1 a owl:NamedIndividual,
        align:SourceField ;
    rdfs:label "Activities"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1579> ;
    align:fieldHeading "Activities" ;
    align:sourcePosition 1 ;
    align:sourceText "Backup and Recover Documents / Records (O)" .

align:ACT-08-003-field-10 a owl:NamedIndividual,
        align:SourceField ;
    rdfs:label "Indirect support"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1579> ;
    align:fieldHeading "Indirect support" ;
    align:sourcePosition 10 ;
