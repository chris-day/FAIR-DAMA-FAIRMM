<urn:fair-dama-fairmm:alignment:ONT-contribution/BigDataDataScience/row-5/indirect/F2> a owl:NamedIndividual,
        ns1:SourceAssertion ;
    dcterms:identifier "ONT-contribution/BigDataDataScience/row-5/indirect/F2" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/dama-ontologies-v1.1.0/dama-fair-mapping.ttl> ;
    ns1:applicabilityCondition "Inspect descriptions linked to ingested resources and provenance records identifying sources, versions, agents, acquisition times and transformations. Successful loading and scanning alone are insufficient." ;
    ns1:derivedFromSourceNode <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/BigDataDataScience/row-5/indirect/F2> ;
