# Explicit asserted union view; CQ09/CQ17 also read the named provenance graph.
PREFIX a: <urn:fair-dama-fairmm:alignment:>
PREFIX cap: <urn:capability-ontology:>
PREFIX dama: <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#>
PREFIX persona: <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#>
PREFIX map: <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#>
PREFIX fair: <https://w3id.org/fair/principles/terms/>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX i: <urn:fair-dama-fairmm:integrated:>
PREFIX ex: <urn:g4-fixture:>
SELECT DISTINCT ?tool ?principle ?level WHERE { ?p a a:ToolPrincipleProposal ; a:forTool ?tool ; a:targetsPrinciple ?principle ; cap:forImplementation ?implementation ; cap:inScope ?scope ; a:inFrameworkVersion ?version ; a:applicabilityCondition ?condition ; a:deploymentVerificationStatus "verified" ; cap:hasEvidence ?ep . ?ep a cap:Evidence . ?l a:forTool ?tool ; a:targetsDimension a:D7 ; a:targetsLevel ?level ; cap:forImplementation ?implementation ; cap:inScope ?scope ; a:inFrameworkVersion ?version ; a:applicabilityCondition ?condition ; a:deploymentVerificationStatus "verified" ; cap:hasEvidence ?el . ?el a cap:Evidence  FILTER NOT EXISTS { ?p a:applicabilityCondition ?extra . FILTER NOT EXISTS { ?l a:applicabilityCondition ?extra } }
 FILTER NOT EXISTS { ?l a:applicabilityCondition ?extra . FILTER NOT EXISTS { ?p a:applicabilityCondition ?extra } } }