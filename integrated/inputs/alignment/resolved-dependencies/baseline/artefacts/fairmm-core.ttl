<urn:fair-dama-fairmm:alignment:sourceLine> a owl:DatatypeProperty .

<urn:fair-dama-fairmm:alignment:sourcePersona> a owl:ObjectProperty .

<urn:fair-dama-fairmm:alignment:sourcePosition> a owl:DatatypeProperty ;
    rdfs:range xsd:nonNegativeInteger .

<urn:fair-dama-fairmm:alignment:sourceRevision> a owl:DatatypeProperty ;
    rdfs:range xsd:string .

<urn:fair-dama-fairmm:alignment:sourceRoleCategory> a owl:ObjectProperty .

<urn:fair-dama-fairmm:alignment:sourceSection> a owl:DatatypeProperty .

<urn:fair-dama-fairmm:alignment:sourceSnapshot> a owl:ObjectProperty .

<urn:fair-dama-fairmm:alignment:sourceText> a owl:DatatypeProperty ;
    rdfs:range xsd:string .

<urn:fair-dama-fairmm:alignment:sourceTopic> a owl:ObjectProperty ;
    rdfs:range <urn:fair-dama-fairmm:alignment:SourceTopic> .

<urn:fair-dama-fairmm:alignment:supportedByDescriptor> a owl:ObjectProperty ;
    rdfs:range <urn:fair-dama-fairmm:alignment:Descriptor> .

<urn:fair-dama-fairmm:alignment:supportsInterpretation> a owl:ObjectProperty .

<urn:fair-dama-fairmm:alignment:targetsPrinciple> a owl:ObjectProperty .

<urn:fair-dama-fairmm:alignment:topicNumber> a owl:DatatypeProperty ;
    rdfs:range xsd:nonNegativeInteger .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#Practice> a owl:Class .

<urn:fair-dama-fairmm:alignment:ActivityRoleOccurrence> a owl:Class ;
    rdfs:label "ActivityRoleOccurrence"@en ;
    skos:definition "A responsible, approving or contributing role occurrence in an activity source."@en .

<urn:fair-dama-fairmm:alignment:CapabilityInterpretation> a owl:Class ;
    rdfs:label "CapabilityInterpretation"@en ;
    skos:definition "A separately identified proposed interpretation of descriptor text."@en .

<urn:fair-dama-fairmm:alignment:CounterpartCandidate> a owl:Class ;
    rdfs:label "CounterpartCandidate"@en ;
    skos:definition "A proposed DAMA counterpart with its own match qualification and source."@en .

<urn:fair-dama-fairmm:alignment:CumulativeAssociation> a owl:Class ;
    rdfs:label "CumulativeAssociation"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <urn:fair-dama-fairmm:alignment:firstSupportedLevel> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <urn:fair-dama-fairmm:alignment:derivedFromOnset> ],
        <urn:fair-dama-fairmm:alignment:LevelAlignment> ;
    skos:definition "A materialized area-level-type association derived from an onset judgement."@en .

<urn:fair-dama-fairmm:alignment:DataRole> a owl:Class ;
    rdfs:label "DataRole"@en ;
    skos:definition "Producer, Consumer or Enabler in the context of data work."@en .

<urn:fair-dama-fairmm:alignment:Deliverable> a owl:Class ;
    rdfs:label "Deliverable"@en ;
    skos:definition "A named practice output, preserving the source wording."@en .

<urn:fair-dama-fairmm:alignment:DerivationRule> a owl:Class ;
    rdfs:label "DerivationRule"@en ;
    skos:definition "An explicit reproducible rule for materialized relationships."@en .

<urn:fair-dama-fairmm:alignment:DescriptorEvidence> a owl:Class ;
    rdfs:label "DescriptorEvidence"@en ;
    skos:definition "A source-cited descriptor clause supporting a proposed interpretation."@en .

<urn:fair-dama-fairmm:alignment:EvidenceRequirement> a owl:Class ;
    rdfs:label "EvidenceRequirement"@en ;
    skos:definition "A requirement for evidence, not an observed test result."@en .

<urn:fair-dama-fairmm:alignment:FrameworkVersion> a owl:Class ;
    rdfs:label "FrameworkVersion"@en ;
    skos:definition "An identified edition of the FAIR Maturity Matrix."@en .

<urn:fair-dama-fairmm:alignment:IndirectAlignment> a owl:Class ;
    rdfs:label "IndirectAlignment"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <urn:fair-dama-fairmm:alignment:viaPractice> ;
            owl:someValuesFrom <urn:fair-dama-fairmm:alignment:Practice> ],
        <urn:fair-dama-fairmm:alignment:Alignment> ;
    skos:definition "The practice enables an intermediate practice that provides or verifies the relevant evidence."@en .

<urn:fair-dama-fairmm:alignment:LevelReview> a owl:Class ;
    rdfs:label "LevelReview"@en ;
    skos:definition "A documentary review of a knowledge area at a specified level."@en .

<urn:fair-dama-fairmm:alignment:Persona> a owl:Class ;
    rdfs:label "Persona"@en ;
    skos:definition "A FAIRMM archetypal actor; not an appointed individual."@en .

<urn:fair-dama-fairmm:alignment:PersonaCorrespondence> a owl:Class ;
    rdfs:label "PersonaCorrespondence"@en ;
    skos:definition "A qualified proposed comparison between FAIRMM and DAMA persona entries."@en .

<urn:fair-dama-fairmm:alignment:RoleAssignmentCandidate> a owl:Class ;
    rdfs:label "RoleAssignmentCandidate"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <urn:fair-dama-fairmm:alignment:dataRole> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <urn:fair-dama-fairmm:alignment:fairmmPersona> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <urn:fair-dama-fairmm:alignment:inPractice> ] ;
    skos:definition "A proposed data role for a persona in a specific practice, not an appointment."@en .

<urn:fair-dama-fairmm:alignment:SourceAssertion> a owl:Class ;
    rdfs:label "SourceAssertion"@en ;
    skos:definition "An original FAIR-principle assertion retained in its own source layer."@en .

<urn:fair-dama-fairmm:alignment:SourceField> a owl:Class ;
    rdfs:label "SourceField"@en ;
    skos:definition "An original table field, retaining its heading, position and exact text."@en .

<urn:fair-dama-fairmm:alignment:SourceKnowledgeArea> a owl:Class ;
    rdfs:label "SourceKnowledgeArea"@en ;
    rdfs:subClassOf <urn:fair-dama-fairmm:alignment:SourceTopic> ;
    skos:definition "A numbered core knowledge area in the source catalogue; not an identity assertion with another edition."@en .

<urn:fair-dama-fairmm:alignment:atLevel> a owl:ObjectProperty ;
    rdfs:range <urn:fair-dama-fairmm:alignment:MaturityLevel> .

<urn:fair-dama-fairmm:alignment:dataRole> a owl:ObjectProperty ;
    rdfs:range <urn:fair-dama-fairmm:alignment:DataRole> .

<urn:fair-dama-fairmm:alignment:derivedFromOnset> a owl:ObjectProperty ;
    rdfs:range <urn:fair-dama-fairmm:alignment:OnsetAlignment> .

<urn:fair-dama-fairmm:alignment:fairmmPersona> a owl:ObjectProperty ;
    rdfs:range <urn:fair-dama-fairmm:alignment:Persona> .

<urn:fair-dama-fairmm:alignment:fromPractice> a owl:ObjectProperty ;
    rdfs:range <urn:fair-dama-fairmm:alignment:Practice> .

<urn:fair-dama-fairmm:alignment:inDimension> a owl:ObjectProperty ;
    rdfs:range <urn:fair-dama-fairmm:alignment:Dimension> .

<urn:fair-dama-fairmm:alignment:inPractice> a owl:ObjectProperty ;
    rdfs:range <urn:fair-dama-fairmm:alignment:Practice> .

<urn:fair-dama-fairmm:alignment:precedes> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:comment "Ordering only. This property does not propagate capabilities, establish organisational maturity, or turn levels into subclasses." ;
    rdfs:range <urn:fair-dama-fairmm:alignment:MaturityLevel> .

<urn:fair-dama-fairmm:alignment:viaPractice> a owl:ObjectProperty ;
    rdfs:range <urn:fair-dama-fairmm:alignment:Practice> .

<urn:fair-dama-fairmm:alignment:Dimension> a owl:Class ;
    rdfs:label "Dimension"@en ;
    owl:disjointWith <urn:fair-dama-fairmm:alignment:Descriptor>,
        <urn:fair-dama-fairmm:alignment:MaturityLevel> ;
    skos:definition "A complementary FAIRMM perspective. Individual dimensions form a flat vocabulary."@en .

<urn:fair-dama-fairmm:alignment:OnsetAlignment> a owl:Class ;
    rdfs:label "OnsetAlignment"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <urn:fair-dama-fairmm:alignment:firstSupportedLevel> ],
        <urn:fair-dama-fairmm:alignment:LevelAlignment> ;
    owl:disjointWith <urn:fair-dama-fairmm:alignment:CumulativeAssociation> ;
    skos:definition "A source-backed judgement of the first supported level for a practice contribution."@en .

<urn:fair-dama-fairmm:alignment:firstSupportedLevel> a owl:ObjectProperty ;
    rdfs:range <urn:fair-dama-fairmm:alignment:MaturityLevel> .

<urn:fair-dama-fairmm:alignment:targetsDimension> a owl:ObjectProperty ;
    rdfs:range <urn:fair-dama-fairmm:alignment:Dimension> .

<urn:fair-dama-fairmm:alignment:targetsLevel> a owl:ObjectProperty ;
    rdfs:range <urn:fair-dama-fairmm:alignment:MaturityLevel> .

<urn:fair-dama-fairmm:alignment:LevelAlignment> a owl:Class ;
    rdfs:label "LevelAlignment"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty <urn:fair-dama-fairmm:alignment:targetsDimension> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <urn:fair-dama-fairmm:alignment:targetsLevel> ],
        <urn:fair-dama-fairmm:alignment:Alignment> ;
    skos:definition "An alignment with exactly one maturity-level target."@en .

<urn:fair-dama-fairmm:alignment:SourceTopic> a owl:Class ;
    rdfs:label "SourceTopic"@en ;
    skos:definition "A topic in the source catalogue, retaining its source terminology."@en .

<urn:fair-dama-fairmm:alignment:Alignment> a owl:Class ;
    rdfs:label "Alignment"@en ;
    rdfs:comment "Pattern reuse does not reuse map:fromPractice or map:targetsPrinciple: their FAIR-specific domains and ranges must not classify FAIRMM targets as FAIR subprinciples." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <urn:fair-dama-fairmm:alignment:fromPractice> ] ;
    skos:definition "A qualified proposed assertion connecting a practice to a dimension or maturity level."@en .

<urn:fair-dama-fairmm:alignment:Descriptor> a owl:Class ;
    rdfs:label "Descriptor"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <urn:fair-dama-fairmm:alignment:atLevel> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <urn:fair-dama-fairmm:alignment:inDimension> ] ;
    skos:definition "The source description at one dimension and one maturity level; not a subprinciple."@en .

<urn:fair-dama-fairmm:alignment:MaturityLevel> a owl:Class ;
    rdfs:label "MaturityLevel"@en ;
    owl:disjointWith <urn:fair-dama-fairmm:alignment:Descriptor> ;
    skos:definition "An ordered FAIRMM stage. Individual levels form a flat vocabulary, not a class hierarchy."@en .

<urn:fair-dama-fairmm:alignment:Practice> a owl:Class ;
    rdfs:label "Practice"@en ;
    rdfs:subClassOf <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#Practice> ;
    skos:definition "A DAMA-related or explicitly proposed implementation practice."@en .

