    align:originalContributionType "Direct" ;
    align:primarySource <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1309> ;
    align:rationale "Establish Golden Records (C) \\[source: ReferenceMasterDataManagement!A7:F7\\] — Deliverable: Reliable Reference and Master Data,; Cross-Reference Data,; Data Lineage Reports,; Data Quality Reports.; Explicit partial support for R1.2: Data Lineage Reports can record origins and changes. Inferred support for I3: Cross-Reference Data can become typed references to identified resources; reliable golden records alone do not establish FAIRness. No implementation evidence is supplied." ;
    align:sourceCoordinate "ReferenceMasterDataManagement!A7:L7" ;
    align:sourceLayer "activity_table" ;
    align:targetsPrinciple fair:I3 .

