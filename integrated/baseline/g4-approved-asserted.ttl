    ns1:fieldHeading "Indirect support" ;
    ns1:sourcePosition 10 ;
    ns1:sourceText "Training and communications can improve ethical behavior and awareness, but the image supplies no principle-specific training content." .

ns1:ACT-14-005-field-11 a owl:NamedIndividual,
        ns1:SourceField ;
    rdfs:label "What would demonstrate the supported FAIR requirement"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L2286> ;
    ns1:fieldHeading "What would demonstrate the supported FAIR requirement" ;
    ns1:sourcePosition 11 ;
    ns1:sourceText "Inspect training objectives, materials and attendance as process evidence. Before assigning any FAIR ID, identify explicit FAIR requirements taught and separately test their implementation on resources. Training completion alone does not demonstrate FAIR fulfilment." .

