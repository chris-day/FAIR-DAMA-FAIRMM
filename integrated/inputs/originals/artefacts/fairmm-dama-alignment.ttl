<urn:fair-dama-fairmm:alignment:ONT-AREA-area-alignment/data-handling-ethics/indirect/A1.2> a owl:NamedIndividual,
        align:SourceAssertion ;
    dcterms:identifier "ONT-AREA-area-alignment/data-handling-ethics/indirect/A1.2" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/dama-ontologies-v1.1.0/dama-fair-mapping.ttl> ;
    align:applicabilityCondition "Area-level proposal retained separately from activity and summary classifications." ;
    align:derivedFromSourceNode <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#area-alignment/data-handling-ethics/indirect/A1.2> ;
    align:existingContributionType "Indirect" ;
    align:inSourceTopic align:AREA-14 ;
    align:originalContributionType "Indirect" ;
    align:primarySource <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/dama-ontologies-v1.1.0/dama-fair-mapping.ttl> ;
    align:rationale "Review can identify gaps in authorized access and permitted reuse if the review criteria explicitly include them. Risk assessment can establish requirements for controlled access and clear reuse permissions; neither requirement is specified by the activity label alone. The strategy can commission authentication, authorization and resource-specific usage licensing when those obligations are explicitly stated. Remediation can address gaps in access controls and reuse permissions only where those gaps and the affected resources are identified. Mitigation can commission access-authorization and reuse-permission controls when the ethical risk assessment identifies those specific requirements. Monitoring can sustain explicitly defined authorization and licensing controls. General ethics compliance incidents do not establish a FAIR-specific result." ;
    align:sourceLayer "ontology_area_assessment" ;
    align:targetsPrinciple fair:A1.2 .

<urn:fair-dama-fairmm:alignment:ONT-AREA-area-alignment/data-handling-ethics/indirect/R1.1> a owl:NamedIndividual,
