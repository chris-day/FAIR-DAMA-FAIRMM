<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/DataHandlingEthics/row-2> a owl:NamedIndividual,
        ns4:SourceActivity ;
    rdfs:label "Review Data-Handling Practices"@en ;
    dcterms:identifier "DataHandlingEthics!A2:L2" ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/assets/01_DataHandlingEthics.webp>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/outputs/dama-20261116/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#DataHandlingEthics!A2:L2> ;
    ns4:alignmentBasis "Activity-derived proposal; source image plus interpreted associations"@en ;
    ns4:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns4:deliverables "Current Practices and Gaps"@en ;
    ns4:directSupportExplanation "No direct FAIR requirement is established by this ethical-practice activity or its named deliverables. Ethical responsibility and FAIR fulfilment are related but distinct."@en ;
    ns4:evidenceRequirement "Inspect approved policy or control requirements that explicitly distinguish access authorization from permitted reuse. Test any resulting authentication and authorization procedure for identified resources (A1.2) and inspect the clear, accessible usage licence attached to data and metadata (R1.1). An ethics statement, privacy notice or generic compliance metric alone is insufficient."@en ;
    ns4:inTopic ns2:DataHandlingEthics ;
    ns4:indirectSupportExplanation "Review can identify gaps in authorized access and permitted reuse if the review criteria explicitly include them."@en ;
    ns4:lifecycleCode "P"@en ;
    ns4:proposedApprovingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-governance-bodies> ;
    ns4:proposedContributingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-providers>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-stewards>,
