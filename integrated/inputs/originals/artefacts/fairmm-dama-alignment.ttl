    align:rationale "Manage Users, Passwords and Group Membership (C) \\[source: DataSecurityManagement!A6:F6\\] — Deliverable: User Accounts, Passwords,Role Groups.; Inferred support: user accounts, passwords and role groups can supply authentication and authorisation when applied within a data/metadata retrieval protocol. Generic database security, credential management or access monitoring alone does not establish A1.2. No implementation evidence is supplied." ;
    align:sourceCoordinate "DataSecurityManagement!A6:L6" ;
    align:sourceLayer "activity_table" ;
    align:targetsPrinciple fair:A1.2 .

align:ACT-05-005-indirect-A1.2 a owl:NamedIndividual,
        align:SourceAssertion ;
