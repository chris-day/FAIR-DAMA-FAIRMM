    rdfs:label "FAIR principles supported"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1727> ;
    align:fieldHeading "FAIR principles supported" ;
    align:sourcePosition 8 ;
    align:sourceText "F4 — registration/indexing in a searchable resource; R1 — multiple accurate, relevant descriptive attributes; R1.2 — detailed provenance associated with data and metadata" .

align:ACT-09-009-field-9 a owl:NamedIndividual,
        align:SourceField ;
    rdfs:label "How they can support FAIR"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1727> ;
    align:fieldHeading "How they can support FAIR" ;
    align:sourcePosition 9 ;
    align:sourceText "Query, Report and Analyse Metadata (O)  \\[source: MetadataManagement!A10:F10\\] — Deliverable: Quality Metadata, Metadata Management Operational Analysis, Metadata Analysis,; Data Lineage,; Change Impact Analysis.; Explicit partial support: metadata query/reporting supports discovery, quality metadata supports reuse descriptions, and the named Data Lineage deliverable supports provenance. Search indexing, rich accurate attributes and detailed associated lineage remain to be verified. No implementation evidence is supplied." .

