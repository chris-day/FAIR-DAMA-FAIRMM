ns1:WB-ACT-08-002-direct-A1 a owl:NamedIndividual,
        ns1:SourceAssertion ;
    dcterms:identifier "WB-ACT-08-002-direct-A1" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#DocumentContentManagement!A3:L3> ;
    ns1:existingContributionType "Direct" ;
    ns1:hasPractice ns1:ACT-08-002 ;
    ns1:inSourceTopic ns1:AREA-08 ;
    ns1:originalContributionType "Direct" ;
    ns1:primarySource <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#DocumentContentManagement!A3:L3> ;
    ns1:rationale """Implement Document / Record Management Systems for Acquisition, Storage, Access, and Security Controls (O, C) [source: DocumentContentManagement!A3:F3] — Deliverable: Document / Record Management Systems (including image and e-mail systems), Portals,Paper and Electronic Documents (text, graphics, images, audio, video).
Inferred support: access and security controls in electronic document systems can implement identifier-based protocol retrieval and authorisation. Paper documents, storage or portals alone do not meet those requirements. No implementation evidence is supplied.""" ;
    ns1:sourceCoordinate "DocumentContentManagement!A3:L3" ;
    ns1:sourceLayer "workbook_activity_table" ;
    ns1:targetsPrinciple <https://w3id.org/fair/principles/terms/A1> .

