    align:fieldHeading "Indirect support" ;
    align:sourcePosition 10 ;
    align:sourceText "Communications can make discovery and reuse context available if findings are accompanied by accurate descriptions linked to the analytical resources." .

align:ACT-13-008-field-11 a owl:NamedIndividual,
        align:SourceField ;
    rdfs:label "What would demonstrate the supported FAIR requirement"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L2169> ;
    align:fieldHeading "What would demonstrate the supported FAIR requirement" ;
    align:sourcePosition 11 ;
    align:sourceText "Inspect resource-linked discovery and reuse descriptions covering meaning, methods, coverage, assumptions and limitations. A presentation without associated resource descriptions is insufficient." .

