    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L2286> ;
    align:fieldHeading "Activities" ;
    align:sourcePosition 1 ;
    align:sourceText "Execute the Training and Communications Plan" .

align:ACT-14-005-field-10 a owl:NamedIndividual,
        align:SourceField ;
    rdfs:label "Indirect support"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L2286> ;
    align:fieldHeading "Indirect support" ;
    align:sourcePosition 10 ;
    align:sourceText "Training and communications can improve ethical behavior and awareness, but the image supplies no principle-specific training content." .

align:ACT-14-005-field-11 a owl:NamedIndividual,
        align:SourceField ;
    rdfs:label "What would demonstrate the supported FAIR requirement"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L2286> ;
    align:fieldHeading "What would demonstrate the supported FAIR requirement" ;
    align:sourcePosition 11 ;
    align:sourceText "Inspect training objectives, materials and attendance as process evidence. Before assigning any FAIR ID, identify explicit FAIR requirements taught and separately test their implementation on resources. Training completion alone does not demonstrate FAIR fulfilment." .

align:ACT-14-005-field-12 a owl:NamedIndividual,
