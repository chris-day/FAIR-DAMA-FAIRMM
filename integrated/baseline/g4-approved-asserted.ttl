ns1:WB-ACT-04-008-indirect-A2 a owl:NamedIndividual,
        ns1:SourceAssertion ;
    dcterms:identifier "WB-ACT-04-008-indirect-A2" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#DataOperationsManagement!A9:L9> ;
    ns1:existingContributionType "Indirect" ;
