ns1:ACT-08-002-field-9 a owl:NamedIndividual,
        ns1:SourceField ;
    rdfs:label "How they can support FAIR"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1578> ;
    ns1:fieldHeading "How they can support FAIR" ;
    ns1:sourcePosition 9 ;
    ns1:sourceText "Implement Document / Record Management Systems for Acquisition, Storage, Access, and Security Controls (O, C) \\[source: DocumentContentManagement!A3:F3\\] — Deliverable: Document / Record Management Systems (including image and e-mail systems), Portals,Paper and Electronic Documents (text, graphics, images, audio, video).; Inferred support: access and security controls in electronic document systems can implement identifier-based protocol retrieval and authorisation. Paper documents, storage or portals alone do not meet those requirements. No implementation evidence is supplied." .

