    ns1:fieldHeading "FAIR principles supported" ;
    ns1:sourcePosition 8 ;
    ns1:sourceText "F4 — registration/indexing in a searchable resource; R1 — multiple accurate, relevant descriptive attributes; R1.2 — detailed provenance associated with data and metadata" .

ns1:ACT-09-009-field-9 a owl:NamedIndividual,
        ns1:SourceField ;
    rdfs:label "How they can support FAIR"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1727> ;
    ns1:fieldHeading "How they can support FAIR" ;
    ns1:sourcePosition 9 ;
    ns1:sourceText "Query, Report and Analyse Metadata (O)  \\[source: MetadataManagement!A10:F10\\] — Deliverable: Quality Metadata, Metadata Management Operational Analysis, Metadata Analysis,; Data Lineage,; Change Impact Analysis.; Explicit partial support: metadata query/reporting supports discovery, quality metadata supports reuse descriptions, and the named Data Lineage deliverable supports provenance. Search indexing, rich accurate attributes and detailed associated lineage remain to be verified. No implementation evidence is supplied." .

