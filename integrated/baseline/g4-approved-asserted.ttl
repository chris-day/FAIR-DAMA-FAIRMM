ns1:Persona-Reference_Data_Manager a owl:NamedIndividual,
        ns1:Persona ;
    rdfs:label "Reference_Data_Manager"@en ;
    dcterms:identifier "Reference_Data_Manager" ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/FAIR_personas/Reference_Data_Manager.md> ;
    skos:definition "A Reference Data Manager is responsible for overseeing the management, quality, and governance of reference data within an organization. This role ensures that reference data (such as codes, classifications, and standard lists) is accurate, consistent, and aligned with business needs. The Reference Data Manager defines data standards, maintains master/reference data sets, monitors data quality, and implements processes that ensure data is FAIR. They collaborate with business units, data stewards, and technology teams to support data governance, resolve data issues, and enable reliable analytics and reporting." ;
    ns1:inFrameworkVersion ns1:FAIRMM-v1.2.5 ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/FAIR_personas/Reference_Data_Manager.md> ;
    ns1:sourceText "A Reference Data Manager is responsible for overseeing the management, quality, and governance of reference data within an organization. This role ensures that reference data (such as codes, classifications, and standard lists) is accurate, consistent, and aligned with business needs. The Reference Data Manager defines data standards, maintains master/reference data sets, monitors data quality, and implements processes that ensure data is FAIR. They collaborate with business units, data stewards, and technology teams to support data governance, resolve data issues, and enable reliable analytics and reporting." .

