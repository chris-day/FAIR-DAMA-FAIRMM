ns1:ACT-02-002-field-8 a owl:NamedIndividual,
        ns1:SourceField ;
    rdfs:label "FAIR principles supported"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L751> ;
    ns1:fieldHeading "FAIR principles supported" ;
    ns1:sourcePosition 8 ;
    ns1:sourceText "I1 — formal, accessible, shared knowledge representation; I2 — use of vocabularies that follow FAIR principles; I3 — qualified references to other data or metadata" .

ns1:ACT-02-002-field-9 a owl:NamedIndividual,
        ns1:SourceField ;
    rdfs:label "How they can support FAIR"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L751> ;
    ns1:fieldHeading "How they can support FAIR" ;
    ns1:sourcePosition 9 ;
    ns1:sourceText "Develop and Maintain the Enterprise Data Model (P) This will be the Enterprise Ontology and Knowledge Graph \\[source: DataArchitectureManagement!A3:F3\\] — Deliverable: Enterprise Data Model: Subject Area Model, Conceptual Model, Logical Model, Glossary.; Inferred support: the stated enterprise ontology/knowledge graph can implement shared formal representation, FAIR vocabulary use and qualified links. The deliverable also lists conceptual/logical models and a glossary, which alone do not establish these properties. No implementation evidence is supplied." .

