ns1:ACT-02-007-indirect-F1 a owl:NamedIndividual,
        ns1:SourceAssertion ;
    dcterms:identifier "ACT-02-007-indirect-F1" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L756> ;
    ns1:existingContributionType "Indirect" ;
    ns1:hasPractice ns1:ACT-02-007 ;
    ns1:inSourceTopic ns1:AREA-02 ;
    ns1:originalContributionType "Indirect" ;
    ns1:primarySource <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L756> ;
    ns1:rationale "Indirect support: Architecture ownership and review can align implemented resources with agreed FAIR representations and service requirements. Namespace governance can enable F1 only if identifiers for data and metadata are globally unique and persistent; XML namespaces alone do not establish F1." ;
    ns1:sourceCoordinate "DataArchitectureManagement!A8:L8" ;
    ns1:sourceIntermediatePractice ns1:practice-25ecb81d4976e4cbdd631eb3 ;
    ns1:sourceLayer "activity_table" ;
    ns1:targetsPrinciple <https://w3id.org/fair/principles/terms/F1> .

ns1:ACT-04-002-indirect-R1.1 a owl:NamedIndividual,
        ns1:SourceAssertion ;
    dcterms:identifier "ACT-04-002-indirect-R1.1" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1039> ;
    ns1:existingContributionType "Indirect" ;
    ns1:hasPractice ns1:ACT-04-002 ;
    ns1:inSourceTopic ns1:AREA-04 ;
    ns1:originalContributionType "Indirect" ;
    ns1:primarySource <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1039> ;
    ns1:rationale "Indirect support: Operations, availability and change management can sustain FAIR infrastructure where the relevant services are commissioned. Acquisition procedures can capture origin (R1.2) and establish release rights (R1.1), but neither is specified by the externally sourced data deliverable." ;
    ns1:sourceCoordinate "DataOperationsManagement!A3:L3" ;
    ns1:sourceIntermediatePractice ns1:practice-830aee39630a29a057b0854a ;
    ns1:sourceLayer "activity_table" ;
    ns1:targetsPrinciple <https://w3id.org/fair/principles/terms/R1.1> .

