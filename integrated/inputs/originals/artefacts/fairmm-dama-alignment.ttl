    align:rationale "Ingestion can capture resource descriptions, source versions, acquisition times and transformations if metadata capture is added as an explicit requirement." ;
    align:sourceIntermediatePractice map:PublishRichDiscoveryMetadata ;
    align:sourceLayer "ontology_contribution" ;
    align:targetsPrinciple fair:F2 .

