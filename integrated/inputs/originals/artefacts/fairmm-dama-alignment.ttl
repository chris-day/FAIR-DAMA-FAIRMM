<urn:fair-dama-fairmm:alignment:ONT-contribution/BigDataDataScience/row-2/indirect/R1.3> a owl:NamedIndividual,
        align:SourceAssertion ;
    dcterms:identifier "ONT-contribution/BigDataDataScience/row-2/indirect/R1.3" ;
