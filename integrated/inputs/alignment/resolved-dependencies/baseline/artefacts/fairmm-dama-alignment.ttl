ns1:evidence-e40b298ee7a5e939df85b82a a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L171> ;
    ns1:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L171> ;
    ns1:rationale "The named deliverable may address the D6 aspect of these clauses when its applicability condition is met." ;
    ns1:sourceText "The Community of Practice drives domain knowledge through the common understanding and interpretation of data and its context." ;
    ns1:supportedByDescriptor ns1:D6-L3 ;
    ns1:supportsInterpretation ns1:interpretation-5c1ca28f608f20a249f202d5 .

ns1:evidence-e6dfe0846365d6f3da2ac6c1 a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L164> ;
    ns1:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L164> ;
    ns1:rationale "The named deliverable may address the D6 aspect of these clauses when its applicability condition is met." ;
    ns1:sourceText "Community of practice also forms internally and facilitates knowledge exchanges ( for example, exchanges around emerging/good practices for FAIR and data Stewardship )." ;
    ns1:supportedByDescriptor ns1:D6-L2 ;
    ns1:supportsInterpretation ns1:interpretation-c396f8c5683c7cab6c5a873b .

