<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/BigDataDataScience/row-10/indirect/A1> a owl:NamedIndividual,
        ns4:IndirectContribution ;
    rdfs:label "Deploy and Monitor → A1"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/outputs/dama-20261116/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A10:L10> ;
    ns4:alignmentBasis "Activity-derived proposal"@en ;
    ns4:applicabilityCondition "Test standardized retrieval of identified resources and inspect version-linked deployment and execution provenance. Monitoring predictive accuracy or infrastructure utilization alone is insufficient."@en ;
    ns4:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns4:evidenceRequirement "Test standardized retrieval of identified resources and inspect version-linked deployment and execution provenance. Monitoring predictive accuracy or infrastructure utilization alone is insufficient."@en ;
    ns4:fromPractice <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-10> ;
    ns4:rationale "Operations can sustain identifier-based access and record versioned inputs, model changes and execution history when those controls are explicitly included in the operations plan."@en ;
    ns4:targetsPrinciple <https://w3id.org/fair/principles/terms/A1> ;
    ns4:viaPractice ns4:EnableIdentifierBasedRetrieval .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/BigDataDataScience/row-10/indirect/R1.2> a owl:NamedIndividual,
        ns4:IndirectContribution ;
    rdfs:label "Deploy and Monitor → R1.2"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/outputs/dama-20261116/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A10:L10> ;
    ns4:alignmentBasis "Activity-derived proposal"@en ;
    ns4:applicabilityCondition "Test standardized retrieval of identified resources and inspect version-linked deployment and execution provenance. Monitoring predictive accuracy or infrastructure utilization alone is insufficient."@en ;
    ns4:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns4:evidenceRequirement "Test standardized retrieval of identified resources and inspect version-linked deployment and execution provenance. Monitoring predictive accuracy or infrastructure utilization alone is insufficient."@en ;
    ns4:fromPractice <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-10> ;
    ns4:rationale "Operations can sustain identifier-based access and record versioned inputs, model changes and execution history when those controls are explicitly included in the operations plan."@en ;
    ns4:targetsPrinciple <https://w3id.org/fair/principles/terms/R1.2> ;
    ns4:viaPractice ns4:PublishProvenance .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/BigDataDataScience/row-2/indirect/R1.3> a owl:NamedIndividual,
        ns4:IndirectContribution ;
    rdfs:label "Define Big Data Strategy & Business Needs → R1.3"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/outputs/dama-20261116/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A2:L2> ;
    ns4:alignmentBasis "Activity-derived proposal"@en ;
    ns4:applicabilityCondition "Inspect approved standards and their domain relevance, then validate actual data and metadata against the applicable community specifications. Strategy approval alone does not demonstrate conformance."@en ;
    ns4:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns4:evidenceRequirement "Inspect approved standards and their domain relevance, then validate actual data and metadata against the applicable community specifications. Strategy approval alone does not demonstrate conformance."@en ;
    ns4:fromPractice <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-2> ;
    ns4:rationale "Standards selection can commission domain-relevant community conformance if named external standards, versions and acceptance tests are explicitly adopted. Internal IT standards alone are insufficient."@en ;
    ns4:targetsPrinciple <https://w3id.org/fair/principles/terms/R1.3> ;
    ns4:viaPractice ns4:ValidateCommunityStandards .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/BigDataDataScience/row-3/indirect/A1> a owl:NamedIndividual,
        ns4:IndirectContribution ;
    rdfs:label "Establish Big Data Environments → A1"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/outputs/dama-20261116/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A3:L3> ;
    ns4:alignmentBasis "Activity-derived proposal"@en ;
    ns4:applicabilityCondition "Test retrieval of identified data and metadata through a specified standard protocol; inspect freely implementable protocol specifications; test required authentication and authorization. Platform availability alone is insufficient."@en ;
    ns4:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns4:evidenceRequirement "Test retrieval of identified data and metadata through a specified standard protocol; inspect freely implementable protocol specifications; test required authentication and authorization. Platform availability alone is insufficient."@en ;
    ns4:fromPractice <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-3> ;
    ns4:rationale "Platform design can enable standardized retrieval, open protocols and controlled access if these are explicitly commissioned and implemented."@en ;
    ns4:targetsPrinciple <https://w3id.org/fair/principles/terms/A1> ;
    ns4:viaPractice ns4:EnableIdentifierBasedRetrieval .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/BigDataDataScience/row-3/indirect/A1.1> a owl:NamedIndividual,
