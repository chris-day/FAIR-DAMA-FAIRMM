    rdfs:label "contributing roles"@en .

ns1:D1-L2 a owl:NamedIndividual,
        ns1:Descriptor ;
    rdfs:label "FAIR Data at L2"@en ;
    dcterms:identifier "D1-L2" ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L65> ;
    rdfs:comment "Data is catalogued and conforms to local or system-specific models, with system-level access controls. It may reside in a data lake, but alignment to shared domain models is incomplete and technical and subject expertise are still needed."@en ;
    ns1:atLevel ns1:L2 ;
    ns1:evidenceStatus "not assessed" ;
    ns1:fullSourceBlock """Data, conformed to a local model, is cataloged (i.e. a metadata record of existence is created), and data resides in a data lake.

    At the organization level, data is conformed system-by-system and may not map to a domain data model.

    Controls on access at the system level.

    Requires average level technical and subject matter knowledge to use. ( for example the role of [Data Scientist](FAIR_personas/Data_Scientist.md) )

    **[(Back to the FAIR Matrix)](FAIRMaturityMatrix.md)**""" ;
    ns1:hasInterpretation ns1:interpretation-3274cdfbdc42954c91e6d497,
        ns1:interpretation-549c9c0d2b3e466952f6e5b9,
        ns1:interpretation-58bc492081d70375669d2f9d,
        ns1:interpretation-593d64d7f6bf4d1bdabf8d9f,
        ns1:interpretation-879a44b9d756071d1282671e,
        ns1:interpretation-8efd51fd72a7d13c61970b3a,
        ns1:interpretation-92d804181643d1e89c26b0b6,
        ns1:interpretation-f62126d26227360f8600304c,
        ns1:interpretation-fbf6fadfc5d28ef145e65cb3,
        ns1:interpretation-fd7721dacdcc93aba7a51913 ;
    ns1:inDimension ns1:D1 ;
    ns1:inFrameworkVersion ns1:FAIRMM-v1.2.5 ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L65> .

