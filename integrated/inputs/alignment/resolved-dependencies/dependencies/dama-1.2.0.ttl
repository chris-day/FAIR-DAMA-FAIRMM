dcterms:creator a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:hasPart a owl:ObjectProperty .

dcterms:identifier a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:modified a owl:AnnotationProperty .

dcterms:partOf a owl:AnnotationProperty .

dcterms:rights a owl:AnnotationProperty .

dcterms:source a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

<http://semanticscience.org/resource/000090> a owl:Class .

skos:definition a owl:AnnotationProperty .

ns3:AreaAlignmentAssessment a owl:Class .

ns3:AssignProvenanceResponsibility a owl:NamedIndividual,
        ns3:Practice ;
    rdfs:label "Assign responsibility for documenting provenance"@en ;
    ns3:inKnowledgeArea ns2:DataGovernance .

ns3:AttachUsageLicense a owl:NamedIndividual,
        ns3:Practice ;
    rdfs:label "Attach a usage license to the published data or metadata"@en ;
    ns3:inKnowledgeArea ns2:MetadataManagement .

ns3:ConfigureRetrievalAuthorization a owl:NamedIndividual,
        ns3:Practice ;
    rdfs:label "Configure authentication and authorization for retrieval"@en ;
    ns3:inKnowledgeArea ns2:DataSecurity .

ns3:DirectContribution a owl:Class .

ns3:EnableIdentifierBasedRetrieval a owl:NamedIndividual,
        ns3:Practice ;
    rdfs:label "Implement retrieval by identifier through a standardized protocol"@en ;
    ns3:inKnowledgeArea ns2:DataIntegrationAndInteroperability .

ns3:FAIRContribution a owl:Class .

ns3:ImplementOpenRetrievalProtocol a owl:NamedIndividual,
        ns3:Practice ;
    rdfs:label "Implement an open, free, universally implementable retrieval protocol"@en ;
    ns3:inKnowledgeArea ns2:DataIntegrationAndInteroperability .

ns3:IncludeDatasetIdentifier a owl:NamedIndividual,
        ns3:Practice ;
    rdfs:label "Include the dataset identifier in its metadata"@en ;
    ns3:inKnowledgeArea ns2:MetadataManagement .

ns3:IndexInSearchableCatalog a owl:NamedIndividual,
        ns3:Practice ;
    rdfs:label "Index data or metadata in a searchable catalog"@en ;
    ns3:inKnowledgeArea ns2:MetadataManagement .

ns3:IndirectContribution a owl:Class .

ns3:PublishProvenance a owl:NamedIndividual,
        ns3:Practice ;
    rdfs:label "Publish detailed dataset provenance"@en ;
    ns3:inKnowledgeArea ns2:MetadataManagement .

ns3:PublishQualifiedResourceReferences a owl:NamedIndividual,
        ns3:Practice ;
    rdfs:label "Publish explicit typed references to related identified resources"@en ;
    ns3:inKnowledgeArea ns2:MetadataManagement .

ns3:PublishRichDiscoveryMetadata a owl:NamedIndividual,
        ns3:Practice ;
    rdfs:label "Publish rich resource discovery descriptions"@en ;
    ns3:inKnowledgeArea ns2:MetadataManagement .

ns3:PublishRichReuseDescriptions a owl:NamedIndividual,
        ns3:Practice ;
    rdfs:label "Publish accurate and relevant resource descriptions for reuse"@en ;
    ns3:inKnowledgeArea ns2:MetadataManagement .

ns3:PublishSharedRepresentation a owl:NamedIndividual,
        ns3:Practice ;
    rdfs:label "Publish data or metadata in a shared representation"@en ;
    ns3:inKnowledgeArea ns2:DataIntegrationAndInteroperability .

ns3:SetDataSecurityPolicy a owl:NamedIndividual,
        ns3:Practice ;
    rdfs:label "Set a data security policy"@en ;
    ns3:inKnowledgeArea ns2:DataSecurity .

ns3:SetLicensingPolicy a owl:NamedIndividual,
        ns3:Practice ;
    rdfs:label "Set a data licensing policy"@en ;
    ns3:inKnowledgeArea ns2:DataGovernance .

ns3:ValidateCommunityStandards a owl:NamedIndividual,
        ns3:Practice ;
    rdfs:label "Validate resources against applicable domain community standards"@en ;
    ns3:inKnowledgeArea ns2:DataQualityManagement .

