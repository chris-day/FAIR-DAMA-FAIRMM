<urn:fair-dama-fairmm:alignment:ONT-AREA-area-alignment/big-data-data-science/indirect/R1.2> a owl:NamedIndividual,
        ns1:SourceAssertion ;
    dcterms:identifier "ONT-AREA-area-alignment/big-data-data-science/indirect/R1.2" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/dama-ontologies-v1.1.0/dama-fair-mapping.ttl> ;
    ns1:applicabilityCondition "Area-level proposal retained separately from activity and summary classifications." ;
    ns1:derivedFromSourceNode <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#area-alignment/big-data-data-science/indirect/R1.2> ;
    ns1:existingContributionType "Indirect" ;
    ns1:inSourceTopic ns1:AREA-13 ;
    ns1:originalContributionType "Indirect" ;
    ns1:primarySource <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/dama-ontologies-v1.1.0/dama-fair-mapping.ttl> ;
    ns1:rationale "Source evaluation can record origin, permitted reuse and descriptive context, enabling provenance and licensing requirements when resource-linked records and accessible terms are retained. Ingestion can capture resource descriptions, source versions, acquisition times and transformations if metadata capture is added as an explicit requirement. Versioned methods and input records can enable provenance when linked to the resulting data and model outputs. Integration can preserve provenance and implement explicit semantic representations and typed links when these requirements are included in the integration design. Exploration can enrich reuse descriptions and provenance if assumptions, limitations, source versions, model versions and analytical steps are recorded with the resulting resources. Operations can sustain identifier-based access and record versioned inputs, model changes and execution history when those controls are explicitly included in the operations plan." ;
    ns1:sourceLayer "ontology_area_assessment" ;
    ns1:targetsPrinciple <https://w3id.org/fair/principles/terms/R1.2> .

