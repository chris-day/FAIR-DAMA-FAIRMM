ns1:ACT-14-006-field-1 a owl:NamedIndividual,
        ns1:SourceField ;
    rdfs:label "Activities"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L2287> ;
    ns1:fieldHeading "Activities" ;
    ns1:sourcePosition 1 ;
    ns1:sourceText "Implement Risk Mitigation" .

ns1:ACT-14-006-field-10 a owl:NamedIndividual,
        ns1:SourceField ;
    rdfs:label "Indirect support"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L2287> ;
    ns1:fieldHeading "Indirect support" ;
    ns1:sourcePosition 10 ;
    ns1:sourceText "Mitigation can commission access-authorization and reuse-permission controls when the ethical risk assessment identifies those specific requirements." .

ns1:ACT-14-006-field-11 a owl:NamedIndividual,
        ns1:SourceField ;
    rdfs:label "What would demonstrate the supported FAIR requirement"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L2287> ;
    ns1:fieldHeading "What would demonstrate the supported FAIR requirement" ;
    ns1:sourcePosition 11 ;
    ns1:sourceText "Inspect approved policy or control requirements that explicitly distinguish access authorization from permitted reuse. Test any resulting authentication and authorization procedure for identified resources (A1.2) and inspect the clear, accessible usage licence attached to data and metadata (R1.1). An ethics statement, privacy notice or generic compliance metric alone is insufficient." .

