align:ACT-08-002-field-11 a owl:NamedIndividual,
        align:SourceField ;
    rdfs:label "What would demonstrate the supported FAIR requirement"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1578> ;
    align:fieldHeading "What would demonstrate the supported FAIR requirement" ;
    align:sourcePosition 11 ;
    align:sourceText "A1: Starting with an identifier, retrieve representative data and metadata through a documented standard communications protocol; test each separately, including permitted restricted access. A portal, distribution process or accessible database alone is insufficient.; A1.2: Test retrieval of identified data and metadata through the declared protocol with authorised, unauthorised and unauthenticated requests. Verify the documented authentication/authorisation procedure and expected decisions; unrestricted public access is not required.; Supporting-process evidence: inspect the named deliverable and its approval/maintenance records separately from the resource tests." .

