ns1:deliverables a owl:AnnotationProperty ;
    rdfs:label "deliverables"@en .

ns1:derivedFromActivity a owl:ObjectProperty ;
    rdfs:label "derived from source activity"@en ;
    rdfs:domain ns1:AreaAlignmentAssessment ;
    rdfs:range ns1:SourceActivity .

ns1:directSupportExplanation a owl:AnnotationProperty ;
    rdfs:label "direct support explanation"@en .

ns1:evidenceForPrinciple a owl:ObjectProperty ;
    rdfs:label "provides evidence for principle"@en ;
    rdfs:domain ns1:Practice ;
    rdfs:range <https://w3id.org/fair/principles/terms/FAIR-SubPrinciple> .

ns1:evidenceRequirement a owl:AnnotationProperty ;
    rdfs:label "evidence requirement"@en .

ns1:fromTopic a owl:ObjectProperty ;
    rdfs:label "from management topic"@en ;
    rdfs:domain ns1:AreaAlignmentAssessment ;
    rdfs:range <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#ManagementTopic> .

ns1:inKnowledgeArea a owl:ObjectProperty ;
    rdfs:domain ns1:Practice ;
    rdfs:range <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#KnowledgeArea> ;
    rdfs:subPropertyOf ns1:inTopic .

ns1:indirectSupportExplanation a owl:AnnotationProperty ;
    rdfs:label "indirect support explanation"@en .

ns1:lifecycleCode a owl:AnnotationProperty ;
    rdfs:label "lifecycle code"@en .

ns1:proposedApprovingPersona a owl:ObjectProperty ;
    rdfs:label "proposed approving persona"@en ;
    rdfs:domain ns1:SourceActivity ;
    rdfs:range <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#Persona> .

ns1:proposedContributingPersona a owl:ObjectProperty ;
    rdfs:label "proposed contributing persona"@en ;
    rdfs:domain ns1:SourceActivity ;
    rdfs:range <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#Persona> .

ns1:proposedResponsiblePersona a owl:ObjectProperty ;
    rdfs:label "proposed responsible persona"@en ;
    rdfs:domain ns1:SourceActivity ;
    rdfs:range <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#Persona> .

ns1:rationale a owl:AnnotationProperty .

ns1:relevantDeliverables a owl:AnnotationProperty ;
    rdfs:label "relevant deliverables"@en .

ns1:sourceRow a owl:AnnotationProperty ;
    rdfs:label "source row"@en .

ns1:sourceWorksheet a owl:AnnotationProperty ;
    rdfs:label "source worksheet"@en .

