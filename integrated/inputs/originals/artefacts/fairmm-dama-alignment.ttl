<urn:fair-dama-fairmm:alignment:ONT-contribution/BigDataDataScience/row-4/indirect/R1.1> a owl:NamedIndividual,
        align:SourceAssertion ;
    dcterms:identifier "ONT-contribution/BigDataDataScience/row-4/indirect/R1.1" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/dama-ontologies-v1.1.0/dama-fair-mapping.ttl> ;
    align:applicabilityCondition "Trace selected source versions to providers and acquisition context; inspect accessible usage licences linked to each resource. A commercial purchase or access agreement alone is not a FAIR usage licence." ;
    align:derivedFromSourceNode <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/BigDataDataScience/row-4/indirect/R1.1> ;
    align:existingContributionType "Indirect" ;
    align:hasPractice <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-4> ;
    align:inSourceTopic align:AREA-13 ;
    align:originalContributionType "Indirect" ;
    align:primarySource <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/dama-ontologies-v1.1.0/dama-fair-mapping.ttl> ;
    align:rationale "Source evaluation can record origin, permitted reuse and descriptive context, enabling provenance and licensing requirements when resource-linked records and accessible terms are retained." ;
    align:sourceIntermediatePractice map:AttachUsageLicense ;
    align:sourceLayer "ontology_contribution" ;
    align:targetsPrinciple fair:R1.1 .

