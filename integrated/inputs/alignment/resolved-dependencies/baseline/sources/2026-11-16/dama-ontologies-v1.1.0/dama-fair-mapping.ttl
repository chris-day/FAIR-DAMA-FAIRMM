    ns1:rationale "Integration can preserve provenance and implement explicit semantic representations and typed links when these requirements are included in the integration design."@en ;
    ns1:targetsPrinciple <https://w3id.org/fair/principles/terms/I3> ;
    ns1:viaPractice ns1:PublishQualifiedResourceReferences .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/BigDataDataScience/row-7/indirect/R1.2> a owl:NamedIndividual,
        ns1:IndirectContribution ;
    rdfs:label "Integrate/Align Data For Analysis → R1.2"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/outputs/dama-20261116/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A7:L7> ;
