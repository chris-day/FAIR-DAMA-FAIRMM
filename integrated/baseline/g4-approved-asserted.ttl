    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/FAIR_personas/Researcher.md> ;
    ns1:sourceText "A person engaged in conducting research, possibly recognized as an occupation by a formal job title. While a researchers produces and uses data, they are not necessarily data scientists (see: data scientist)." .

