<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#area-alignment/big-data-data-science/indirect/F2> a owl:NamedIndividual,
        ns4:AreaAlignmentAssessment ;
    rdfs:label "Big Data & Data Science → F2 (Indirect)"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA_FAIR_Sankey_v1.3.0.zip> ;
    ns4:alignedPrinciple <https://w3id.org/fair/principles/terms/F2> ;
    ns4:alignmentBasis "Activity-derived proposal (additional topic)"@en ;
    ns4:alignmentType "Indirect" ;
    ns4:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns4:deliverables "Acquired Data Sources; Data Insights and Findings"@en ;
    ns4:derivedFromActivity <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-5>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-9> ;
    ns4:fromTopic ns2:BigDataAndDataScience ;
    ns4:rationale "Ingestion can capture resource descriptions, source versions, acquisition times and transformations if metadata capture is added as an explicit requirement. Communications can make discovery and reuse context available if findings are accompanied by accurate descriptions linked to the analytical resources."@en .

