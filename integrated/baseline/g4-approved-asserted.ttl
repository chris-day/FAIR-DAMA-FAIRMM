    skos:definition "Organizes, standardises, integrates, and maintains ontologies, vocabularies, datasets and data products to ensure they are FAIR and aligned with governance standards." ;
    ns1:inFrameworkVersion ns1:FAIRMM-v1.2.5 ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/FAIR_personas/Curator.md> ;
