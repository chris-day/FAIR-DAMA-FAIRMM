        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/it-executives>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/subject-matter-experts> ;
    ns1:proposedResponsiblePersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-governance-bodies>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/dm-services> ;
    ns1:relevantDeliverables "Updated Policies; Aligned Incentives, KPIs, and Targets"@en ;
    ns1:sourceRow 7 ;
    ns1:sourceWorksheet "DataHandlingEthics" .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/DataHandlingEthics/row-8> a owl:NamedIndividual,
        ns1:SourceActivity ;
    rdfs:label "Implement Monitoring Plan"@en ;
    dcterms:identifier "DataHandlingEthics!A8:L8" ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/assets/01_DataHandlingEthics.webp>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/outputs/dama-20261116/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#DataHandlingEthics!A8:L8> ;
    ns1:alignmentBasis "Activity-derived proposal; source image plus interpreted associations"@en ;
    ns1:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns1:deliverables "Ethical Data Handling Reporting; Aligned Incentives, KPIs, and Targets"@en ;
    ns1:directSupportExplanation "No direct FAIR requirement is established by this ethical-practice activity or its named deliverables. Ethical responsibility and FAIR fulfilment are related but distinct."@en ;
    ns1:evidenceRequirement "Inspect approved policy or control requirements that explicitly distinguish access authorization from permitted reuse. Test any resulting authentication and authorization procedure for identified resources (A1.2) and inspect the clear, accessible usage licence attached to data and metadata (R1.1). An ethics statement, privacy notice or generic compliance metric alone is insufficient."@en ;
    ns1:inTopic <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#DataHandlingEthics> ;
    ns1:indirectSupportExplanation "Monitoring can sustain explicitly defined authorization and licensing controls. General ethics compliance incidents do not establish a FAIR-specific result."@en ;
    ns1:lifecycleCode "C"@en ;
    ns1:proposedApprovingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/cdo-cio-8988b0c1>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/executives> ;
    ns1:proposedContributingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-stewards>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/regulators>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/subject-matter-experts> ;
    ns1:proposedResponsiblePersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/coordinating-data-stewards>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-governance-bodies>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/dm-services> ;
    ns1:relevantDeliverables "Ethical Data Handling Reporting; Aligned Incentives, KPIs, and Targets"@en ;
    ns1:sourceRow 8 ;
    ns1:sourceWorksheet "DataHandlingEthics" .

<https://w3id.org/fair/principles/terms/FAIR-SubPrinciple> a owl:Class .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-3> a owl:NamedIndividual,
        ns1:SourceActivity ;
    rdfs:label "Establish Big Data Environments"@en ;
    dcterms:identifier "BigDataDataScience!A3:L3" ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/assets/13_BigDataDataScience.webp>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/outputs/dama-20261116/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A3:L3> ;
    ns1:alignmentBasis "Activity-derived proposal; source image plus interpreted associations"@en ;
    ns1:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns1:deliverables "Big Data Landscape; Operations Plan"@en ;
    ns1:directSupportExplanation "A deployed platform, database or cloud service does not establish identifier-based retrieval or an open protocol."@en ;
    ns1:evidenceRequirement "Test retrieval of identified data and metadata through a specified standard protocol; inspect freely implementable protocol specifications; test required authentication and authorization. Platform availability alone is insufficient."@en ;
    ns1:inTopic <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#BigDataAndDataScience> ;
    ns1:indirectSupportExplanation "Platform design can enable standardized retrieval, open protocols and controlled access if these are explicitly commissioned and implemented."@en ;
    ns1:lifecycleCode "D"@en ;
    ns1:proposedApprovingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/it-executives> ;
    ns1:proposedContributingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-quality-and-governance-specialists>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/ingestion-architects>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/metadata-specialists> ;
    ns1:proposedResponsiblePersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/big-data-platform-architects> ;
    ns1:relevantDeliverables "Big Data Landscape; Operations Plan"@en ;
    ns1:sourceRow 3 ;
    ns1:sourceWorksheet "BigDataDataScience" .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-7> a owl:NamedIndividual,
        ns1:SourceActivity ;
    rdfs:label "Integrate/Align Data For Analysis"@en ;
    dcterms:identifier "BigDataDataScience!A7:L7" ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/assets/13_BigDataDataScience.webp>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/outputs/dama-20261116/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A7:L7> ;
    ns1:alignmentBasis "Activity-derived proposal; source image plus interpreted associations"@en ;
    ns1:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns1:deliverables "Data Analysis and Hypotheses"@en ;
    ns1:directSupportExplanation "Joining datasets or aligning statistical features does not by itself establish a shared knowledge-representation language or qualified resource references."@en ;
    ns1:evidenceRequirement "Inspect shared formal representations and identifiable resources with typed relations; trace transformations to source versions. Matching columns, feature vectors and internal keys alone are insufficient."@en ;
    ns1:inTopic <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#BigDataAndDataScience> ;
    ns1:indirectSupportExplanation "Integration can preserve provenance and implement explicit semantic representations and typed links when these requirements are included in the integration design."@en ;
    ns1:lifecycleCode "D"@en ;
    ns1:proposedApprovingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/analytic-design-lead>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/big-data-platform-architects> ;
    ns1:proposedContributingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-curators>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-quality-and-governance-specialists>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-smes>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/metadata-specialists> ;
    ns1:proposedResponsiblePersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-scientists>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/ingestion-architects> ;
    ns1:relevantDeliverables "Data Analysis and Hypotheses"@en ;
    ns1:sourceRow 7 ;
    ns1:sourceWorksheet "BigDataDataScience" .

ns1:DirectContribution a owl:Class ;
    rdfs:label "Direct contribution"@en ;
    rdfs:comment "The source practice produces or verifies evidence addressing the target FAIR subprinciple."@en .

ns1:PublishProvenance a owl:NamedIndividual,
        ns1:Practice ;
    rdfs:label "Publish detailed dataset provenance"@en ;
    ns1:evidenceForPrinciple <https://w3id.org/fair/principles/terms/R1.2> ;
    ns1:inKnowledgeArea <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#MetadataManagement> .

ns1:AttachUsageLicense a owl:NamedIndividual,
        ns1:Practice ;
    rdfs:label "Attach a usage license to the published data or metadata"@en ;
    ns1:evidenceForPrinciple <https://w3id.org/fair/principles/terms/R1.1> ;
    ns1:inKnowledgeArea <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#MetadataManagement> .

ns1:ConfigureRetrievalAuthorization a owl:NamedIndividual,
        ns1:Practice ;
    rdfs:label "Configure authentication and authorization for retrieval"@en ;
    ns1:evidenceForPrinciple <https://w3id.org/fair/principles/terms/A1.2> ;
    ns1:inKnowledgeArea <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#DataSecurity> .

ns1:SourceActivity a owl:Class ;
    rdfs:label "Source activity"@en ;
    rdfs:subClassOf ns1:Practice .

ns1:Practice a owl:Class ;
    rdfs:label "DAMA-related practice"@en .

ns1:IndirectContribution a owl:Class ;
    rdfs:label "Indirect contribution"@en ;
    rdfs:comment "The source practice enables an intermediate practice that provides or verifies the evidence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:viaPractice ;
            owl:someValuesFrom ns1:Practice ] .

ns1:AreaAlignmentAssessment a owl:Class ;
    rdfs:label "Proposed area-to-FAIR alignment assessment"@en ;
    owl:disjointWith ns1:FAIRContribution .

