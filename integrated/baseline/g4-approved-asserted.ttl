    ns4:alignmentBasis "Activity-derived proposal; source image plus interpreted associations"@en ;
    ns4:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns4:deliverables "Big Data Strategy & Standards"@en ;
    ns4:directSupportExplanation "A strategy is an enabling decision record; it does not itself establish FAIR properties of data or metadata."@en ;
    ns4:evidenceRequirement "Inspect approved standards and their domain relevance, then validate actual data and metadata against the applicable community specifications. Strategy approval alone does not demonstrate conformance."@en ;
    ns4:inTopic ns2:BigDataAndDataScience ;
    ns4:indirectSupportExplanation "Standards selection can commission domain-relevant community conformance if named external standards, versions and acceptance tests are explicitly adopted. Internal IT standards alone are insufficient."@en ;
    ns4:lifecycleCode "P"@en ;
    ns4:proposedApprovingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/business-executives>,
