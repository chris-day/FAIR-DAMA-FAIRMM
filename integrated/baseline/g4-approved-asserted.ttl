    ns1:fieldHeading "Contributing Roles" ;
    ns1:sourcePosition 5 ;
    ns1:sourceText "Business Intelligence Specialists, Data Integration Specialists, Database Administrators, Other Data Mgmt. Professionals, Data Integration Specialists, Database Administrators, Other Data Mgmt. Professionals" .

ns1:ACT-09-009-field-6 a owl:NamedIndividual,
        ns1:SourceField ;
    rdfs:label "Plan,Develop,Organise,Control"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1727> ;
