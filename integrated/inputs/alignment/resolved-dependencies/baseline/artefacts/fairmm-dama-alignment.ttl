    ns1:rationale "Provide Content Access and Retrieval (O) \\[source: DocumentContentManagement!A9:F9\\] — Deliverable: Portals, Content Analysis, Leveraged Information.; Inferred support: content access and retrieval can satisfy A1 if electronic content and metadata are retrieved by identifier via a standard protocol; the named portals do not establish this. No implementation evidence is supplied." ;
    ns1:sourceCoordinate "DocumentContentManagement!A9:L9" ;
    ns1:sourceLayer "activity_table" ;
    ns1:targetsPrinciple <https://w3id.org/fair/principles/terms/A1> .

ns1:ACT-10-001-indirect-F2 a owl:NamedIndividual,
        ns1:SourceAssertion ;
    dcterms:identifier "ACT-10-001-indirect-F2" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1849> ;
    ns1:existingContributionType "Indirect" ;
    ns1:hasPractice ns1:ACT-10-001 ;
    ns1:inSourceTopic ns1:AREA-10 ;
    ns1:originalContributionType "Indirect" ;
    ns1:primarySource <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1849> ;
    ns1:rationale "Indirect support: Quality requirements, tests, monitoring and remediation can maintain reliable data; extend them to FAIR metadata and resource tests explicitly. Data accuracy, cleanliness and fitness for business use do not by themselves establish F2 or R1 metadata richness, or any other FAIR requirement." ;
    ns1:sourceCoordinate "DataQuality!A2:L2" ;
    ns1:sourceIntermediatePractice ns1:practice-2c7c984cf7a31cba0f56a8df ;
    ns1:sourceLayer "activity_table" ;
    ns1:targetsPrinciple <https://w3id.org/fair/principles/terms/F2> .

