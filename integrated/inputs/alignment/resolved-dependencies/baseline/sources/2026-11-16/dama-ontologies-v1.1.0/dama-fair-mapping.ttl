<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#area-alignment/big-data-data-science/indirect/F2> a owl:NamedIndividual,
        ns1:AreaAlignmentAssessment ;
    rdfs:label "Big Data & Data Science → F2 (Indirect)"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA_FAIR_Sankey_v1.3.0.zip> ;
    ns1:alignedPrinciple <https://w3id.org/fair/principles/terms/F2> ;
    ns1:alignmentBasis "Activity-derived proposal (additional topic)"@en ;
    ns1:alignmentType "Indirect" ;
    ns1:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns1:deliverables "Acquired Data Sources; Data Insights and Findings"@en ;
    ns1:derivedFromActivity <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-5>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-9> ;
    ns1:fromTopic <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#BigDataAndDataScience> ;
    ns1:rationale "Ingestion can capture resource descriptions, source versions, acquisition times and transformations if metadata capture is added as an explicit requirement. Communications can make discovery and reuse context available if findings are accompanied by accurate descriptions linked to the analytical resources."@en .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#area-alignment/big-data-data-science/indirect/I1> a owl:NamedIndividual,
        ns1:AreaAlignmentAssessment ;
    rdfs:label "Big Data & Data Science → I1 (Indirect)"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA_FAIR_Sankey_v1.3.0.zip> ;
    ns1:alignedPrinciple <https://w3id.org/fair/principles/terms/I1> ;
    ns1:alignmentBasis "Activity-derived proposal (additional topic)"@en ;
    ns1:alignmentType "Indirect" ;
    ns1:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns1:deliverables "Data Analysis and Hypotheses"@en ;
    ns1:derivedFromActivity <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-7> ;
    ns1:fromTopic <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#BigDataAndDataScience> ;
    ns1:rationale "Integration can preserve provenance and implement explicit semantic representations and typed links when these requirements are included in the integration design."@en .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#area-alignment/big-data-data-science/indirect/I3> a owl:NamedIndividual,
        ns1:AreaAlignmentAssessment ;
    rdfs:label "Big Data & Data Science → I3 (Indirect)"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA_FAIR_Sankey_v1.3.0.zip> ;
    ns1:alignedPrinciple <https://w3id.org/fair/principles/terms/I3> ;
    ns1:alignmentBasis "Activity-derived proposal (additional topic)"@en ;
    ns1:alignmentType "Indirect" ;
    ns1:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns1:deliverables "Data Analysis and Hypotheses"@en ;
    ns1:derivedFromActivity <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-7> ;
    ns1:fromTopic <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#BigDataAndDataScience> ;
    ns1:rationale "Integration can preserve provenance and implement explicit semantic representations and typed links when these requirements are included in the integration design."@en .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#area-alignment/big-data-data-science/indirect/R1> a owl:NamedIndividual,
        ns1:AreaAlignmentAssessment ;
    rdfs:label "Big Data & Data Science → R1 (Indirect)"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA_FAIR_Sankey_v1.3.0.zip> ;
    ns1:alignedPrinciple <https://w3id.org/fair/principles/terms/R1> ;
    ns1:alignmentBasis "Activity-derived proposal (additional topic)"@en ;
    ns1:alignmentType "Indirect" ;
    ns1:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns1:deliverables "Data Insights and Findings"@en ;
    ns1:derivedFromActivity <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-8>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-9> ;
    ns1:fromTopic <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#BigDataAndDataScience> ;
    ns1:rationale "Exploration can enrich reuse descriptions and provenance if assumptions, limitations, source versions, model versions and analytical steps are recorded with the resulting resources. Communications can make discovery and reuse context available if findings are accompanied by accurate descriptions linked to the analytical resources."@en .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#area-alignment/big-data-data-science/indirect/R1.1> a owl:NamedIndividual,
        ns1:AreaAlignmentAssessment ;
    rdfs:label "Big Data & Data Science → R1.1 (Indirect)"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA_FAIR_Sankey_v1.3.0.zip> ;
    ns1:alignedPrinciple <https://w3id.org/fair/principles/terms/R1.1> ;
    ns1:alignmentBasis "Activity-derived proposal (additional topic)"@en ;
    ns1:alignmentType "Indirect" ;
    ns1:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns1:deliverables "Data Sourcing Plan"@en ;
    ns1:derivedFromActivity <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-4> ;
    ns1:fromTopic <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#BigDataAndDataScience> ;
    ns1:rationale "Source evaluation can record origin, permitted reuse and descriptive context, enabling provenance and licensing requirements when resource-linked records and accessible terms are retained."@en .

