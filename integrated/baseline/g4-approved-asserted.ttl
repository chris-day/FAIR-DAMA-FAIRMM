ns1:Persona-FAIR_Data_Architect a owl:NamedIndividual,
        ns1:Persona ;
    rdfs:label "FAIR_Data_Architect"@en ;
    dcterms:identifier "FAIR_Data_Architect" ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/FAIR_personas/FAIR_Data_Architect.md> ;
    skos:definition "A role in an organization focusing on processes, models and policies that manages the generation, use and governance of data, metadata  and data standards in a FAIR compliant manner. Develops processes to deliver and maintain FAIR data and services" ;
    ns1:inFrameworkVersion ns1:FAIRMM-v1.2.5 ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/FAIR_personas/FAIR_Data_Architect.md> ;
    ns1:sourceText "A role in an organization focusing on processes, models and policies that manages the generation, use and governance of data, metadata  and data standards in a FAIR compliant manner. Develops processes to deliver and maintain FAIR data and services" .

