    ns1:hasPractice ns1:ACT-09-001 ;
    ns1:inSourceTopic ns1:AREA-09 ;
    ns1:originalContributionType "Indirect" ;
    ns1:primarySource <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1719> ;
    ns1:rationale "Indirect support: Metadata ownership, maintenance and standards can sustain resource coverage, descriptive quality and consistent changes. Specify the data identifier explicitly in metadata for F3 and metadata survival for A2; these requirements are absent from the activity labels." ;
    ns1:sourceCoordinate "MetadataManagement!A2:L2" ;
    ns1:sourceIntermediatePractice ns1:practice-2df1e2b53d6e636c66823938 ;
    ns1:sourceLayer "activity_table" ;
    ns1:targetsPrinciple <https://w3id.org/fair/principles/terms/A2> .

