    ns1:rationale "Design Data Access Services (D) \\[source: DataDevelopment!A8:F8\\] — Deliverable: Data Access Service Design Specifications.; Inferred support: access-service design can specify identifier-based retrieval through a standard protocol; neither identifiers nor protocols are named in the source. No implementation evidence is supplied." ;
    ns1:sourceCoordinate "DataModelingDesign!A8:L8" ;
    ns1:sourceLayer "activity_table" ;
    ns1:targetsPrinciple <https://w3id.org/fair/principles/terms/A1> .

ns1:ACT-03-008-direct-I3 a owl:NamedIndividual,
        ns1:SourceAssertion ;
    dcterms:identifier "ACT-03-008-direct-I3" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L907> ;
