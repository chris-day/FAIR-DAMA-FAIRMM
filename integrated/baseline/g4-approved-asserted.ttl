    rdfs:label "EvidenceRequirement"@en ;
    skos:definition "A requirement for evidence, not an observed test result."@en .

ns1:evidence-36282667b1c35e6c2dc6257e a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L158> ;
    ns1:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L158> ;
    ns1:rationale "The named deliverable may address the F2 aspect of these clauses when its applicability condition is met." ;
    ns1:sourceText "The organization initiates formal training for FAIR roles while a majority have embraced FAIR principles for major resources, backed by well-trained personnel capable of evaluating and implementing FAIR standards. At least one business unit actively employs FAIR processes in production, supported by documentation and training, with other FAIR initiatives underway and coordinated efforts recognized." ;
    ns1:supportedByDescriptor ns1:D5-L3 ;
    ns1:supportsInterpretation ns1:interpretation-4c18e179220841db0b49c01e .

ns1:evidence-801dd3ad1328f7f52bf2b34a a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L66> ;
    ns1:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L66> ;
    ns1:rationale "The named deliverable may address the F2 aspect of these clauses when its applicability condition is met." ;
    ns1:sourceText "Data embeds local master and reference data. Metadata is identifiable and resolvable (at a local level), but data is still being determined (also at a local level)." ;
    ns1:supportedByDescriptor ns1:D1-L3 ;
    ns1:supportsInterpretation ns1:interpretation-334ec49879fa8ab7ea95e27e .

ns1:evidence-94d35c7a4faf786503e40e32 a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L158> ;
    ns1:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L158> ;
    ns1:rationale "The named deliverable may address the F2 aspect of these clauses when its applicability condition is met." ;
    ns1:sourceText "The FAIR data training is part of employee onboarding and continuous education development. The organization tailors specific FAIR processes to suit its needs and incorporates guidelines for providing FAIR data into standard IT procedures. Efforts to make metadata implementation accessible in a standardized manner without changing existing processes. The organization begins to integrate FAIR practices into workflows and configure systems to facilitate FAIR practices, demonstrating a commitment to normalising FAIR standards within organizational operations." ;
    ns1:supportedByDescriptor ns1:D5-L3 ;
    ns1:supportsInterpretation ns1:interpretation-4c18e179220841db0b49c01e .

ns1:evidence-b773bfaac9f0a29b48e956f9 a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L140> ;
    ns1:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L140> ;
    ns1:rationale "The named deliverable may address the F2 aspect of these clauses when its applicability condition is met." ;
    ns1:sourceText "The organization possesses comprehensive metadata and awareness of data specifics. Although not all data details are within a FAIR catalog, there's an insight into licenses, refresh cycles, lineage, rationale, intended usage, and business value. Process design ensures knowledge of these aspects, particularly in procurement, contributing to a more comprehensive understanding of data assets." ;
    ns1:supportedByDescriptor ns1:D5-L2 ;
    ns1:supportsInterpretation ns1:interpretation-ab527083ea744b5d6bd5efcd .

ns1:evidence-cf82c2bb5ed43fbcd321eaa3 a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L140> ;
    ns1:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L140> ;
    ns1:rationale "The named deliverable may address the F2 aspect of these clauses when its applicability condition is met." ;
    ns1:sourceText "Processes include data curation, metadata guidelines definition, and retrospective data FAIRification. FAIR data procurement has defined requirements." ;
    ns1:supportedByDescriptor ns1:D5-L2 ;
    ns1:supportsInterpretation ns1:interpretation-ab527083ea744b5d6bd5efcd .

ns1:evidence-de27c22d05ac74f3cee58377 a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L65> ;
    ns1:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level2.md#L65> ;
    ns1:rationale "The named deliverable may address the F2 aspect of these clauses when its applicability condition is met." ;
    ns1:sourceText "Data, conformed to a local model, is cataloged (i.e. a metadata record of existence is created), and data resides in a data lake." ;
    ns1:supportedByDescriptor ns1:D1-L2 ;
    ns1:supportsInterpretation ns1:interpretation-92d804181643d1e89c26b0b6 .

