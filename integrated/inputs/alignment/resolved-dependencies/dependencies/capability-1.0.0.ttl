<urn:capability-ontology:Evidence> a owl:Class ;
    rdfs:label "Evidence"@en .

<urn:capability-ontology:ImplementationCondition> a owl:Class ;
    rdfs:label "Implementation condition"@en .

<urn:capability-ontology:Profile> a owl:Class ;
    rdfs:label "Profile"@en ;
    rdfs:comment "A scoped collection of requirements; no realisation is entailed by membership."@en .

<urn:capability-ontology:Scope> a owl:Class ;
    rdfs:label "Scope"@en .

<urn:capability-ontology:Capability> a owl:Class ;
    rdfs:label "Capability"@en ;
    rdfs:comment "An ability to perform a function; distinct from an implementation realising it."@en ;
    owl:disjointWith <urn:capability-ontology:Implementation>,
        <urn:capability-ontology:Realisation> .

<urn:capability-ontology:Implementation> a owl:Class ;
    rdfs:label "Implementation"@en .

<urn:capability-ontology:NotApplicable> a owl:NamedIndividual,
        <urn:capability-ontology:VerificationState> .

<urn:capability-ontology:Requirement> a owl:Class ;
    rdfs:label "Requirement"@en ;
    rdfs:comment "A requirement for a capability, potentially subject to conditions."@en .

<urn:capability-ontology:Unknown> a owl:NamedIndividual,
        <urn:capability-ontology:VerificationState> .

<urn:capability-ontology:Unverified> a owl:NamedIndividual,
        <urn:capability-ontology:VerificationState> .

<urn:capability-ontology:Verified> a owl:NamedIndividual,
        <urn:capability-ontology:VerificationState> .

<urn:capability-ontology:Realisation> a owl:Class ;
    rdfs:label "Realisation"@en ;
    rdfs:comment "A contextual claim relating an implementation to a capability, with separate verification state."@en .

<urn:capability-ontology:VerificationState> a owl:Class ;
    owl:oneOf ( <urn:capability-ontology:Unknown> <urn:capability-ontology:Unverified> <urn:capability-ontology:Verified> <urn:capability-ontology:NotApplicable> ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( <urn:capability-ontology:Unknown> <urn:capability-ontology:Unverified> <urn:capability-ontology:Verified> <urn:capability-ontology:NotApplicable> ) .

