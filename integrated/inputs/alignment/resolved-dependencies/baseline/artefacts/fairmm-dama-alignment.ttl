ns1:ACT-06-002-direct-R1.2 a owl:NamedIndividual,
        ns1:SourceAssertion ;
    dcterms:identifier "ACT-06-002-direct-R1.2" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1305> ;
    ns1:existingContributionType "Direct" ;
