align:ACT-13-007-field-10 a owl:NamedIndividual,
        align:SourceField ;
    rdfs:label "Indirect support"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L2168> ;
    align:fieldHeading "Indirect support" ;
    align:sourcePosition 10 ;
    align:sourceText "Exploration can enrich reuse descriptions and provenance if assumptions, limitations, source versions, model versions and analytical steps are recorded with the resulting resources." .

align:ACT-13-007-field-11 a owl:NamedIndividual,
        align:SourceField ;
    rdfs:label "What would demonstrate the supported FAIR requirement"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L2168> ;
    align:fieldHeading "What would demonstrate the supported FAIR requirement" ;
    align:sourcePosition 11 ;
    align:sourceText "Inspect resource-linked descriptions of analytical context and limitations and a traceable execution record linking inputs, model versions and outputs. Performance scores alone are insufficient." .

