ns2:catalogueCategory a owl:ObjectProperty .

ns2:hasAdditionalTopic a owl:ObjectProperty ;
    rdfs:label "has additional topic"@en ;
    rdfs:domain ns2:FrameworkEdition ;
    rdfs:range ns2:AdditionalTopic .

ns2:inCatalogueSection a owl:ObjectProperty .

ns2:sourceLabel a owl:DatatypeProperty .

ns2:sourceLine a owl:DatatypeProperty .

ns3:concernsPractice a owl:ObjectProperty ;
    rdfs:domain ns3:Responsibility ;
    rdfs:range ns4:Practice .

ns3:consumerIn a owl:ObjectProperty ;
    rdfs:domain ns3:Persona ;
    rdfs:range ns3:SourceTopic .

ns3:correspondsToKnowledgeArea a owl:ObjectProperty ;
    rdfs:domain ns3:SourceTopic ;
    rdfs:range ns2:KnowledgeArea ;
    rdfs:subPropertyOf ns3:correspondsToTopic .

ns3:hasGoal a owl:ObjectProperty ;
    rdfs:domain ns3:Persona ;
    rdfs:range ns3:Goal .

ns3:hasResponsibility a owl:ObjectProperty ;
    rdfs:domain ns3:Persona ;
    rdfs:range ns3:Responsibility .

ns3:partiallyCorrespondsToKnowledgeArea a owl:ObjectProperty ;
    rdfs:label "partially corresponds to knowledge area"@en ;
    rdfs:comment "A partial documentary correspondence; it is not identity or complete coverage."@en ;
    rdfs:domain ns3:SourceTopic ;
    rdfs:range ns2:KnowledgeArea .

ns3:participantIn a owl:ObjectProperty ;
    rdfs:domain ns3:Persona ;
    rdfs:range ns3:SourceTopic .

ns3:reportedDirectFAIRPrinciple a owl:ObjectProperty ;
    rdfs:comment "Area-level relationship reported in the v1.18.0 persona table; inferred from listed topic membership, not individual responsibility or implementation evidence."@en ;
    rdfs:domain ns3:Persona ;
    rdfs:range <https://w3id.org/fair/principles/terms/FAIR-SubPrinciple> .

ns3:reportedIndirectFAIRPrinciple a owl:ObjectProperty ;
    rdfs:comment "Area-level relationship reported in the v1.18.0 persona table; inferred from listed topic membership, not individual responsibility or implementation evidence."@en ;
    rdfs:domain ns3:Persona ;
    rdfs:range <https://w3id.org/fair/principles/terms/FAIR-SubPrinciple> .

ns3:representsRole a owl:ObjectProperty ;
    rdfs:domain ns3:Persona ;
    rdfs:range ns3:Role .

ns3:supplierIn a owl:ObjectProperty ;
    rdfs:domain ns3:Persona ;
    rdfs:range ns3:SourceTopic .

<urn:capability-ontology:forImplementation> a owl:ObjectProperty ;
    rdfs:domain <urn:capability-ontology:Realisation> ;
    rdfs:range <urn:capability-ontology:Implementation> .

<urn:capability-ontology:hasEvidence> a owl:ObjectProperty ;
    rdfs:range <urn:capability-ontology:Evidence> .

<urn:capability-ontology:hasRequirement> a owl:ObjectProperty ;
    rdfs:domain <urn:capability-ontology:Profile> ;
    rdfs:range <urn:capability-ontology:Requirement> .

<urn:capability-ontology:inScope> a owl:ObjectProperty ;
    rdfs:range <urn:capability-ontology:Scope> .

<urn:capability-ontology:ontology> a owl:Ontology ;
    dcterms:description "Domain-neutral functional abilities, requirements, profiles and contextual realisations. A potential capability is not evidence of implementation."@en ;
    dcterms:title "Capability ontology"@en ;
    owl:versionIRI <urn:capability-ontology:ontology:version:1.0.0> ;
    owl:versionInfo "1.0.0" .

<urn:capability-ontology:rationale> a owl:AnnotationProperty ;
    rdfs:range xsd:string .

<urn:capability-ontology:realisesCapability> a owl:ObjectProperty ;
    rdfs:domain <urn:capability-ontology:Realisation> ;
    rdfs:range <urn:capability-ontology:Capability> .

<urn:capability-ontology:requiresCapability> a owl:ObjectProperty ;
    rdfs:domain <urn:capability-ontology:Requirement> ;
    rdfs:range <urn:capability-ontology:Capability> .

<urn:capability-ontology:requiresCondition> a owl:ObjectProperty ;
    rdfs:range <urn:capability-ontology:ImplementationCondition> .

<urn:capability-ontology:verificationState> a owl:ObjectProperty ;
    rdfs:domain <urn:capability-ontology:Realisation> ;
    rdfs:range <urn:capability-ontology:VerificationState> .

