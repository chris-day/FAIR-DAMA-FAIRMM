align:ACT-02-006-field-9 a owl:NamedIndividual,
        align:SourceField ;
    rdfs:label "How they can support FAIR"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L755> ;
    align:fieldHeading "How they can support FAIR" ;
    align:sourcePosition 9 ;
    align:sourceText "Define and Maintain the Data Warehouse / BI Architecture (P)  \\[source: DataArchitectureManagement!A7:F7\\] — Deliverable: Data Warehouse / Business Intelligence Architecture.; No clear FAIR support identified from the supplied activity and deliverable. This item can enable implementation, but it does not specify a defensible resource-level FAIR mechanism. No implementation evidence is supplied." .

align:ACT-02-007-field-1 a owl:NamedIndividual,
        align:SourceField ;
    rdfs:label "Activities"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L756> ;
    align:fieldHeading "Activities" ;
    align:sourcePosition 1 ;
    align:sourceText "Define and Maintain Enterprise Ontologies, Taxonomies and Namespaces (P)" .

align:ACT-02-007-field-10 a owl:NamedIndividual,
        align:SourceField ;
    rdfs:label "Indirect support"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L756> ;
    align:fieldHeading "Indirect support" ;
    align:sourcePosition 10 ;
    align:sourceText "Indirect support: Architecture ownership and review can align implemented resources with agreed FAIR representations and service requirements. Namespace governance can enable F1 only if identifiers for data and metadata are globally unique and persistent; XML namespaces alone do not establish F1." .

align:ACT-02-007-field-11 a owl:NamedIndividual,
        align:SourceField ;
    rdfs:label "What would demonstrate the supported FAIR requirement"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L756> ;
    align:fieldHeading "What would demonstrate the supported FAIR requirement" ;
    align:sourcePosition 11 ;
    align:sourceText "I1: Inspect the implemented language, shared specification and sample data/metadata representations. Parse them independently and verify that the language is formal, accessible, shared and broadly applicable; schema syntax or diagrams alone are insufficient.; I2: Inspect the vocabulary term identifiers and versions actually used in data/metadata; assess the vocabulary itself for FAIR identifiers, discovery, access, representation, licensing and provenance. An internal glossary or taxonomy alone is insufficient.; R1.3: Identify the domain community and relevant standard/version, then validate representative data and metadata against its applicable requirements. Document exceptions; internal enterprise standards and a mention of an industry standard do not prove conformance.; Supporting-process evidence: inspect the named deliverable and its approval/maintenance records separately from the resource tests." .

align:ACT-02-007-field-12 a owl:NamedIndividual,
        align:SourceField ;
    rdfs:label "FAIR principles indirectly supported"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L756> ;
    align:fieldHeading "FAIR principles indirectly supported" ;
    align:sourcePosition 12 ;
    align:sourceText "F1" .

align:ACT-02-007-field-2 a owl:NamedIndividual,
        align:SourceField ;
    rdfs:label "Deliverables"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L756> ;
    align:fieldHeading "Deliverables" ;
    align:sourcePosition 2 ;
    align:sourceText "Enterprise Taxonomies, Industry Ontologies, ISO TC/68 alignment,  XML Namespaces,  Content Management Standards;" .

