align:evidence-71b168be10b05b7bd6abea5c a owl:NamedIndividual,
        align:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L110> ;
    align:matchLimitation "Thematic documentary support only. Remaining descriptor clauses, deployment scope and operational capability are not established." ;
    align:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level3.md#L110> ;
    align:rationale "The named deliverable may address the D3 aspect of these clauses when its applicability condition is met." ;
    align:sourceText "There is a clear understanding of why making data FAIR adds value; this may extend beyond a given corporate function or domain. This value-adding process begins to be tracked or monitored. Strategies begin to encompass enterprise-level dimensions." ;
    align:supportedByDescriptor align:D3-L3 ;
    align:supportsInterpretation align:interpretation-edc850a6481f9378eb0c5441 .

