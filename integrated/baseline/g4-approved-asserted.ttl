ns1:Persona-Data_Analyst a owl:NamedIndividual,
        ns1:Persona ;
    rdfs:label "Data_Analyst"@en ;
    dcterms:identifier "Data_Analyst" ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/FAIR_personas/Data_Analyst.md> ;
    skos:definition "Data Analyst is responsible for designing, developing, and maintaining dashboards and recurring reports that support business needs." ;
    ns1:inFrameworkVersion ns1:FAIRMM-v1.2.5 ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/FAIR_personas/Data_Analyst.md> ;
    ns1:sourceText "Data Analyst is responsible for designing, developing, and maintaining dashboards and recurring reports that support business needs." .

ns1:Persona-Data_Scientist a owl:NamedIndividual,
        ns1:Persona ;
    rdfs:label "Data_Scientist"@en ;
    dcterms:identifier "Data_Scientist" ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/FAIR_personas/Data_Scientist.md> ;
    skos:definition "Data Scientists  find, compile, clean, preprocess and analyze complex datasets. They interpret data trends, develop predictive models, and communicate findings to inform strategic decision-making. Data Scientists also design experiments, possess expertise in statistical methods, programming, data visualization, database management, and may have domain-specific knowledge. See also “researcher” ." ;
    ns1:inFrameworkVersion ns1:FAIRMM-v1.2.5 ;
    ns1:primarySource <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/FAIR_personas/Data_Scientist.md> ;
    ns1:sourceText "Data Scientists  find, compile, clean, preprocess and analyze complex datasets. They interpret data trends, develop predictive models, and communicate findings to inform strategic decision-making. Data Scientists also design experiments, possess expertise in statistical methods, programming, data visualization, database management, and may have domain-specific knowledge. See also “researcher” ." .

