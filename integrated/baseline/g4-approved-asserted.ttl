    ns1:rationale "Operations can sustain identifier-based access and record versioned inputs, model changes and execution history when those controls are explicitly included in the operations plan." ;
    ns1:sourceIntermediatePractice ns4:EnableIdentifierBasedRetrieval ;
    ns1:sourceLayer "ontology_contribution" ;
