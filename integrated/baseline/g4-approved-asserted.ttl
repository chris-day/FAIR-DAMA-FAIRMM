<urn:fair-dama-fairmm:alignment:ONT-contribution/BigDataDataScience/row-10/indirect/A1> a owl:NamedIndividual,
        ns1:SourceAssertion ;
    dcterms:identifier "ONT-contribution/BigDataDataScience/row-10/indirect/A1" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/dama-ontologies-v1.1.0/dama-fair-mapping.ttl> ;
    ns1:applicabilityCondition "Test standardized retrieval of identified resources and inspect version-linked deployment and execution provenance. Monitoring predictive accuracy or infrastructure utilization alone is insufficient." ;
    ns1:derivedFromSourceNode <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/BigDataDataScience/row-10/indirect/A1> ;
