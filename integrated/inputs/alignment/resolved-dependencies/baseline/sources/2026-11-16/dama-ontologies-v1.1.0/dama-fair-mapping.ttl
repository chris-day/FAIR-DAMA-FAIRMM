    ns1:evidenceRequirement "Test retrieval of identified data and metadata through a specified standard protocol; inspect freely implementable protocol specifications; test required authentication and authorization. Platform availability alone is insufficient."@en ;
    ns1:fromPractice <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-3> ;
    ns1:rationale "Platform design can enable standardized retrieval, open protocols and controlled access if these are explicitly commissioned and implemented."@en ;
    ns1:targetsPrinciple <https://w3id.org/fair/principles/terms/A1.2> ;
    ns1:viaPractice ns1:ConfigureRetrievalAuthorization .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/BigDataDataScience/row-4/indirect/R1.1> a owl:NamedIndividual,
        ns1:IndirectContribution ;
    rdfs:label "Choose Data Sources → R1.1"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/outputs/dama-20261116/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A4:L4> ;
    ns1:alignmentBasis "Activity-derived proposal"@en ;
    ns1:applicabilityCondition "Trace selected source versions to providers and acquisition context; inspect accessible usage licences linked to each resource. A commercial purchase or access agreement alone is not a FAIR usage licence."@en ;
    ns1:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns1:evidenceRequirement "Trace selected source versions to providers and acquisition context; inspect accessible usage licences linked to each resource. A commercial purchase or access agreement alone is not a FAIR usage licence."@en ;
    ns1:fromPractice <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-4> ;
    ns1:rationale "Source evaluation can record origin, permitted reuse and descriptive context, enabling provenance and licensing requirements when resource-linked records and accessible terms are retained."@en ;
    ns1:targetsPrinciple <https://w3id.org/fair/principles/terms/R1.1> ;
    ns1:viaPractice ns1:AttachUsageLicense .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/BigDataDataScience/row-4/indirect/R1.2> a owl:NamedIndividual,
        ns1:IndirectContribution ;
    rdfs:label "Choose Data Sources → R1.2"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/outputs/dama-20261116/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A4:L4> ;
    ns1:alignmentBasis "Activity-derived proposal"@en ;
    ns1:applicabilityCondition "Trace selected source versions to providers and acquisition context; inspect accessible usage licences linked to each resource. A commercial purchase or access agreement alone is not a FAIR usage licence."@en ;
    ns1:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns1:evidenceRequirement "Trace selected source versions to providers and acquisition context; inspect accessible usage licences linked to each resource. A commercial purchase or access agreement alone is not a FAIR usage licence."@en ;
    ns1:fromPractice <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-4> ;
    ns1:rationale "Source evaluation can record origin, permitted reuse and descriptive context, enabling provenance and licensing requirements when resource-linked records and accessible terms are retained."@en ;
    ns1:targetsPrinciple <https://w3id.org/fair/principles/terms/R1.2> ;
    ns1:viaPractice ns1:PublishProvenance .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/BigDataDataScience/row-5/indirect/F2> a owl:NamedIndividual,
        ns1:IndirectContribution ;
    rdfs:label "Acquire & Ingest Data Sources → F2"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/outputs/dama-20261116/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A5:L5> ;
    ns1:alignmentBasis "Activity-derived proposal"@en ;
    ns1:applicabilityCondition "Inspect descriptions linked to ingested resources and provenance records identifying sources, versions, agents, acquisition times and transformations. Successful loading and scanning alone are insufficient."@en ;
    ns1:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns1:evidenceRequirement "Inspect descriptions linked to ingested resources and provenance records identifying sources, versions, agents, acquisition times and transformations. Successful loading and scanning alone are insufficient."@en ;
    ns1:fromPractice <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-5> ;
    ns1:rationale "Ingestion can capture resource descriptions, source versions, acquisition times and transformations if metadata capture is added as an explicit requirement."@en ;
    ns1:targetsPrinciple <https://w3id.org/fair/principles/terms/F2> ;
    ns1:viaPractice ns1:PublishRichDiscoveryMetadata .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/BigDataDataScience/row-5/indirect/R1.2> a owl:NamedIndividual,
        ns1:IndirectContribution ;
    rdfs:label "Acquire & Ingest Data Sources → R1.2"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/outputs/dama-20261116/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A5:L5> ;
    ns1:alignmentBasis "Activity-derived proposal"@en ;
    ns1:applicabilityCondition "Inspect descriptions linked to ingested resources and provenance records identifying sources, versions, agents, acquisition times and transformations. Successful loading and scanning alone are insufficient."@en ;
    ns1:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns1:evidenceRequirement "Inspect descriptions linked to ingested resources and provenance records identifying sources, versions, agents, acquisition times and transformations. Successful loading and scanning alone are insufficient."@en ;
    ns1:fromPractice <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-5> ;
    ns1:rationale "Ingestion can capture resource descriptions, source versions, acquisition times and transformations if metadata capture is added as an explicit requirement."@en ;
    ns1:targetsPrinciple <https://w3id.org/fair/principles/terms/R1.2> ;
    ns1:viaPractice ns1:PublishProvenance .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/BigDataDataScience/row-6/direct/R1> a owl:NamedIndividual,
        ns1:DirectContribution ;
    rdfs:label "Develop Hypotheses & Methods → R1"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/outputs/dama-20261116/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A6:L6> ;
    ns1:alignmentBasis "Activity-derived proposal"@en ;
    ns1:applicabilityCondition "For R1, inspect resource-linked descriptions of hypotheses, methods, assumptions, units, scope and limitations, and verify their accuracy and relevance for reuse. For R1.2, additionally inspect input versions, methods, agents and execution history. An unexplained model or hypothesis list is insufficient."@en ;
    ns1:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns1:evidenceRequirement "For R1, inspect resource-linked descriptions of hypotheses, methods, assumptions, units, scope and limitations, and verify their accuracy and relevance for reuse. For R1.2, additionally inspect input versions, methods, agents and execution history. An unexplained model or hypothesis list is insufficient."@en ;
    ns1:fromPractice <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-6> ;
    ns1:rationale "Inferred potential direct support: documented hypotheses and methods can supply accurate, relevant methodological context for reusing the associated analytical data. The diagram does not establish that these descriptions are complete or associated with identifiable resources."@en ;
    ns1:targetsPrinciple <https://w3id.org/fair/principles/terms/R1> .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/BigDataDataScience/row-6/indirect/R1.2> a owl:NamedIndividual,
        ns1:IndirectContribution ;
    rdfs:label "Develop Hypotheses & Methods → R1.2"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/outputs/dama-20261116/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A6:L6> ;
    ns1:alignmentBasis "Activity-derived proposal"@en ;
    ns1:applicabilityCondition "For R1, inspect resource-linked descriptions of hypotheses, methods, assumptions, units, scope and limitations, and verify their accuracy and relevance for reuse. For R1.2, additionally inspect input versions, methods, agents and execution history. An unexplained model or hypothesis list is insufficient."@en ;
    ns1:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns1:evidenceRequirement "For R1, inspect resource-linked descriptions of hypotheses, methods, assumptions, units, scope and limitations, and verify their accuracy and relevance for reuse. For R1.2, additionally inspect input versions, methods, agents and execution history. An unexplained model or hypothesis list is insufficient."@en ;
    ns1:fromPractice <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-6> ;
    ns1:rationale "Versioned methods and input records can enable provenance when linked to the resulting data and model outputs."@en ;
    ns1:targetsPrinciple <https://w3id.org/fair/principles/terms/R1.2> ;
    ns1:viaPractice ns1:PublishProvenance .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/BigDataDataScience/row-7/indirect/I1> a owl:NamedIndividual,
        ns1:IndirectContribution ;
    rdfs:label "Integrate/Align Data For Analysis → I1"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/outputs/dama-20261116/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A7:L7> ;
    ns1:alignmentBasis "Activity-derived proposal"@en ;
    ns1:applicabilityCondition "Inspect shared formal representations and identifiable resources with typed relations; trace transformations to source versions. Matching columns, feature vectors and internal keys alone are insufficient."@en ;
    ns1:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    ns1:evidenceRequirement "Inspect shared formal representations and identifiable resources with typed relations; trace transformations to source versions. Matching columns, feature vectors and internal keys alone are insufficient."@en ;
    ns1:fromPractice <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-7> ;
    ns1:rationale "Integration can preserve provenance and implement explicit semantic representations and typed links when these requirements are included in the integration design."@en ;
    ns1:targetsPrinciple <https://w3id.org/fair/principles/terms/I1> ;
    ns1:viaPractice ns1:PublishSharedRepresentation .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/BigDataDataScience/row-7/indirect/I3> a owl:NamedIndividual,
