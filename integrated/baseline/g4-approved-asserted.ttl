<urn:fair-dama-fairmm:alignment:ONT-contribution/BigDataDataScience/row-8/indirect/R1> a owl:NamedIndividual,
        ns1:SourceAssertion ;
    dcterms:identifier "ONT-contribution/BigDataDataScience/row-8/indirect/R1" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/dama-ontologies-v1.1.0/dama-fair-mapping.ttl> ;
    ns1:applicabilityCondition "Inspect resource-linked descriptions of analytical context and limitations and a traceable execution record linking inputs, model versions and outputs. Performance scores alone are insufficient." ;
    ns1:derivedFromSourceNode <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/BigDataDataScience/row-8/indirect/R1> ;
