<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#area-alignment/big-data-data-science/indirect/A1.2> a owl:NamedIndividual,
        ns1:AreaAlignmentAssessment ;
    rdfs:label "Big Data & Data Science → A1.2 (Indirect)"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA_FAIR_Sankey_v1.3.0.zip> ;
