    ns2:sourceLine 888 .

ns2:catalogueCategory a owl:ObjectProperty .

ns2:hasAdditionalTopic a owl:ObjectProperty ;
    rdfs:label "has additional topic"@en ;
    rdfs:domain ns2:FrameworkEdition ;
    rdfs:range ns2:AdditionalTopic .

ns2:inCatalogueSection a owl:ObjectProperty .

ns2:sourceLabel a owl:DatatypeProperty .

ns2:sourceLine a owl:DatatypeProperty .

ns1:concernsPractice a owl:ObjectProperty ;
    rdfs:domain ns1:Responsibility ;
    rdfs:range ns3:Practice .

ns1:consumerIn a owl:ObjectProperty ;
    rdfs:domain ns1:Persona ;
    rdfs:range ns1:SourceTopic .

ns1:correspondsToKnowledgeArea a owl:ObjectProperty ;
    rdfs:domain ns1:SourceTopic ;
    rdfs:range ns2:KnowledgeArea ;
    rdfs:subPropertyOf ns1:correspondsToTopic .

ns1:hasGoal a owl:ObjectProperty ;
    rdfs:domain ns1:Persona ;
    rdfs:range ns1:Goal .

ns1:hasResponsibility a owl:ObjectProperty ;
    rdfs:domain ns1:Persona ;
    rdfs:range ns1:Responsibility .

ns1:partiallyCorrespondsToKnowledgeArea a owl:ObjectProperty ;
    rdfs:label "partially corresponds to knowledge area"@en ;
    rdfs:comment "A partial documentary correspondence; it is not identity or complete coverage."@en ;
    rdfs:domain ns1:SourceTopic ;
    rdfs:range ns2:KnowledgeArea .

ns1:participantIn a owl:ObjectProperty ;
    rdfs:domain ns1:Persona ;
    rdfs:range ns1:SourceTopic .

