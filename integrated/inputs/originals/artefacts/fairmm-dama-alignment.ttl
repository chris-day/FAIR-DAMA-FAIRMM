align:ACT-09-008-field-9 a owl:NamedIndividual,
        align:SourceField ;
    rdfs:label "How they can support FAIR"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1726> ;
    align:fieldHeading "How they can support FAIR" ;
    align:sourcePosition 9 ;
    align:sourceText "Distribute and Deliver Metadata (O) \\[source: MetadataManagement!A9:F9\\] — Deliverable: Distribution of Metadata, Metadata Models and Architecture.; Inferred support: metadata distribution can expose retrievable metadata if delivery is by identifier through a standard protocol; the source does not identify either. No implementation evidence is supplied." .

align:ACT-09-009-field-1 a owl:NamedIndividual,
        align:SourceField ;
    rdfs:label "Activities"@en ;
