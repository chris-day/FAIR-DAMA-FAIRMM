    align:rationale "Versioned methods and input records can enable provenance when linked to the resulting data and model outputs." ;
    align:sourceIntermediatePractice map:PublishProvenance ;
    align:sourceLayer "ontology_contribution" ;
    align:targetsPrinciple fair:R1.2 .

<urn:fair-dama-fairmm:alignment:ONT-contribution/BigDataDataScience/row-7/indirect/I1> a owl:NamedIndividual,
        align:SourceAssertion ;
    dcterms:identifier "ONT-contribution/BigDataDataScience/row-7/indirect/I1" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/dama-ontologies-v1.1.0/dama-fair-mapping.ttl> ;
    align:applicabilityCondition "Inspect shared formal representations and identifiable resources with typed relations; trace transformations to source versions. Matching columns, feature vectors and internal keys alone are insufficient." ;
    align:derivedFromSourceNode <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/BigDataDataScience/row-7/indirect/I1> ;
    align:existingContributionType "Indirect" ;
    align:hasPractice <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-7> ;
    align:inSourceTopic align:AREA-13 ;
    align:originalContributionType "Indirect" ;
    align:primarySource <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/dama-ontologies-v1.1.0/dama-fair-mapping.ttl> ;
    align:rationale "Integration can preserve provenance and implement explicit semantic representations and typed links when these requirements are included in the integration design." ;
    align:sourceIntermediatePractice map:PublishSharedRepresentation ;
    align:sourceLayer "ontology_contribution" ;
    align:targetsPrinciple fair:I1 .

