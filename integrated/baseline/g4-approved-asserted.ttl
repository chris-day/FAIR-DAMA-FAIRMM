ns4:fromPractice a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns4:FAIRContribution ;
    rdfs:range ns4:Practice .

ns4:inTopic a owl:ObjectProperty ;
    rdfs:label "in management topic"@en ;
    rdfs:domain ns4:Practice ;
    rdfs:range ns2:ManagementTopic .

ns4:targetsPrinciple a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns4:FAIRContribution ;
    rdfs:range <https://w3id.org/fair/principles/terms/FAIR-SubPrinciple> .

ns4:viaPractice a owl:ObjectProperty ;
    rdfs:domain ns4:IndirectContribution ;
    rdfs:range ns4:Practice .

