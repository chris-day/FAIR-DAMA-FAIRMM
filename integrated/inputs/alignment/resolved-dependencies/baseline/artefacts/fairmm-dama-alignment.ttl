    ns1:hasPractice ns1:ACT-05-007 ;
    ns1:inSourceTopic ns1:AREA-05 ;
    ns1:originalContributionType "Direct" ;
    ns1:primarySource <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#DataSecurityManagement!A8:L8> ;
    ns1:rationale """Monitor User Authentication and Access Behavior (C) [source: DataSecurityManagement!A8:F8] — Deliverable: Data Access Logs, Security Notification Alerts, Data Security Reports.
Inferred support: authentication monitoring and access logs can verify access decisions when applied within a data/metadata retrieval protocol. Generic database security, credential management or access monitoring alone does not establish A1.2. No implementation evidence is supplied.""" ;
    ns1:sourceCoordinate "DataSecurityManagement!A8:L8" ;
    ns1:sourceLayer "workbook_activity_table" ;
    ns1:targetsPrinciple <https://w3id.org/fair/principles/terms/A1.2> .

ns1:WB-ACT-05-007-indirect-A1.2 a owl:NamedIndividual,
        ns1:SourceAssertion ;
    dcterms:identifier "WB-ACT-05-007-indirect-A1.2" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#DataSecurityManagement!A8:L8> ;
    ns1:existingContributionType "Indirect" ;
    ns1:hasPractice ns1:ACT-05-007 ;
    ns1:inSourceTopic ns1:AREA-05 ;
    ns1:originalContributionType "Indirect" ;
    ns1:primarySource <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#DataSecurityManagement!A8:L8> ;
    ns1:rationale "Indirect support: Security governance and classification can determine legitimate access conditions and oversee their operation. Security controls must be incorporated into the retrieval protocol to fulfil A1.2; source confidentiality does not imply a FAIR accessibility result." ;
    ns1:sourceCoordinate "DataSecurityManagement!A8:L8" ;
    ns1:sourceIntermediatePractice ns1:practice-5048b9cb33558af92342eec5 ;
    ns1:sourceLayer "workbook_activity_table" ;
