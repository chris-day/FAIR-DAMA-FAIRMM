ns1:AssignProvenanceResponsibility a owl:NamedIndividual,
        ns1:Practice ;
    rdfs:label "Assign responsibility for documenting provenance"@en ;
    ns1:inKnowledgeArea <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#DataGovernance> .

ns1:ImplementOpenRetrievalProtocol a owl:NamedIndividual,
        ns1:Practice ;
    rdfs:label "Implement an open, free, universally implementable retrieval protocol"@en ;
    ns1:assessmentStatus "Proposed evidence-producing practice; implementation not asserted"@en ;
    ns1:evidenceForPrinciple <https://w3id.org/fair/principles/terms/A1.1> ;
    ns1:inKnowledgeArea <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#DataIntegrationAndInteroperability> .

ns1:IncludeDatasetIdentifier a owl:NamedIndividual,
        ns1:Practice ;
    rdfs:label "Include the dataset identifier in its metadata"@en ;
    ns1:inKnowledgeArea <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#MetadataManagement> .

ns1:IndexInSearchableCatalog a owl:NamedIndividual,
        ns1:Practice ;
    rdfs:label "Index data or metadata in a searchable catalog"@en ;
    ns1:inKnowledgeArea <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#MetadataManagement> .

ns1:PublishQualifiedResourceReferences a owl:NamedIndividual,
        ns1:Practice ;
    rdfs:label "Publish explicit typed references to related identified resources"@en ;
    ns1:assessmentStatus "Proposed evidence-producing practice; implementation not asserted"@en ;
    ns1:evidenceForPrinciple <https://w3id.org/fair/principles/terms/I3> ;
    ns1:inKnowledgeArea <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#MetadataManagement> .

ns1:SetDataSecurityPolicy a owl:NamedIndividual,
        ns1:Practice ;
    rdfs:label "Set a data security policy"@en ;
    ns1:inKnowledgeArea <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#DataSecurity> .

ns1:SetLicensingPolicy a owl:NamedIndividual,
        ns1:Practice ;
    rdfs:label "Set a data licensing policy"@en ;
    ns1:inKnowledgeArea <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#DataGovernance> .

ns1:ValidateCommunityStandards a owl:NamedIndividual,
        ns1:Practice ;
    rdfs:label "Validate resources against applicable domain community standards"@en ;
    ns1:assessmentStatus "Proposed evidence-producing practice; implementation not asserted"@en ;
    ns1:evidenceForPrinciple <https://w3id.org/fair/principles/terms/R1.3> ;
    ns1:inKnowledgeArea <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#DataQualityManagement> .

ns1:fromPractice a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:FAIRContribution ;
    rdfs:range ns1:Practice .

ns1:inTopic a owl:ObjectProperty ;
    rdfs:label "in management topic"@en ;
    rdfs:domain ns1:Practice ;
    rdfs:range <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#ManagementTopic> .

ns1:targetsPrinciple a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:FAIRContribution ;
    rdfs:range <https://w3id.org/fair/principles/terms/FAIR-SubPrinciple> .

ns1:viaPractice a owl:ObjectProperty ;
    rdfs:domain ns1:IndirectContribution ;
    rdfs:range ns1:Practice .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#KnowledgeArea> a owl:Class .

<https://orcid.org/0000-0001-5095-7052> rdfs:label "Chris Day"@en .

ns1:EnableIdentifierBasedRetrieval a owl:NamedIndividual,
        ns1:Practice ;
    rdfs:label "Implement retrieval by identifier through a standardized protocol"@en ;
    ns1:assessmentStatus "Proposed evidence-producing practice; implementation not asserted"@en ;
    ns1:evidenceForPrinciple <https://w3id.org/fair/principles/terms/A1> ;
    ns1:inKnowledgeArea <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#DataIntegrationAndInteroperability> .

