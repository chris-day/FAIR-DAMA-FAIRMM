ns1:ACT-03-005-direct-I1 a owl:NamedIndividual,
        ns1:SourceAssertion ;
    dcterms:identifier "ACT-03-005-direct-I1" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L904> ;
    ns1:existingContributionType "Direct" ;
    ns1:hasPractice ns1:ACT-03-005 ;
    ns1:inSourceTopic ns1:AREA-03 ;
    ns1:originalContributionType "Direct" ;
    ns1:primarySource <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L904> ;
    ns1:rationale "Design Physical Databases (D) \\[source: DataDevelopment!A6:F6\\] — Deliverable: DDL Specifications, OLAP Cube Specs, XML schemas.; Inferred support: XML schemas can support formal machine-readable representation if the implemented language is shared, accessible and broadly applicable. DDL or OLAP specifications alone are not sufficient knowledge representation. No implementation evidence is supplied." ;
    ns1:sourceCoordinate "DataModelingDesign!A6:L6" ;
    ns1:sourceLayer "activity_table" ;
    ns1:targetsPrinciple <https://w3id.org/fair/principles/terms/I1> .

ns1:ACT-03-007-direct-A1 a owl:NamedIndividual,
        ns1:SourceAssertion ;
    dcterms:identifier "ACT-03-007-direct-A1" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L906> ;
