    align:rationale "Communications can make discovery and reuse context available if findings are accompanied by accurate descriptions linked to the analytical resources." ;
    align:sourceIntermediatePractice map:PublishRichReuseDescriptions ;
    align:sourceLayer "ontology_contribution" ;
    align:targetsPrinciple fair:R1 .

<urn:fair-dama-fairmm:alignment:ONT-contribution/DataHandlingEthics/row-2/indirect/A1.2> a owl:NamedIndividual,
        align:SourceAssertion ;
    dcterms:identifier "ONT-contribution/DataHandlingEthics/row-2/indirect/A1.2" ;
