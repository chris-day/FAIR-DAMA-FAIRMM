<urn:fair-dama-fairmm:alignment:ONT-contribution/DataHandlingEthics/row-7/indirect/A1.2> a owl:NamedIndividual,
        ns1:SourceAssertion ;
    dcterms:identifier "ONT-contribution/DataHandlingEthics/row-7/indirect/A1.2" ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/dama-ontologies-v1.1.0/dama-fair-mapping.ttl> ;
    ns1:applicabilityCondition "Inspect approved policy or control requirements that explicitly distinguish access authorization from permitted reuse. Test any resulting authentication and authorization procedure for identified resources (A1.2) and inspect the clear, accessible usage licence attached to data and metadata (R1.1). An ethics statement, privacy notice or generic compliance metric alone is insufficient." ;
    ns1:derivedFromSourceNode <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/DataHandlingEthics/row-7/indirect/A1.2> ;
    ns1:existingContributionType "Indirect" ;
    ns1:hasPractice <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/DataHandlingEthics/row-7> ;
    ns1:inSourceTopic ns1:AREA-14 ;
    ns1:originalContributionType "Indirect" ;
    ns1:primarySource <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/dama-ontologies-v1.1.0/dama-fair-mapping.ttl> ;
    ns1:rationale "Mitigation can commission access-authorization and reuse-permission controls when the ethical risk assessment identifies those specific requirements." ;
    ns1:sourceIntermediatePractice ns4:ConfigureRetrievalAuthorization ;
    ns1:sourceLayer "ontology_contribution" ;
    ns1:targetsPrinciple <https://w3id.org/fair/principles/terms/A1.2> .

