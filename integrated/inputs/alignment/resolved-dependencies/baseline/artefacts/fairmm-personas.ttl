ns2:PM-autonomous-ai-agent a owl:NamedIndividual,
        ns2:PersonaCorrespondence ;
    rdfs:label "Autonomous_AI_Agent comparison"@en ;
    dcterms:identifier "PM-autonomous-ai-agent" ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/FAIR_personas/Autonomous_AI_Agent.md> ;
    ns2:confidence "Gap" ;
    ns2:fairmmPersona ns2:Persona-Autonomous_AI_Agent ;
    ns2:hasCounterpart ns2:PM-autonomous-ai-agent-counterpart-1 ;
    ns2:qualification "Gap; C/P/E by workflow" ;
    ns2:rationale "Add a non-human actor with human oversight; test discovery, access, semantic handling and recorded provenance. Never equate a generic system with an autonomous agent" ;
    ns2:requiresActivityContext true ;
    ns2:reviewStatus "proposed; documentary comparison completed" ;
    ns2:roleSuggestion ns2:Consumer,
        ns2:Enabler,
        ns2:Producer .

ns2:PM-business-analyst a owl:NamedIndividual,
        ns2:PersonaCorrespondence ;
    rdfs:label "Business_Analyst comparison"@en ;
    dcterms:identifier "PM-business-analyst" ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/FAIR_personas/Business_Analyst.md> ;
    ns2:confidence "Partial" ;
    ns2:fairmmPersona ns2:Persona-Business_Analyst ;
    ns2:hasCounterpart ns2:PM-business-analyst-counterpart-1,
        ns2:PM-business-analyst-counterpart-2 ;
    ns2:qualification "Partial; C/E" ;
    ns2:rationale "Direct D5 requirements and acceptance criteria; indirect F2/R1 via metadata requirements and delivery teams" ;
    ns2:requiresActivityContext true ;
    ns2:reviewStatus "proposed; documentary comparison completed" ;
    ns2:roleSuggestion ns2:Consumer,
        ns2:Enabler .

