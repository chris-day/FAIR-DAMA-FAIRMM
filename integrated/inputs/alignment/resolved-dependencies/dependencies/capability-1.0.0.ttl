<urn:capability-ontology:forImplementation> a owl:ObjectProperty ;
    rdfs:domain <urn:capability-ontology:Realisation> ;
    rdfs:range <urn:capability-ontology:Implementation> .

<urn:capability-ontology:hasEvidence> a owl:ObjectProperty ;
    rdfs:range <urn:capability-ontology:Evidence> .

<urn:capability-ontology:hasRequirement> a owl:ObjectProperty ;
