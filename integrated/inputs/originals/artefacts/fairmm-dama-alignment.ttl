    align:originalContributionType "Indirect" ;
    align:primarySource <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L1051> ;
    align:rationale "Indirect support: Operations, availability and change management can sustain FAIR infrastructure where the relevant services are commissioned. Technology licences concern software use; they do not establish R1.1 data usage licensing." ;
    align:sourceCoordinate "DataOperationsManagement!A15:L15" ;
    align:sourceIntermediatePractice align:practice-830aee39630a29a057b0854a ;
    align:sourceLayer "activity_table" ;
