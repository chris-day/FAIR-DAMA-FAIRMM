ns1:evidence-37726568d921ac97fce9dc72 a owl:NamedIndividual,
        ns1:DescriptorEvidence ;
    dcterms:source <https://github.com/Pistoia-Alliance-Inc/FAIR-Maturity-Matrix/blob/8ff4676eb340b0da5034ffb3d0e901c594c3cfc4/docs/level4.md#L109> ;
    ns1:matchingPhrase "federated domain-specific FAIR data" ;
