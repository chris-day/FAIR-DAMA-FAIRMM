align:ACT-01-001-field-10 a owl:NamedIndividual,
        align:SourceField ;
    rdfs:label "Indirect support"@en ;
    dcterms:source <file:///D:/Work-Documents/13_Research/2026_Research/FAIR/research-repos/FAIR-DAMA-FAIRMM/sources/2026-11-16/DAMA_Segments_High_Level_v1.18.0.md#L616> ;
    align:fieldHeading "Indirect support" ;
    align:sourcePosition 10 ;
    align:sourceText "Indirect support: Governance authority, stewardship and review can assign ownership, fund services and enforce FAIR acceptance criteria. For this activity, use the named deliverable to connect decisions, responsibilities or oversight to measurable FAIR outcomes; a governance record alone is insufficient." .

